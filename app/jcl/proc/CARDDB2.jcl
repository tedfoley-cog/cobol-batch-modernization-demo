//CARDDB2  PROC RGN=0M,                  REGION FOR THE TSO STEP       X
//             TM=1440,                   STEP TIME LIMIT              X
//             DUMP='SYSOUT=D',           SYSUDUMP DISPOSITION         X
//             SOUT='*'                   SYSOUT CLASS
//*
//****************************************************************
//* CARDDB2 - RUN A CARDSVC DB2 BATCH PROGRAM UNDER TSO.
//*
//* THE CALLING JOB MUST OVERRIDE //RUNDB2.SYSTSIN WITH THE
//* DSN SYSTEM / RUN PROGRAM CARDS AND ADD THE APPLICATION DD
//* STATEMENTS, FOR EXAMPLE
//*
//*    //STEP010  EXEC CARDDB2,RGN=64M
//*    //RUNDB2.SYSTSIN DD *
//*      DSN SYSTEM(DB2P)
//*      RUN PROGRAM(CBCRD04) PLAN(CARDNITP) -
//*          LIB('CARD.PROD.LOADLIB') PARM('20240131')
//*      END
//*    //*
//*    //RUNDB2.CYCLCTL  DD DSN=CARD.PROD.CYCLCTL,DISP=SHR
//*
//* SYSTSIN IS NOT SUPPLIED HERE ON PURPOSE.  IN-STREAM DATA IN A
//* PROCEDURE IS NOT SYMBOLIC SUBSTITUTED, AND THE CYCLE DATE HAS
//* TO REACH THE PROGRAM, SO EVERY JOB CODES ITS OWN CARDS.
//*
//* CHANGE CONTROL
//* 1994-04-11 CRD0102 CREATED
//* 1999-02-22 CRD1544 DYNAMNBR RAISED FOR THE POSTING ENGINE
//* 2011-10-02 CRD6688 STEPLIB MOVED OUT TO INCLUDE MEMBER CARDDB2L
//****************************************************************
//*
//RUNDB2   EXEC PGM=IKJEFT01,DYNAMNBR=99,REGION=&RGN,TIME=&TM
//         INCLUDE MEMBER=CARDDB2L
//SYSTSPRT DD SYSOUT=&SOUT
//SYSPRINT DD SYSOUT=&SOUT
//SYSOUT   DD SYSOUT=&SOUT
//SYSUDUMP DD &DUMP
//CEEDUMP  DD SYSOUT=&SOUT
//ABNLIGNR DD DUMMY
//         PEND
