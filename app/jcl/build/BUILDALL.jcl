//BUILDALL JOB (CARD,SYS),'FULL ESTATE BUILD',CLASS=A,
//             MSGCLASS=X,NOTIFY=&SYSUID,REGION=0M,
//             RESTART=ASM0010
//*
//*====================================================================
//* BUILDALL - REBUILD THE WHOLE CARD ESTATE FROM SOURCE
//*
//* THIS IS THE FULL REBUILD.  IT IS RUN FOR A COMPILER UPGRADE, A
//* CICS OR DB2 MAINTENANCE LEVEL CHANGE, A COPYBOOK CHANGE THAT
//* TOUCHES EVERYTHING, OR A DISASTER RECOVERY REBUILD.  DAY TO DAY
//* CHANGES ARE BUILT ONE MEMBER AT A TIME FROM THE CHANGE PACKAGE.
//*
//* IT TAKES ABOUT NINETY MINUTES ON A QUIET LPAR.  THE RESTART=
//* PARAMETER ON THE JOB CARD IS LEFT POINTING AT THE FIRST STEP;
//* CHANGE IT AND RESUBMIT TO PICK UP FROM WHERE A FAILURE STOPPED.
//*
//* ORDER
//*   1  ASSEMBLER    CARDCHK MUST EXIST BEFORE ANY COBOL LINK EDIT -
//*                   IT IS INCLUDED STATICALLY BY THE LINK STEPS.
//*   2  BMS MAPS     THE SYMBOLIC MAPS ARE COPIED BY THE ONLINE
//*                   PROGRAMS, SO THE MAP ASSEMBLE MUST COMPLETE
//*                   AND THE COPYBOOKS MUST BE IN CARD.PROD.CPY
//*                   BEFORE THE ONLINE COMPILES RUN.
//*   3  ONLINE       COBCICS.
//*   4  BATCH        COBBATCH, NODYNAM.
//*   5  BATCH DYNAM  COBBATCH WITH CALLOPT=DYNAM.
//*   6  PARTYRSK     SAME PROCS, PARTYRSK LIBRARIES.
//*   7  BIND         BINDPRTY THEN BINDCARD - THE CARD PLANS NAME
//*                   PRTYCOLL IN THEIR PKLIST.
//*
//* AFTER THIS JOB
//*   - APPLY THE CSD    APP/CICS/DFHCSDUP.JCL
//*   - RESTART CICSCARD OR CEDA INSTALL AND CEMT NEWCOPY
//*   - RUN THE SMOKE TEST TRANSACTION SET FROM THE OPERATIONS BOOK
//*
//* MEMBERS BUILT WITH CALLOPT=DYNAM
//*   CACRD90  CBCRD90  CACRD07  CBCRD05A  CBBIL04  CBCRD06B
//*   CACRD00  CACRD12  CACRD15
//* THESE ISSUE A CALL OR A LINK ON A DATA NAME RATHER THAN A LITERAL.
//* IF ANOTHER PROGRAM ACQUIRES THAT PATTERN IT MUST BE MOVED INTO THE
//* DYNAM SECTION BELOW OR ITS LINK EDIT WILL FAIL UNRESOLVED.
//*====================================================================
//JCLLIB   JCLLIB ORDER=(CARD.PROD.PROCLIB,PRTY.PROD.PROCLIB)
//*
//*--------------------------------------------------------------------
//* 1 - ASSEMBLER
//*--------------------------------------------------------------------
//ASM0010  EXEC COBASM,MEMBER=CARDCHK
//*
//*--------------------------------------------------------------------
//* 2 - BMS MAPSETS
//*
//* TWO PASSES PER MAPSET.  DSECT PRODUCES THE SYMBOLIC MAP COPYBOOK,
//* MAP PRODUCES THE LOAD MODULE.  THE DSECT PASS MUST BE FIRST.
//*--------------------------------------------------------------------
//BMS0010  EXEC PGM=ASMA90,
//             PARM='SYSPARM(DSECT),DECK,NOOBJECT,NOLIST'
//STEPLIB  DD DSN=ASM.SASMMOD1,DISP=SHR
//SYSLIB   DD DSN=CICSTS.SDFHMAC,DISP=SHR
//         DD DSN=SYS1.MACLIB,DISP=SHR
//SYSIN    DD DSN=CARD.PROD.BMS(CARDSET),DISP=SHR
//SYSPUNCH DD DSN=CARD.PROD.CPY(CARDSET),DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(2,2))
//*
//BMS0020  EXEC PGM=ASMA90,COND=(4,LT),
//             PARM='SYSPARM(MAP),OBJECT,NODECK,NOLIST'
//STEPLIB  DD DSN=ASM.SASMMOD1,DISP=SHR
//SYSLIB   DD DSN=CICSTS.SDFHMAC,DISP=SHR
//         DD DSN=SYS1.MACLIB,DISP=SHR
//SYSIN    DD DSN=CARD.PROD.BMS(CARDSET),DISP=SHR
//SYSLIN   DD DSN=&&MAPOBJ1,DISP=(NEW,PASS),UNIT=SYSDA,
//            SPACE=(CYL,(2,2)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=27920)
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(2,2))
//*
//BMS0030  EXEC PGM=IEWL,COND=(4,LT),
//             PARM='RENT,REUS,MAP,XREF,AMODE(31),RMODE(ANY)'
//SYSLIN   DD DSN=&&MAPOBJ1,DISP=(OLD,DELETE)
//         DD *
  NAME CARDSET(R)
/*
//SYSLMOD  DD DSN=CARD.PROD.LOADLIB,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(2,2))
//*
//BMS0040  EXEC PGM=ASMA90,COND=(4,LT),
//             PARM='SYSPARM(DSECT),DECK,NOOBJECT,NOLIST'
//STEPLIB  DD DSN=ASM.SASMMOD1,DISP=SHR
//SYSLIB   DD DSN=CICSTS.SDFHMAC,DISP=SHR
//         DD DSN=SYS1.MACLIB,DISP=SHR
//SYSIN    DD DSN=CARD.PROD.BMS(CARDST2),DISP=SHR
//SYSPUNCH DD DSN=CARD.PROD.CPY(CARDST2),DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(2,2))
//*
//BMS0050  EXEC PGM=ASMA90,COND=(4,LT),
//             PARM='SYSPARM(MAP),OBJECT,NODECK,NOLIST'
//STEPLIB  DD DSN=ASM.SASMMOD1,DISP=SHR
//SYSLIB   DD DSN=CICSTS.SDFHMAC,DISP=SHR
//         DD DSN=SYS1.MACLIB,DISP=SHR
//SYSIN    DD DSN=CARD.PROD.BMS(CARDST2),DISP=SHR
//SYSLIN   DD DSN=&&MAPOBJ2,DISP=(NEW,PASS),UNIT=SYSDA,
//            SPACE=(CYL,(2,2)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=27920)
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(2,2))
//*
//BMS0060  EXEC PGM=IEWL,COND=(4,LT),
//             PARM='RENT,REUS,MAP,XREF,AMODE(31),RMODE(ANY)'
//SYSLIN   DD DSN=&&MAPOBJ2,DISP=(OLD,DELETE)
//         DD *
  NAME CARDST2(R)
/*
//SYSLMOD  DD DSN=CARD.PROD.LOADLIB,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(2,2))
//*
//*--------------------------------------------------------------------
//* 3 - CARDSVC ONLINE
//*--------------------------------------------------------------------
//ONL0010  EXEC COBCICS,MEMBER=CACRD01
//ONL0020  EXEC COBCICS,MEMBER=CACRD02
//ONL0030  EXEC COBCICS,MEMBER=CACRD03
//ONL0040  EXEC COBCICS,MEMBER=CACRD04
//ONL0050  EXEC COBCICS,MEMBER=CACRD05
//ONL0060  EXEC COBCICS,MEMBER=CACRD06
//ONL0070  EXEC COBCICS,MEMBER=CACRD08
//ONL0080  EXEC COBCICS,MEMBER=CACRD09
//ONL0090  EXEC COBCICS,MEMBER=CACRD10
//ONL0100  EXEC COBCICS,MEMBER=CACRD11
//ONL0110  EXEC COBCICS,MEMBER=CACRD13
//ONL0120  EXEC COBCICS,MEMBER=CACRD14
//ONL0130  EXEC COBCICS,MEMBER=CACRD16
//ONL0140  EXEC COBCICS,MEMBER=CACRD17
//ONL0150  EXEC COBCICS,MEMBER=CACRD91
//ONL0160  EXEC COBCICS,MEMBER=CACRD92
//ONL0170  EXEC COBCICS,MEMBER=CAFRD01
//ONL0180  EXEC COBCICS,MEMBER=CAFRD02
//ONL0190  EXEC COBCICS,MEMBER=CAFRD03
//ONL0200  EXEC COBCICS,MEMBER=CAFRD04
//*
//*--------------------------------------------------------------------
//* 3B - CARDSVC ONLINE, DYNAM
//*
//* THE TRANSLATE AND PRECOMPILE STEPS ARE UNCHANGED; ONLY THE COMPILE
//* PARAMETER DIFFERS, SO THE CALLOPT SYMBOLIC CARRIES IT.
//*--------------------------------------------------------------------
//OND0010  EXEC COBCICS,MEMBER=CACRD00,CALLOPT=DYNAM
//OND0020  EXEC COBCICS,MEMBER=CACRD07,CALLOPT=DYNAM
//OND0030  EXEC COBCICS,MEMBER=CACRD12,CALLOPT=DYNAM
//OND0040  EXEC COBCICS,MEMBER=CACRD15,CALLOPT=DYNAM
//OND0050  EXEC COBCICS,MEMBER=CACRD90,CALLOPT=DYNAM
//*
//*--------------------------------------------------------------------
//* 4 - CARDSVC BATCH, NODYNAM
//*--------------------------------------------------------------------
//BAT0010  EXEC COBBATCH,MEMBER=CBCRD01
//BAT0020  EXEC COBBATCH,MEMBER=CBCRD02
//BAT0030  EXEC COBBATCH,MEMBER=CBCRD03
//BAT0040  EXEC COBBATCH,MEMBER=CBCRD04
//BAT0050  EXEC COBBATCH,MEMBER=CBCRD05B
//BAT0060  EXEC COBBATCH,MEMBER=CBCRD06W
//BAT0070  EXEC COBBATCH,MEMBER=CBCRD06A
//BAT0080  EXEC COBBATCH,MEMBER=CBCRD06X
//BAT0090  EXEC COBBATCH,MEMBER=CBCRD06C
//BAT0100  EXEC COBBATCH,MEMBER=CBCRD07
//BAT0110  EXEC COBBATCH,MEMBER=CBCRD08
//BAT0120  EXEC COBBATCH,MEMBER=CBCRD09
//BAT0130  EXEC COBBATCH,MEMBER=CBCRD10
//BAT0140  EXEC COBBATCH,MEMBER=CBCRD91
//BAT0150  EXEC COBBATCH,MEMBER=CBBIL01
//BAT0160  EXEC COBBATCH,MEMBER=CBBIL02
//BAT0170  EXEC COBBATCH,MEMBER=CBBIL03
//BAT0180  EXEC COBBATCH,MEMBER=CBBIL05
//BAT0190  EXEC COBBATCH,MEMBER=CBBIL06
//BAT0200  EXEC COBBATCH,MEMBER=CBREF01
//BAT0210  EXEC COBBATCH,MEMBER=CBREF02
//BAT0220  EXEC COBBATCH,MEMBER=CBREF03
//BAT0230  EXEC COBBATCH,MEMBER=CBREF04
//BAT0240  EXEC COBBATCH,MEMBER=CBREF05
//BAT0250  EXEC COBBATCH,MEMBER=CBFEE01
//BAT0260  EXEC COBBATCH,MEMBER=CBFEE02
//BAT0270  EXEC COBBATCH,MEMBER=CBFEE03
//BAT0280  EXEC COBBATCH,MEMBER=CBSTM01
//BAT0290  EXEC COBBATCH,MEMBER=CBSTM02
//*
//*--------------------------------------------------------------------
//* 5 - CARDSVC BATCH, DYNAM
//*--------------------------------------------------------------------
//BDY0010  EXEC COBBATCH,MEMBER=CBCRD05A,CALLOPT=DYNAM
//BDY0020  EXEC COBBATCH,MEMBER=CBCRD06B,CALLOPT=DYNAM
//BDY0030  EXEC COBBATCH,MEMBER=CBBIL04,CALLOPT=DYNAM
//BDY0040  EXEC COBBATCH,MEMBER=CBCRD90,CALLOPT=DYNAM
//*
//*--------------------------------------------------------------------
//* 6 - PARTYRSK
//*
//* SAME PROCS, PARTYRSK LIBRARIES.  THE LOAD MODULES GO INTO THE
//* PARTYRSK LOAD LIBRARY, WHICH IS IN THE STEPLIB CONCATENATION OF
//* THE ONLINE REGION AND OF THE BATCH JOBS THAT NEED IT.
//*--------------------------------------------------------------------
//PRO0010  EXEC COBCICS,MEMBER=PRKYC01,
//             SRCLIB='PRTY.PROD.CBL',
//             LOADLIB='PRTY.PROD.LOADLIB',
//             DBRMLIB='PRTY.PROD.DBRMLIB'
//PRO0020  EXEC COBCICS,MEMBER=PRKYC02,
//             SRCLIB='PRTY.PROD.CBL',
//             LOADLIB='PRTY.PROD.LOADLIB',
//             DBRMLIB='PRTY.PROD.DBRMLIB'
//PRO0030  EXEC COBCICS,MEMBER=PRKYC03,
//             SRCLIB='PRTY.PROD.CBL',
//             LOADLIB='PRTY.PROD.LOADLIB',
//             DBRMLIB='PRTY.PROD.DBRMLIB'
//PRO0040  EXEC COBCICS,MEMBER=PRKYC04,
//             SRCLIB='PRTY.PROD.CBL',
//             LOADLIB='PRTY.PROD.LOADLIB',
//             DBRMLIB='PRTY.PROD.DBRMLIB'
//PRO0050  EXEC COBCICS,MEMBER=PRRSK02,
//             SRCLIB='PRTY.PROD.CBL',
//             LOADLIB='PRTY.PROD.LOADLIB',
//             DBRMLIB='PRTY.PROD.DBRMLIB'
//PRO0060  EXEC COBCICS,MEMBER=PRRSK03,
//             SRCLIB='PRTY.PROD.CBL',
//             LOADLIB='PRTY.PROD.LOADLIB',
//             DBRMLIB='PRTY.PROD.DBRMLIB'
//PRO0070  EXEC COBCICS,MEMBER=PRRSK04,
//             SRCLIB='PRTY.PROD.CBL',
//             LOADLIB='PRTY.PROD.LOADLIB',
//             DBRMLIB='PRTY.PROD.DBRMLIB'
//PRO0080  EXEC COBCICS,MEMBER=PRRSK05,
//             SRCLIB='PRTY.PROD.CBL',
//             LOADLIB='PRTY.PROD.LOADLIB',
//             DBRMLIB='PRTY.PROD.DBRMLIB'
//PRO0090  EXEC COBCICS,MEMBER=PRERR01,
//             SRCLIB='PRTY.PROD.CBL',
//             LOADLIB='PRTY.PROD.LOADLIB',
//             DBRMLIB='PRTY.PROD.DBRMLIB'
//*
//PRB0010  EXEC COBBATCH,MEMBER=PRBRSK1,
//             SRCLIB='PRTY.PROD.CBL',
//             LOADLIB='PRTY.PROD.LOADLIB',
//             DBRMLIB='PRTY.PROD.DBRMLIB'
//PRB0020  EXEC COBBATCH,MEMBER=PRBRSK2,
//             SRCLIB='PRTY.PROD.CBL',
//             LOADLIB='PRTY.PROD.LOADLIB',
//             DBRMLIB='PRTY.PROD.DBRMLIB'
//PRB0030  EXEC COBBATCH,MEMBER=PRBRSK3,
//             SRCLIB='PRTY.PROD.CBL',
//             LOADLIB='PRTY.PROD.LOADLIB',
//             DBRMLIB='PRTY.PROD.DBRMLIB'
//PRB0040  EXEC COBBATCH,MEMBER=PRBRSK4,
//             SRCLIB='PRTY.PROD.CBL',
//             LOADLIB='PRTY.PROD.LOADLIB',
//             DBRMLIB='PRTY.PROD.DBRMLIB'
//PRB0050  EXEC COBBATCH,MEMBER=PRBRSK5,
//             SRCLIB='PRTY.PROD.CBL',
//             LOADLIB='PRTY.PROD.LOADLIB',
//             DBRMLIB='PRTY.PROD.DBRMLIB'
//PRB0060  EXEC COBBATCH,MEMBER=CBPRT01,
//             SRCLIB='PRTY.PROD.CBL',
//             LOADLIB='PRTY.PROD.LOADLIB',
//             DBRMLIB='PRTY.PROD.DBRMLIB'
//PRB0070  EXEC COBBATCH,MEMBER=CBPRT02A,
//             SRCLIB='PRTY.PROD.CBL',
//             LOADLIB='PRTY.PROD.LOADLIB',
//             DBRMLIB='PRTY.PROD.DBRMLIB'
//PRB0080  EXEC COBBATCH,MEMBER=CBPRT02B,
//             SRCLIB='PRTY.PROD.CBL',
//             LOADLIB='PRTY.PROD.LOADLIB',
//             DBRMLIB='PRTY.PROD.DBRMLIB'
//PRB0090  EXEC COBBATCH,MEMBER=CBPRT03,
//             SRCLIB='PRTY.PROD.CBL',
//             LOADLIB='PRTY.PROD.LOADLIB',
//             DBRMLIB='PRTY.PROD.DBRMLIB'
//PRB0100  EXEC COBBATCH,MEMBER=CBPRT04,
//             SRCLIB='PRTY.PROD.CBL',
//             LOADLIB='PRTY.PROD.LOADLIB',
//             DBRMLIB='PRTY.PROD.DBRMLIB'
//*
//*--------------------------------------------------------------------
//* 7 - BIND
//*
//* SUBMITTED THROUGH THE INTERNAL READER SO THAT THE BIND JOBS RUN
//* UNDER THEIR OWN RACF USER.  BINDPRTY FIRST.
//*--------------------------------------------------------------------
//SUBMIT   EXEC PGM=IEBGENER,COND=(4,LT)
//SYSPRINT DD SYSOUT=*
//SYSUT2   DD SYSOUT=(A,INTRDR)
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=PRTY.PROD.JCLLIB(BINDPRTY),DISP=SHR
//         DD DSN=CARD.PROD.JCLLIB(BINDCARD),DISP=SHR
//
