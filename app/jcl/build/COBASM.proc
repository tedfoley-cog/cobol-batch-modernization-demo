//COBASM   PROC MEMBER=,                   HLASM SOURCE MEMBER NAME
//             SRCLIB='CARD.PROD.ASM',     ASSEMBLER SOURCE LIBRARY
//             MACLIB='CARD.PROD.MACLIB',  SITE MACRO LIBRARY
//             LOADLIB='CARD.PROD.LOADLIB',TARGET LOAD LIBRARY
//             ASMHLQ='ASM',               HIGH LEVEL ASSEMBLER HLQ
//             LEHLQ='CEE',                LANGUAGE ENVIRONMENT HLQ
//             WORK='SYSDA'                WORK UNIT
//*
//*--------------------------------------------------------------------
//* COBASM - ASSEMBLE AND LINK THE HLASM SUBROUTINE
//*
//* THE MODULE USES STANDARD OS LINKAGE AND IS CALLED STATICALLY FROM
//* COBOL, SO IT IS LINKED AS A SEPARATE LOAD MODULE AND THEN INCLUDED
//* BY THE COBOL LINK EDIT STEPS.  IT IS NOT AN LE ENABLED ROUTINE -
//* IT SAVES AND RESTORES THE CALLER'S REGISTERS ITSELF AND DOES NOT
//* ESTABLISH AN LE ENCLAVE.
//*
//* RENT AND RMODE(ANY) - THE ONLINE REGION RUNS RENTPGM=PROTECT AND
//* THE MODULE IS DEFINED RESIDENT IN THE CSD, SO IT MUST NOT MODIFY
//* ITSELF AND MUST NOT HOLD STATE ACROSS CALLS.  ALL WORK AREAS ARE
//* OBTAINED FROM THE CALLER'S PARAMETER LIST.
//*
//* FLAG(8) - WARNINGS AT SEVERITY 8 OR ABOVE FAIL THE STEP.  THIS
//* MODULE HAS ASSEMBLED CLEAN SINCE 1996 AND IS EXPECTED TO KEEP
//* DOING SO.
//*--------------------------------------------------------------------
//*
//*--------------------------------------------------------------------
//* STEP 1 - ASSEMBLE
//*--------------------------------------------------------------------
//ASM      EXEC PGM=ASMA90,REGION=0M,
//    PARM=('OBJECT,NODECK,XREF(SHORT),RENT,FLAG(8)',
//          'LIST(133),RLD,ESD,USING(WARN(15))')
//STEPLIB  DD DSN=&ASMHLQ..SASMMOD1,DISP=SHR
//SYSIN    DD DSN=&SRCLIB.(&MEMBER),DISP=SHR
//SYSLIB   DD DSN=&MACLIB,DISP=SHR
//         DD DSN=SYS1.MACLIB,DISP=SHR
//         DD DSN=SYS1.MODGEN,DISP=SHR
//SYSLIN   DD DSN=&&OBJ,DISP=(NEW,PASS),
//            UNIT=&WORK,SPACE=(CYL,(2,2)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=27920)
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD UNIT=&WORK,SPACE=(CYL,(2,2))
//*
//*--------------------------------------------------------------------
//* STEP 2 - LINK EDIT
//*
//* NO LE STUB AND NO CICS STUB.  THE MODULE IS SELF CONTAINED - IF
//* THE LINK EDIT REPORTS ANY UNRESOLVED EXTERNAL REFERENCE, THE
//* SOURCE HAS ACQUIRED A DEPENDENCY IT SHOULD NOT HAVE.
//*--------------------------------------------------------------------
//LKED     EXEC PGM=IEWL,REGION=0M,COND=(4,LT,ASM),
//             PARM='RENT,REUS,XREF,LIST,MAP,AMODE(31),RMODE(ANY),NCAL'
//SYSLIB   DD DSN=&LEHLQ..SCEELKED,DISP=SHR
//SYSLIN   DD DSN=&&OBJ,DISP=(OLD,DELETE)
//         DD *
  ENTRY   &MEMBER
  NAME    &MEMBER(R)
/*
//SYSLMOD  DD DSN=&LOADLIB,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD UNIT=&WORK,SPACE=(CYL,(2,2))
//         PEND
