//COBBATCH PROC MEMBER=,                   COBOL SOURCE MEMBER NAME
//             SRCLIB='CARD.PROD.CBL',     SOURCE LIBRARY
//             CPYLIB='CARD.PROD.CPY',     COPYBOOK LIBRARY
//             CPYLIB2='PRTY.PROD.CPY',    MODULE PRIVATE COPYBOOKS
//             LOADLIB='CARD.PROD.LOADLIB',TARGET LOAD LIBRARY
//             DBRMLIB='CARD.PROD.DBRMLIB',DBRM LIBRARY
//             CALLOPT='NODYNAM',          NODYNAM OR DYNAM
//             SSID=DB2P,                  DB2 SUBSYSTEM
//             DB2HLQ='DSN',               DB2 HIGH LEVEL QUALIFIER
//             LEHLQ='CEE',                LANGUAGE ENVIRONMENT HLQ
//             COBHLQ='IGY',               COMPILER HLQ
//             SORTHLQ='SORT',             SORT PRODUCT HLQ
//             WORK='SYSDA'                WORK UNIT
//*
//*--------------------------------------------------------------------
//* COBBATCH - PRECOMPILE, COMPILE AND LINK EDIT BATCH PROGRAMS
//*
//* NO CICS TRANSLATE STEP.  BATCH PROGRAMS CONTAIN NO EXEC CICS.
//*
//* CALL RESOLUTION - THE CALLOPT SYMBOLIC
//* -----------------------------------------------------------------
//* CALLOPT=NODYNAM   DEFAULT.  EVERY CALL LITERAL IS RESOLVED AT
//*                   LINK EDIT TIME AND THE CALLED MODULE IS BOUND
//*                   INTO THE LOAD MODULE.  THIS IS WHAT ALMOST THE
//*                   WHOLE BATCH ESTATE USES.
//*
//* CALLOPT=DYNAM     REQUIRED FOR A PROGRAM THAT ISSUES A CALL ON A
//*                   DATA NAME RATHER THAN A LITERAL.  THE MODULE
//*                   NAME IS NOT KNOWN AT LINK EDIT TIME, SO THE
//*                   CALL GOES THROUGH THE LANGUAGE ENVIRONMENT
//*                   LOADER AT RUN TIME AND THE TARGET MUST BE IN
//*                   THE STEPLIB CONCATENATION OF EVERY JOB THAT
//*                   RUNS THE CALLER.
//*
//*                   A MODULE COMPILED DYNAM RESOLVES ALL OF ITS
//*                   CALLS DYNAMICALLY, INCLUDING LITERAL ONES, SO
//*                   IT IS SET ONLY WHERE IT IS NEEDED.
//*
//* THE MEMBERS BUILT WITH DYNAM ARE LISTED IN BUILDALL.JCL.  IF A NEW
//* PROGRAM ISSUES A CALL ON A DATA NAME IT MUST BE ADDED THERE OR IT
//* WILL FAIL AT LINK EDIT WITH AN UNRESOLVED EXTERNAL REFERENCE.
//*
//* RESTART - THE LONG RUNNING POSTING AND ACCRUAL PROGRAMS COMMIT ON
//* A COUNT AND REWRITE THEIR CYCLE CONTROL RECORD.  THEY MUST BE
//* COMPILED NOOPTIMIZE DURING PROBLEM INVESTIGATION SO THAT THE
//* OFFSET IN A DUMP MATCHES THE LISTING - USE THE OPTOVR SYMBOLIC ON
//* THE EXEC STATEMENT TO OVERRIDE, DO NOT EDIT THIS PROC.
//*--------------------------------------------------------------------
//*
//*--------------------------------------------------------------------
//* STEP 1 - DB2 PRECOMPILE
//*--------------------------------------------------------------------
//PC       EXEC PGM=DSNHPC,REGION=0M,
//             PARM='HOST(IBMCOB),APOST,SOURCE,XREF,STDSQL(NO)'
//STEPLIB  DD DSN=&DB2HLQ..SDSNLOAD,DISP=SHR
//DBRMLIB  DD DSN=&DBRMLIB.(&MEMBER),DISP=SHR
//SYSCIN   DD DSN=&&PCOUT,DISP=(NEW,PASS),
//            UNIT=&WORK,SPACE=(CYL,(3,3)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=27920)
//SYSLIB   DD DSN=&CPYLIB,DISP=SHR
//         DD DSN=&CPYLIB2,DISP=SHR
//SYSIN    DD DSN=&SRCLIB.(&MEMBER),DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSTERM  DD SYSOUT=*
//SYSUT1   DD UNIT=&WORK,SPACE=(CYL,(3,3))
//SYSUT2   DD UNIT=&WORK,SPACE=(CYL,(3,3))
//*
//*--------------------------------------------------------------------
//* STEP 2 - COMPILE
//*--------------------------------------------------------------------
//COB      EXEC PGM=IGYCRCTL,REGION=0M,COND=(4,LT,PC),
//    PARM=('&CALLOPT.,LIB,OBJECT,RENT,RES,APOST,MAP,XREF,LIST',
//          'DATA(31),TRUNC(OPT),NUMPROC(NOPFD),OPT(FULL)',
//          'SSRANGE,ARITH(EXTEND),NOTEST')
//STEPLIB  DD DSN=&COBHLQ..SIGYCOMP,DISP=SHR
//         DD DSN=&LEHLQ..SCEERUN,DISP=SHR
//SYSIN    DD DSN=&&PCOUT,DISP=(OLD,DELETE)
//SYSLIB   DD DSN=&CPYLIB,DISP=SHR
//         DD DSN=&CPYLIB2,DISP=SHR
//SYSLIN   DD DSN=&&OBJ,DISP=(NEW,PASS),
//            UNIT=&WORK,SPACE=(CYL,(3,3)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=27920)
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD UNIT=&WORK,SPACE=(CYL,(3,3))
//SYSUT2   DD UNIT=&WORK,SPACE=(CYL,(3,3))
//SYSUT3   DD UNIT=&WORK,SPACE=(CYL,(3,3))
//SYSUT4   DD UNIT=&WORK,SPACE=(CYL,(3,3))
//SYSUT5   DD UNIT=&WORK,SPACE=(CYL,(3,3))
//SYSUT6   DD UNIT=&WORK,SPACE=(CYL,(3,3))
//SYSUT7   DD UNIT=&WORK,SPACE=(CYL,(3,3))
//SYSMDECK DD UNIT=&WORK,SPACE=(CYL,(3,3))
//*
//*--------------------------------------------------------------------
//* STEP 3 - LINK EDIT
//*
//* DSNELI IS THE BATCH LANGUAGE INTERFACE.  DO NOT USE DSNCLI HERE -
//* THAT IS THE CICS ATTACHMENT AND THE MODULE WOULD ABEND ON THE
//* FIRST SQL CALL UNDER TSO OR BATCH.
//*
//* SORT IS INCLUDED FOR THE PROGRAMS THAT ISSUE AN INTERNAL SORT.
//*--------------------------------------------------------------------
//LKED     EXEC PGM=IEWL,REGION=0M,COND=((4,LT,PC),(4,LT,COB)),
//             PARM='RENT,REUS,XREF,LIST,MAP,AMODE(31),RMODE(ANY)'
//SYSLIB   DD DSN=&DB2HLQ..SDSNLOAD,DISP=SHR
//         DD DSN=&LEHLQ..SCEELKED,DISP=SHR
//         DD DSN=&SORTHLQ..SORTLIB,DISP=SHR
//         DD DSN=&LOADLIB,DISP=SHR
//SYSLIN   DD DSN=&&OBJ,DISP=(OLD,DELETE)
//         DD *
  INCLUDE SYSLIB(DSNELI)
  INCLUDE SYSLIB(CARDCHK)
  NAME    &MEMBER(R)
/*
//SYSLMOD  DD DSN=&LOADLIB,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD UNIT=&WORK,SPACE=(CYL,(3,3))
//         PEND
