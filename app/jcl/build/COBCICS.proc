//COBCICS  PROC MEMBER=,                   COBOL SOURCE MEMBER NAME
//             SRCLIB='CARD.PROD.CBL',     SOURCE LIBRARY
//             CPYLIB='CARD.PROD.CPY',     COPYBOOK LIBRARY
//             CPYLIB2='PRTY.PROD.CPY',    MODULE PRIVATE COPYBOOKS
//             LOADLIB='CARD.PROD.LOADLIB',TARGET LOAD LIBRARY
//             DBRMLIB='CARD.PROD.DBRMLIB',DBRM LIBRARY
//             CALLOPT='NODYNAM',          NODYNAM OR DYNAM
//             SSID=DB2P,                  DB2 SUBSYSTEM
//             CICSHLQ='CICSTS',           CICS TS HIGH LEVEL QUALIFIER
//             DB2HLQ='DSN',               DB2 HIGH LEVEL QUALIFIER
//             LEHLQ='CEE',                LANGUAGE ENVIRONMENT HLQ
//             COBHLQ='IGY',               COMPILER HLQ
//             WORK='SYSDA'                WORK UNIT
//*
//*--------------------------------------------------------------------
//* COBCICS - TRANSLATE, PRECOMPILE, COMPILE AND LINK EDIT
//*           CICS + DB2 ONLINE PROGRAMS
//*
//* FOUR STEPS.  THE ORDER IS FIXED - THE CICS TRANSLATOR MUST SEE THE
//* SOURCE BEFORE THE DB2 PRECOMPILER, BECAUSE THE TRANSLATOR TURNS
//* EXEC CICS INTO CALL STATEMENTS THAT THE PRECOMPILER MUST NOT TRY
//* TO PARSE AS SQL, AND BECAUSE THE TRANSLATOR INSERTS THE DFHEIBLK
//* AND DFHCOMMAREA PARAMETERS THE PRECOMPILER NEEDS TO SEE IN THE
//* PROCEDURE DIVISION HEADER.
//*
//* THE PRECOMPILER EXPANDS COPY MEMBERS ITSELF SO SYSLIB IS NEEDED ON
//* BOTH THE TRANSLATE AND PRECOMPILE STEPS.
//*
//* CALLOPT DEFAULTS TO NODYNAM.  A CICS PROGRAM NORMALLY REACHES
//* ANOTHER PROGRAM WITH LINK OR XCTL RATHER THAN A COBOL CALL, SO
//* THERE IS NOTHING FOR DYNAM TO DO.  THE FEW ONLINE MODULES THAT
//* ALSO ISSUE A COBOL CALL ON A DATA NAME ARE BUILT WITH
//* CALLOPT=DYNAM - SEE THE DYNAM LIST IN BUILDALL.JCL.
//*
//* RENT AND RMODE(ANY) ARE MANDATORY - THE REGION IS DEFINED
//* RENTPGM=PROTECT AND A NON REENTRANT MODULE WILL FAIL AT LOAD.
//*--------------------------------------------------------------------
//*
//*--------------------------------------------------------------------
//* STEP 1 - CICS COMMAND LEVEL TRANSLATOR
//*--------------------------------------------------------------------
//TRN      EXEC PGM=DFHECP1$,REGION=0M,
//             PARM='COBOL3,SP,CICS,DEBUG,SOURCE,FLAG(I)'
//STEPLIB  DD DSN=&CICSHLQ..SDFHLOAD,DISP=SHR
//SYSIN    DD DSN=&SRCLIB.(&MEMBER),DISP=SHR
//SYSLIB   DD DSN=&CPYLIB,DISP=SHR
//         DD DSN=&CPYLIB2,DISP=SHR
//         DD DSN=&CICSHLQ..SDFHCOB,DISP=SHR
//SYSPUNCH DD DSN=&&TRNOUT,DISP=(NEW,PASS),
//            UNIT=&WORK,SPACE=(CYL,(3,3)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=27920)
//SYSPRINT DD SYSOUT=*
//*
//*--------------------------------------------------------------------
//* STEP 2 - DB2 PRECOMPILE
//*
//* THE DBRM MEMBER NAME IS THE PROGRAM NAME.  IT MUST MATCH THE
//* PACKAGE NAME IN THE BIND OR THE CONSISTENCY TOKEN CHECK FAILS AT
//* RUN TIME WITH SQLCODE -805.
//*--------------------------------------------------------------------
//PC       EXEC PGM=DSNHPC,REGION=0M,COND=(4,LT,TRN),
//             PARM='HOST(IBMCOB),APOST,SOURCE,XREF,STDSQL(NO)'
//STEPLIB  DD DSN=&DB2HLQ..SDSNLOAD,DISP=SHR
//DBRMLIB  DD DSN=&DBRMLIB.(&MEMBER),DISP=SHR
//SYSCIN   DD DSN=&&PCOUT,DISP=(NEW,PASS),
//            UNIT=&WORK,SPACE=(CYL,(3,3)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=27920)
//SYSLIB   DD DSN=&CPYLIB,DISP=SHR
//         DD DSN=&CPYLIB2,DISP=SHR
//SYSIN    DD DSN=&&TRNOUT,DISP=(OLD,DELETE)
//SYSPRINT DD SYSOUT=*
//SYSTERM  DD SYSOUT=*
//SYSUT1   DD UNIT=&WORK,SPACE=(CYL,(3,3))
//SYSUT2   DD UNIT=&WORK,SPACE=(CYL,(3,3))
//*
//*--------------------------------------------------------------------
//* STEP 3 - COMPILE
//*
//* DATA(31) AND RENT - THE PROGRAMS ARE DEFINED DATALOCATION(ANY)
//* AND THE REGION RUNS WITH STORAGE PROTECTION ON.
//*
//* TRUNC(OPT) IS SET DELIBERATELY.  THE ESTATE HAS BEEN COMPILED WITH
//* IT SINCE 1997 AND SEVERAL PROGRAMS RELY ON THE BINARY FIELDS NOT
//* BEING TRUNCATED TO THEIR PICTURE.  DO NOT CHANGE IT FOR A SINGLE
//* MODULE - IT IS AN ESTATE WIDE DECISION.
//*--------------------------------------------------------------------
//COB      EXEC PGM=IGYCRCTL,REGION=0M,COND=((4,LT,TRN),(4,LT,PC)),
//    PARM=('&CALLOPT.,LIB,OBJECT,RENT,RES,APOST,MAP,XREF,LIST',
//          'DATA(31),TRUNC(OPT),NUMPROC(NOPFD),OPT(FULL)',
//          'SSRANGE,ARITH(EXTEND),TEST(NOHOOK,SEPARATE)')
//STEPLIB  DD DSN=&COBHLQ..SIGYCOMP,DISP=SHR
//         DD DSN=&LEHLQ..SCEERUN,DISP=SHR
//SYSIN    DD DSN=&&PCOUT,DISP=(OLD,DELETE)
//SYSLIB   DD DSN=&CPYLIB,DISP=SHR
//         DD DSN=&CPYLIB2,DISP=SHR
//         DD DSN=&CICSHLQ..SDFHCOB,DISP=SHR
//SYSLIN   DD DSN=&&OBJ,DISP=(NEW,PASS),
//            UNIT=&WORK,SPACE=(CYL,(3,3)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=27920)
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD UNIT=&WORK,SPACE=(CYL,(3,3))
//SYSUT2   DD UNIT=&WORK,SPACE=(CYL,(3,3))
//SYSUT3   DD UNIT=&WORK,SPACE=(CYL,(3,3))
//SYSUT4   DD UNIT=&WORK,SPACE=(CYL,(3,3))
//SYSUT5   DD UNIT=&WORK,SPACE=(CYL,(3,3))
//SYSUT6   DD UNIT=&WORK,SPACE=(CYL,(3,3))
//SYSUT7   DD UNIT=&WORK,SPACE=(CYL,(3,3))
//SYSMDECK DD UNIT=&WORK,SPACE=(CYL,(3,3))
//*
//*--------------------------------------------------------------------
//* STEP 4 - LINK EDIT
//*
//* DFHELII IS THE CICS COMMAND LEVEL STUB AND MUST BE THE FIRST
//* INCLUDE.  DSNCLI IS THE CICS ATTACHMENT LANGUAGE INTERFACE - IT
//* MUST BE THE CICS ONE, NOT DSNELI, OR EVERY SQL CALL FAILS.
//*
//* CARDCHK IS INCLUDED FOR THE PROGRAMS THAT CALL IT STATICALLY.
//* THE INCLUDE IS HARMLESS FOR THE ONES THAT DO NOT - THE LINKAGE
//* EDITOR DROPS AN UNREFERENCED CSECT ONLY IF IT IS NOT NAMED, SO
//* THE MODULE CARRIES AN EXTRA 800 BYTES.  ACCEPTED IN 2003 RATHER
//* THAN MAINTAIN A PER PROGRAM LINK DECK.
//*--------------------------------------------------------------------
//LKED     EXEC PGM=IEWL,REGION=0M,
//             COND=((4,LT,TRN),(4,LT,PC),(4,LT,COB)),
//             PARM='RENT,REUS,XREF,LIST,MAP,AMODE(31),RMODE(ANY)'
//SYSLIB   DD DSN=&CICSHLQ..SDFHLOAD,DISP=SHR
//         DD DSN=&DB2HLQ..SDSNLOAD,DISP=SHR
//         DD DSN=&LEHLQ..SCEELKED,DISP=SHR
//         DD DSN=&LOADLIB,DISP=SHR
//SYSLIN   DD DSN=&&OBJ,DISP=(OLD,DELETE)
//         DD *
  INCLUDE SYSLIB(DFHELII)
  INCLUDE SYSLIB(DSNCLI)
  INCLUDE SYSLIB(CARDCHK)
  ENTRY   DFHELII
  NAME    &MEMBER(R)
/*
//SYSLMOD  DD DSN=&LOADLIB,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD UNIT=&WORK,SPACE=(CYL,(3,3))
//         PEND
