//CBCRD03J JOB (CARD,BATCH,0100),'CARD BATCH SVCS',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//             REGION=0M,TIME=1440,NOTIFY=&SYSUID
//*
//****************************************************************
//* CARDNITE STEP 3 OF 10 - SORT AND MERCHANT ENRICHMENT
//*
//* STEP010 SORTS THE CLEAN EXTRACT INTO CARD, DATE AND SEQUENCE
//*         ORDER SO THE ENRICHMENT STEP CAN KEEP THE MERCHANT
//*         ROUTE KSDS BROWSE MOVING FORWARD.  RECORDS THAT WERE
//*         REJECTED BY THE EDIT ARE DROPPED BY THE INCLUDE.
//* STEP020 RESOLVES MCC, ACQUIRER AND SETTLEMENT ROUTE FROM VSAM
//*         MERCHRTE AND CARDSVC.MERCHANT.  AN UNMATCHED MERCHANT
//*         TAKES THE DEFAULT ROUTE FROM SYSIN AND IS WARNED.
//*
//* SORT FIELD DISPLACEMENTS - AUTH-EXTRACT-REC (CVAXTR01Y)
//*    035 016 AUTH-CARD-NUM
//*    051 008 AUTH-DATE
//*    059 009 AUTH-SEQ-NUM
//*    214 001 AX-EDIT-STATUS   C CLEAN  W WARNED  R REJECTED
//*
//* RETURN CODES
//*   0000 EVERY MERCHANT RESOLVED
//*   0004 SOME MERCHANTS DEFAULTED - SEE THE WARNING COUNT
//*   0008 DEFAULT ROUTE CARD MISSING OR MERCHRTE UNUSABLE
//*   0012 FATAL, U0302 OR U0303 ABEND
//*
//* RESTART
//*   RESTART=STEP010.  IF THE SORT WAS GOOD AND ONLY THE
//*   ENRICHMENT FAILED, RESTART=STEP020 IS SAFE BECAUSE THE SORT
//*   OUTPUT IS A CATALOGUED GENERATION AND IS RE-READ FROM (0).
//****************************************************************
//*
//         JCLLIB ORDER=(CARD.PROD.PROCLIB)
//         SET CYCDATE=20240131
//*
//STEP010  EXEC PGM=SORT,REGION=64M,TIME=(15,00)
//SORTIN   DD DSN=CARD.PROD.AUTHCLN(0),DISP=SHR
//SORTOUT  DD DSN=CARD.PROD.AUTHSRT(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,
//             SPACE=(CYL,(300,60),RLSE),
//             DCB=(RECFM=FB,LRECL=300,BLKSIZE=27300)
//SORTWK01 DD UNIT=SYSDA,SPACE=(CYL,(150,30))
//SORTWK02 DD UNIT=SYSDA,SPACE=(CYL,(150,30))
//SORTWK03 DD UNIT=SYSDA,SPACE=(CYL,(150,30))
//SYSIN    DD *
  SORT FIELDS=(035,016,CH,A,
               051,008,CH,A,
               059,009,CH,A)
  INCLUDE COND=(214,001,CH,EQ,C'C',OR,
                214,001,CH,EQ,C'W')
  OPTION DYNALLOC=(SYSDA,6)
/*
//SYSOUT   DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//*
//****************************************************************
//* A SORT RC OF 16 MEANS THE SORT ITSELF FAILED, 4 MEANS EVERY
//* RECORD WAS EXCLUDED.  NEITHER IS WORTH ENRICHING.
//****************************************************************
//*
//         IF (STEP010.RC = 0) THEN
//STEP020  EXEC CARDDB2,RGN=48M,TM=(30,00)
//RUNDB2.SYSTSIN DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(CBCRD03) PLAN(CARDNITP) -
      LIB('CARD.PROD.LOADLIB') PARM('20240131')
  END
/*
//RUNDB2.AUTHSRT  DD DSN=CARD.PROD.AUTHSRT(0),DISP=SHR
//RUNDB2.MERCHRTE DD DSN=CARD.PROD.MERCHRTE,DISP=SHR
//RUNDB2.CYCLCTL  DD DSN=CARD.PROD.CYCLCTL,DISP=SHR
//RUNDB2.AUTHENR  DD DSN=CARD.PROD.AUTHENR(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,
//             SPACE=(CYL,(300,60),RLSE),
//             DCB=(RECFM=FB,LRECL=300,BLKSIZE=27300)
//*
//* BUSINESS PARAMETERS - THE DEFAULT SETTLEMENT ROUTE AND THE
//* DEFAULT ACQUIRER ARE AGREED WITH SETTLEMENTS AND CHANGE
//* WITHOUT A PROGRAM CHANGE.
//*
//RUNDB2.SYSIN    DD *
* CARDNITE MERCHANT ENRICHMENT CONTROL CARDS
DEFAULT-ROUTE=DFLT
DEFAULT-ACQID=99999999999
END
/*
//         ENDIF
//
