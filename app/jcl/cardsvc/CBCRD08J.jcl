//CBCRD08J JOB (CARD,BATCH,0100),'CARD BATCH SVCS',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//             REGION=0M,TIME=1440,NOTIFY=&SYSUID
//*
//****************************************************************
//* CARDNITE STEP 8 OF 10 - DELINQUENCY AND AGING
//*
//* ROLLS ACCOUNT.DELQ_BUCKET FORWARD BY AT MOST ONE BUCKET A
//* CYCLE, RECOMPUTES DELQ_AMT, PRINTS THE AGING REPORT WITH
//* CONTROL BREAKS BY PRODUCT AND BUCKET, AND WRITES THE
//* COLLECTIONS FEED FOR EVERY ACCOUNT AT BUCKET 3 OR WORSE.
//*
//* THE GRACE DAYS VALUE IS A COLLECTIONS POLICY PARAMETER AND
//* LIVES ON THE SYSIN CARD, NOT IN THE PROGRAM.
//*
//* RETURN CODES
//*   0000 AGING COMPLETE, NOTHING AT CHARGE OFF
//*   0004 CHARGE OFF CANDIDATES EXIST AT BUCKET 6 - COLLECTIONS
//*        MUST WORK THE FEED THE SAME MORNING
//*   0008 NO ACCOUNTS SELECTED, OR THE GRACE CARD WAS REJECTED
//*   0012 FATAL, U0803 SQL FAILURE
//*
//* RESTART
//*   RESTART=STEP010.  THE BUCKET ROLL IS DRIVEN FROM THE
//*   PAYMENT DUE DATE AND THE SHORTFALL, NOT FROM THE PREVIOUS
//*   BUCKET ALONE, SO A SECOND RUN ON THE SAME CYCLE DATE DOES
//*   NOT DOUBLE ROLL.  IT IS STILL BETTER TO RESTART FROM THE
//*   LAST GOOD COMMIT REPORTED IN SYSOUT.
//****************************************************************
//*
//         JCLLIB ORDER=(CARD.PROD.PROCLIB)
//         SET CYCDATE=20240131
//*
//STEP010  EXEC CARDDB2,RGN=64M,TM=(45,00)
//RUNDB2.SYSTSIN DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(CBCRD08) PLAN(CARDNITP) -
      LIB('CARD.PROD.LOADLIB') PARM('20240131')
  END
/*
//RUNDB2.CYCLCTL  DD DSN=CARD.PROD.CYCLCTL,DISP=SHR
//RUNDB2.AGERPT   DD SYSOUT=*,
//             DCB=(RECFM=FBA,LRECL=133,BLKSIZE=27930)
//RUNDB2.COLLECT  DD DSN=CARD.PROD.COLLECT(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,
//             SPACE=(CYL,(30,10),RLSE),
//             DCB=(RECFM=FB,LRECL=100,BLKSIZE=27300)
//RUNDB2.SYSIN    DD *
* CARDNITE DELINQUENCY CONTROL CARDS - COLLECTIONS POLICY CP-07
GRACE-DAYS=005
END
/*
//*
//****************************************************************
//* THE COLLECTIONS FEED IS TRANSMITTED TO THE COLLECTIONS
//* SYSTEM BY THE FILE TRANSFER JOB CBCRD88J, WHICH THE
//* SCHEDULER RELEASES ON THIS STEP ENDING 0 OR 4.
//****************************************************************
//*
//         IF (STEP010.RUNDB2.RC <= 4) THEN
//STEP020  EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//COLLIN   DD DSN=CARD.PROD.COLLECT(+1),DISP=SHR
//SYSIN    DD *
 /* COUNT THE FEED SO THE TRANSMISSION JOB CAN BE RECONCILED */
 PRINT INFILE(COLLIN) COUNT(20) CHARACTER
/*
//SYSUDUMP DD SYSOUT=D
//         ENDIF
//
