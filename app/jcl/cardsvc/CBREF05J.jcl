//CBREF05J JOB (CARD,REFR),'REFERENCE INTEGRITY',CLASS=C,MSGCLASS=X,
//             REGION=0M,TIME=(60,00),NOTIFY=&SYSUID
//*
//* ------------------------------------------------------------------
//* CARDREF STEP 5 OF 5 - REFERENCE INTEGRITY AND DATA QUALITY REPORT
//*
//* ORPHAN CHECKS, ROUTE TABLE SANITY AND A VSAM AGAINST DB2 COUNT
//* COMPARISON.  THE STEP CHANGES NOTHING.  IT IS THE LAST JOB IN
//* THE WEEKLY CHAIN BECAUSE THE COUNT COMPARISON IS ONLY MEANINGFUL
//* AFTER THE REBUILDS HAVE RUN.
//*
//* THE ANTI JOIN CURSORS SCAN THE WHOLE TRANSACTION TABLE.  THE
//* STEP IS BOUND WITH UR AND HOLDS NO LOCKS, BUT IT IS THE LONGEST
//* RUNNING STEP IN THE CHAIN - DO NOT SUBMIT IT INSIDE THE ONLINE
//* DAY WITHOUT TELLING DATABASE SERVICES.
//*
//* RETURN CODES - 0 CLEAN, 4 FINDINGS INSIDE TOLERANCE, 8 TOLERANCE
//* EXCEEDED OR A VSAM COUNT OUT OF STEP WITH DB2, 12 ABEND.
//* ------------------------------------------------------------------
//*
//JOBLIB   DD DSN=CARD.PROD.LOADLIB,DISP=SHR
//         DD DSN=DSN.V12R1.SDSNLOAD,DISP=SHR
//*
//INTGRPT  EXEC PGM=IKJEFT01,DYNAMNBR=40
//STEPLIB  DD DSN=CARD.PROD.LOADLIB,DISP=SHR
//         DD DSN=DSN.V12R1.SDSNLOAD,DISP=SHR
//MERCHRTE DD DSN=CARD.PROD.MERCHRTE,DISP=SHR
//PGMROUT  DD DSN=CARD.PROD.PGMROUT,DISP=SHR
//REFRPT   DD DSN=CARD.PROD.REF.REFRPT(+1),
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(CYL,(30,10),RLSE),
//            DCB=(RECFM=FBA,LRECL=133,BLKSIZE=27930)
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN  PROGRAM(CBREF05) PLAN(CARDREFP) -
       LIB('CARD.PROD.LOADLIB')
  END
/*
//REFPARM  DD *
RUN-DATE     20250201
ORPHAN-TOL   00100
ROUTE-TOL    00000
LIST-LIMIT   00050
*  ORPHAN-TOL ALLOWS FOR THE CARDS EMBOSSED IN THE WINDOW BETWEEN
*  THE ACCOUNT OPEN AND THE OVERNIGHT ACCOUNT LOAD.  ROUTE-TOL IS
*  ZERO - A ROUTE FINDING IS ALWAYS INVESTIGATED.
/*
//*
//* ------------------------------------------------------------------
//* STEP 2 - PRINT THE REPORT.  ALWAYS, INCLUDING AFTER AN ABEND.
//* ------------------------------------------------------------------
//PRTREF   EXEC PGM=IEBGENER,COND=EVEN
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD DSN=CARD.PROD.REF.REFRPT(0),DISP=SHR
//SYSUT2   DD SYSOUT=(A,,STD1),DCB=(RECFM=FBA,LRECL=133)
//SYSIN    DD DUMMY
//*
//* ------------------------------------------------------------------
//* STEP 3 - RAISE THE DATA QUALITY TICKET WHEN THE REPORT FOUND
//* SOMETHING THAT NEEDS A HUMAN.
//* ------------------------------------------------------------------
//         IF (INTGRPT.RC >= 8) THEN
//NOTIFY   EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD *
CARDREF REFERENCE INTEGRITY REPORT ENDED WITH SEVERITY 8 OR ABOVE.
SEE CARD.PROD.REF.REFRPT FOR THE DETAIL.  RAISE A DATA QUALITY
TICKET AGAINST CARD SYSTEMS AND ATTACH THE REPORT.  DO NOT RERUN
THE REBUILD JOBS TO CLEAR IT - THE COUNTS WILL AGREE AND THE
UNDERLYING ROWS WILL NOT HAVE CHANGED.
/*
//SYSUT2   DD SYSOUT=(A,,NOTIFY),DCB=(RECFM=FB,LRECL=80)
//SYSIN    DD DUMMY
//         ENDIF
