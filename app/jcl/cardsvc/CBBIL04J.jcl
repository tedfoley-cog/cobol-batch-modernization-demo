//CBBIL04J JOB (CARD,BILL),'STATEMENT RENDER',CLASS=B,MSGCLASS=X,
//             REGION=0M,TIME=(60,00),NOTIFY=&SYSUID
//*
//* ------------------------------------------------------------------
//* CARDBILL STEP 4 OF 6 - STATEMENT RENDERING
//*
//* CBBIL04 READS THE DELIVERY PREFERENCE FROM VSAM CUSTPREF, TURNS
//* IT INTO A ROUTE KEY AND CALLS THE BATCH DISPATCHER.  THE
//* FORMATTER IS RESOLVED AT RUN TIME FROM CARDSVC.PGM_ROUTE, SO
//* CBBIL04 IS LINK EDITED WITH DYNAM AND THE FORMATTERS MUST BE IN
//* THE STEPLIB EVEN THOUGH NO STEP NAMES THEM.
//*
//* BOTH FORMATTER OUTPUT FILES ARE ALLOCATED ON THIS STEP.  A CYCLE
//* WITH NO ELECTRONIC CUSTOMERS STILL LEAVES AN EMPTY STMTEXT - THE
//* VENDOR TRANSMISSION JOB TREATS THAT AS A ZERO RECORD FILE, NOT
//* AS A FAILURE.
//*
//* STMTPRT IS FBA - THE CARRIAGE CONTROL BYTE CBSTM01 WRITES IN
//* COLUMN 1 IS PART OF THE 133 BYTE RECORD.
//* ------------------------------------------------------------------
//*
//JOBLIB   DD DSN=CARD.PROD.LOADLIB,DISP=SHR
//         DD DSN=DSN.V12R1.SDSNLOAD,DISP=SHR
//*
//RENDER   EXEC PGM=IKJEFT01,DYNAMNBR=40,COND=(4,LT)
//STEPLIB  DD DSN=CARD.PROD.LOADLIB,DISP=SHR
//         DD DSN=DSN.V12R1.SDSNLOAD,DISP=SHR
//STMTWK2  DD DSN=CARD.PROD.BILL.STMTWK2(0),DISP=SHR
//STMTWK3  DD DSN=CARD.PROD.BILL.STMTWK3(+1),
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(CYL,(900,180),RLSE),
//            DCB=(RECFM=VB,LRECL=24208,BLKSIZE=27998)
//CUSTPREF DD DSN=CARD.PROD.CUSTPREF,DISP=SHR
//STMTPRT  DD DSN=CARD.PROD.BILL.STMTPRT(+1),
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(CYL,(1500,300),RLSE),
//            DCB=(RECFM=FBA,LRECL=133,BLKSIZE=27930)
//STMTEXT  DD DSN=CARD.PROD.BILL.STMTEXT(+1),
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(CYL,(600,120),RLSE),
//            DCB=(RECFM=VB,LRECL=32004,BLKSIZE=32760)
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN  PROGRAM(CBBIL04) PLAN(CARDBILP) -
       LIB('CARD.PROD.LOADLIB')
  END
/*
//SYSIN    DD *
CYCLE-DATE  20250131
CYCLE-ID    B202501
DFLT-DELIV  PAPR
ELEC-CUTOVR 20240401
*  DFLT-DELIV IS USED WHEN CUSTPREF HAS NO RECORD FOR THE ACCOUNT.
*  ELEC-CUTOVR IS THE DATE THE E DELIVERY CONSENT WAS RE PAPERED -
*  A CONSENT OLDER THAN THAT IS NOT HONOURED AND THE ACCOUNT IS
*  RENDERED ON PAPER.
/*
//*
//* ------------------------------------------------------------------
//* STEP 2 - PRINT THE PAPER IMAGES.  A RENDER RETURN CODE OF 4 MEANS
//* SOME ACCOUNTS FELL BACK TO PAPER, WHICH IS STILL PRINTABLE.
//* ------------------------------------------------------------------
//         IF (RENDER.RC <= 4) THEN
//PRINT    EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD DSN=CARD.PROD.BILL.STMTPRT(0),DISP=SHR
//SYSUT2   DD SYSOUT=(P,,STD1),DCB=(RECFM=FBA,LRECL=133)
//SYSIN    DD DUMMY
//         ELSE
//NOPRINT  EXEC PGM=IEFBR14
//         ENDIF
