//CBCRD05B JOB (CARD,BATCH,0100),'CARD BATCH SVCS',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//             REGION=0M,TIME=1440,NOTIFY=&SYSUID
//*
//****************************************************************
//* CARDNITE STEP 5B OF 10 - INTEREST AND REWARDS BRANCH
//*
//* SUBMITTED IN PARALLEL WITH CBCRD05AJ AFTER CBCRD04J ENDS.
//* AVERAGE DAILY BALANCE INTEREST AT THE ACCOUNT APR, CASH APR
//* CHARGED SEPARATELY, THEN REWARDS POINT ACCRUAL.  THE BRANCH
//* COMPLETION FLAG IS POSTED INTO CYCLCTL AS THE LAST ACT OF THE
//* PROGRAM.
//*
//* THE ROUNDING CONVENTION IS A BUSINESS PARAMETER AND IS SET ON
//* THE SYSIN CARDS BELOW, NOT IN THE PROGRAM.  HALFUP IS THE
//* CONVENTION AGREED WITH FINANCE AND AUDIT - DO NOT CHANGE IT
//* WITHOUT A CHANGE RECORD, THE INTEREST TOTALS ARE REPORTED
//* EXTERNALLY.
//*
//* RETURN CODES
//*   0000 INTEREST AND REWARDS COMPLETE, BRANCH FLAG POSTED
//*   0004 SOME ACCOUNTS SKIPPED (NO APR ON FILE) - SEE SYSOUT
//*   0008 CONTROL CARD ERROR OR AN UNSUPPORTED ROUNDING VALUE,
//*        THE BRANCH FLAG IS POSTED AS FAILED
//*   0012 FATAL, U0512 ABEND, NO FLAG POSTED
//*
//* RESTART
//*   RESTART=STEP010.  INTEREST ROWS FOR THE CYCLE DATE ARE
//*   DELETED BY THE PROGRAM BEFORE IT ACCRUES, SO A RE-RUN DOES
//*   NOT DOUBLE CHARGE.
//****************************************************************
//*
//         JCLLIB ORDER=(CARD.PROD.PROCLIB)
//         SET CYCDATE=20240131
//*
//STEP010  EXEC CARDDB2,RGN=64M,TM=(45,00)
//RUNDB2.SYSTSIN DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(CBCRD05B) PLAN(CARDNITP) -
      LIB('CARD.PROD.LOADLIB') PARM('20240131')
  END
/*
//RUNDB2.CYCLCTL  DD DSN=CARD.PROD.CYCLCTL,DISP=SHR
//RUNDB2.INTRPT   DD SYSOUT=*,
//             DCB=(RECFM=FBA,LRECL=133,BLKSIZE=27930)
//*
//* BUSINESS PARAMETERS FOR THE INTEREST RUN
//*   CYCLE-DATE= CCYYMMDD  THE CYCLE BEING CLOSED
//*   ROUNDING=   HALFUP    HALF UP ON THE LAST DECIMAL
//*   CYCLE-DAYS= NN        DAYS IN THE BILLING CYCLE
//*   GRACE-DAYS= NN        GRACE APPLIED TO NEW PURCHASES
//*
//RUNDB2.SYSIN    DD *
* CARDNITE INTEREST AND REWARDS CONTROL CARDS
CYCLE-DATE=20240131
ROUNDING=  HALFUP
CYCLE-DAYS=31
GRACE-DAYS=25
END
/*
//
