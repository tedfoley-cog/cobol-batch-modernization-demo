//CBBIL03J JOB (CARD,BILL),'MIN PAY AND DUE DATE',CLASS=B,MSGCLASS=X,
//             REGION=0M,TIME=(20,00),NOTIFY=&SYSUID
//*
//* ------------------------------------------------------------------
//* CARDBILL STEP 3 OF 6 - MINIMUM PAYMENT AND PAYMENT DUE DATE
//*
//* PERCENTAGE OF THE CLOSING BALANCE AGAINST THE FLOOR AMOUNT, PLUS
//* ARREARS AND ANY OVER LIMIT EXCESS.  THE DUE DATE IS THE CYCLE
//* DATE PLUS THE GRACE DAYS, ROLLED FORWARD OFF A WEEKEND OR A
//* HOLIDAY CARD.  CARDSVC.ACCOUNT IS UPDATED IN PLACE.
//*
//* THE HOLIDAY CARDS ARE THE FEDERAL CALENDAR FOR THE CYCLE YEAR.
//* THEY ARE MAINTAINED BY THE BILLING TEAM EVERY DECEMBER - A
//* MISSING CARD DOES NOT FAIL THE STEP, IT JUST MEANS STATEMENTS
//* FALL DUE ON A CLOSED DAY.
//* ------------------------------------------------------------------
//*
//JOBLIB   DD DSN=CARD.PROD.LOADLIB,DISP=SHR
//         DD DSN=DSN.V12R1.SDSNLOAD,DISP=SHR
//*
//MINPAY   EXEC PGM=IKJEFT01,DYNAMNBR=40,COND=(4,LT)
//STEPLIB  DD DSN=CARD.PROD.LOADLIB,DISP=SHR
//         DD DSN=DSN.V12R1.SDSNLOAD,DISP=SHR
//STMTWRK  DD DSN=CARD.PROD.BILL.STMTWRK(0),DISP=SHR
//STMTWK2  DD DSN=CARD.PROD.BILL.STMTWK2(+1),
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(CYL,(900,180),RLSE),
//            DCB=(RECFM=VB,LRECL=24208,BLKSIZE=27998)
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN  PROGRAM(CBBIL03) PLAN(CARDBILP) -
       LIB('CARD.PROD.LOADLIB')
  END
/*
//SYSIN    DD *
CYCLE-DATE  20250131
CYCLE-ID    B202501
MIN-PAY-PCT 002.00000
MIN-PAY-FLR 000000025.00
GRACE-DAYS  025
COMMIT-FREQ 001000
HOLIDAY     20250101
HOLIDAY     20250120
HOLIDAY     20250217
HOLIDAY     20250526
HOLIDAY     20250619
HOLIDAY     20250704
HOLIDAY     20250901
HOLIDAY     20251013
HOLIDAY     20251111
HOLIDAY     20251127
HOLIDAY     20251225
/*
