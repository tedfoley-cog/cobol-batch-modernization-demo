//CBREF01J JOB (CARD,REFR),'MERCHANT REFRESH',CLASS=C,MSGCLASS=X,
//             REGION=0M,TIME=(30,00),NOTIFY=&SYSUID
//*
//* ------------------------------------------------------------------
//* CARDREF STEP 1 OF 5 - MERCHANT REFERENCE REFRESH
//*
//* THE ACQUIRER SENDS A FULL MAINTENANCE FEED EVERY SATURDAY NIGHT.
//* IT IS FIXED LENGTH EBCDIC, 200 BYTES, ONE RECORD PER MERCHANT
//* ACTION.  CBREF01 APPLIES IT TO CARDSVC.MERCHANT AND MAINTAINS
//* CHARGEBACK_RATE AND HIGH_RISK_FLG.
//*
//* DELETES ARE LOGICAL - THE STATUS IS SET TO D AND THE ROW STAYS,
//* BECAUSE SETTLEMENT AND CHARGEBACK PROCESSING STILL DEREFERENCE
//* MERCHANT IDS ON TRANSACTIONS THAT ARE YEARS OLD.
//* ------------------------------------------------------------------
//*
//JOBLIB   DD DSN=CARD.PROD.LOADLIB,DISP=SHR
//         DD DSN=DSN.V12R1.SDSNLOAD,DISP=SHR
//*
//* ------------------------------------------------------------------
//* STEP 1 - SORT THE FEED INTO MERCHANT AND SEQUENCE ORDER.  THE
//* ACQUIRER SENDS ACTIONS IN THE ORDER THEY WERE KEYED, SO AN ADD
//* CAN ARRIVE AFTER THE CHANGE THAT AMENDS IT.
//* ------------------------------------------------------------------
//SORTFEED EXEC PGM=SORT,REGION=64M
//SORTIN   DD DSN=CARD.PROD.MERCH.FEED(0),DISP=SHR
//SORTOUT  DD DSN=&&MERCHSRT,DISP=(NEW,PASS),
//            UNIT=SYSDA,SPACE=(CYL,(120,30),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=27800)
//SORTWK01 DD UNIT=SYSDA,SPACE=(CYL,(60,15))
//SORTWK02 DD UNIT=SYSDA,SPACE=(CYL,(60,15))
//SYSOUT   DD SYSOUT=*
//SYSIN    DD *
  SORT FIELDS=(2,15,CH,A,119,9,ZD,A)
  OPTION EQUALS,DYNALLOC=(SYSDA,4)
/*
//*
//* ------------------------------------------------------------------
//* STEP 2 - APPLY THE FEED
//* ------------------------------------------------------------------
//         IF (SORTFEED.RC <= 4) THEN
//LOADMRCH EXEC PGM=IKJEFT01,DYNAMNBR=40
//STEPLIB  DD DSN=CARD.PROD.LOADLIB,DISP=SHR
//         DD DSN=DSN.V12R1.SDSNLOAD,DISP=SHR
//MERCHFD  DD DSN=&&MERCHSRT,DISP=(OLD,DELETE)
//MERCHRPT DD DSN=CARD.PROD.REF.MERCHRPT(+1),
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(CYL,(30,10),RLSE),
//            DCB=(RECFM=FBA,LRECL=133,BLKSIZE=27930)
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN  PROGRAM(CBREF01) PLAN(CARDREFP) -
       LIB('CARD.PROD.LOADLIB')
  END
/*
//REFPARM  DD *
RUN-DATE     20250201
COMMIT-FREQ  001000
HIRISK-CBRT  001.50
REJECT-TOL   00250
*  HIRISK-CBRT IS THE CHARGEBACK PERCENTAGE AT WHICH A MERCHANT IS
*  FLAGGED HIGH RISK REGARDLESS OF WHAT THE ACQUIRER SENT.  RISK
*  RAISED THE THRESHOLD FROM 1.00 IN 2019 AFTER THE TRAVEL MERCHANT
*  REVIEW - CHANGE IT ONLY ON A CHANGE RECORD FROM CARD RISK.
/*
//         ELSE
//NOLOAD   EXEC PGM=IEFBR14
//         ENDIF
//*
//* ------------------------------------------------------------------
//* STEP 3 - PRINT THE MAINTENANCE REPORT.  RUNS EVEN AFTER A FAILURE,
//* THE REJECT LIST IS WHAT THE ACQUIRER IS SENT BACK.
//* ------------------------------------------------------------------
//PRTMRCH  EXEC PGM=IEBGENER,COND=EVEN
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD DSN=CARD.PROD.REF.MERCHRPT(0),DISP=SHR
//SYSUT2   DD SYSOUT=(A,,STD1),DCB=(RECFM=FBA,LRECL=133)
//SYSIN    DD DUMMY
