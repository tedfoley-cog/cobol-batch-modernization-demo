//CBCRD04J JOB (CARD,BATCH,0100),'CARD BATCH SVCS',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//             REGION=0M,TIME=1440,NOTIFY=&SYSUID
//*
//****************************************************************
//* CARDNITE STEP 4 OF 10 - TRANSACTION POSTING ENGINE
//*
//* THE LONGEST RUNNING JOB OF THE CYCLE.  BUILDS TXN-RECORD
//* INCLUDING THE VARIABLE LEG ARRAY, INSERTS CARDSVC.TRANSACTION,
//* UPDATES ACCOUNT BALANCES AND MARKS THE AUTHORIZATION POSTED.
//* COMMITS EVERY WS-COMMIT-FREQUENCY ROWS AND WRITES THE RESTART
//* KEY INTO THE CYCLE CONTROL RECORD AT EACH COMMIT POINT.
//*
//* PARM - CCYYMMDD           NORMAL RUN
//*        CCYYMMDD,RESTART=Y RESUME FROM THE COMMIT POINT HELD IN
//*                           CYCLCTL.  THE PROGRAM SKIPS FORWARD
//*                           TO CC-LAST-KEY BEFORE POSTING AGAIN.
//*
//* RETURN CODES
//*   0000 EVERY ENRICHED RECORD POSTED
//*   0004 SOME RECORDS BYPASSED TO AUTHREJ - WORK THE LISTING
//*   0008 TOO MANY BYPASSES, OR THE RESTART KEY WAS NOT FOUND
//*   0012 FATAL, U0402 SQL OR U0403 CONTROL FAILURE
//*
//* RESTART - READ THIS BEFORE RESUBMITTING
//*   1. DO NOT DELETE OR RECREATE ANY DATA SET.  THE DB2 WORK
//*      COMMITTED BEFORE THE FAILURE IS GOOD AND MUST BE KEPT.
//*   2. CHECK CC-LAST-KEY AND CC-RECS-WRITTEN ON THE CYCLE
//*      CONTROL RECORD FOR THE CYCLE DATE WITH CBCRD98 (LIST
//*      UTILITY) BEFORE RESUBMITTING.
//*   3. RESUBMIT WITH RESTART=STEP010 AND PARM RESTART=Y.
//*   4. NEVER RESUBMIT WITH RESTART=Y AFTER A COLD START OF THE
//*      CYCLE - THE POSTINGS WOULD BE DUPLICATED.  A COLD RE-RUN
//*      MEANS RUNNING CBCRD99J (CYCLE BACKOUT) FIRST.
//****************************************************************
//*
//         JCLLIB ORDER=(CARD.PROD.PROCLIB)
//         SET CYCDATE=20240131
//         SET RSTRT=N
//*
//STEP010  EXEC CARDDB2,RGN=96M,TM=(90,00)
//RUNDB2.SYSTSIN DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(CBCRD04) PLAN(CARDNITP) -
      LIB('CARD.PROD.LOADLIB') PARM('20240131,RESTART=N')
  END
/*
//RUNDB2.AUTHENR  DD DSN=CARD.PROD.AUTHENR(0),DISP=SHR
//RUNDB2.CYCLCTL  DD DSN=CARD.PROD.CYCLCTL,DISP=SHR
//RUNDB2.AUTHREJ  DD DSN=CARD.PROD.POSTREJ(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,
//             SPACE=(CYL,(30,10),RLSE),
//             DCB=(RECFM=FB,LRECL=300,BLKSIZE=27300)
//*
//****************************************************************
//* STEP020 LISTS THE BYPASSED POSTINGS.  IT RUNS WHENEVER THE
//* POSTING STEP ENDED 0 OR 4 - AN EMPTY LISTING IS ITSELF THE
//* EVIDENCE THAT NOTHING WAS BYPASSED.
//****************************************************************
//*
//         IF (STEP010.RUNDB2.RC <= 4) THEN
//STEP020  EXEC PGM=IEBGENER
//SYSUT1   DD DSN=CARD.PROD.POSTREJ(+1),DISP=SHR
//SYSUT2   DD SYSOUT=*,
//             DCB=(RECFM=FBA,LRECL=133,BLKSIZE=27930)
//SYSIN    DD *
  GENERATE MAXFLDS=2
  RECORD FIELD=(132,1,,2)
/*
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//         ELSE
//STEP025  EXEC PGM=IEFBR14
//*  POSTING FAILED - THE OPERATOR IS PAGED BY THE SCHEDULER AND
//*  THE RESTART NOTES ABOVE APPLY.  NOTHING IS CLEANED UP HERE
//*  ON PURPOSE.
//         ENDIF
//
