//CBBIL01J JOB (CARD,BILL),'CYCLE SELECTION',CLASS=B,MSGCLASS=X,
//             REGION=0M,TIME=(20,00),NOTIFY=&SYSUID
//*
//* ------------------------------------------------------------------
//* CARDBILL STEP 1 OF 6 - MONTHLY BILLING CYCLE SELECTION
//*
//* SELECTS THE ACCOUNTS WHOSE CYCLE DAY MATCHES THE RUN, SNAPSHOTS
//* THEM ONTO THE BILLING WORK FILE AND OPENS THE CYCLE IN CYCLCTL.
//*
//* THE CYCLE DAY AND CYCLE DATE COME FROM SYSIN.  THE SCHEDULER
//* SUBSTITUTES THEM - DO NOT HARD CODE THEM IN A RERUN WITHOUT
//* CHECKING WHICH CYCLE IS OPEN IN CYCLCTL FIRST.
//*
//* RESTART - CBBIL01 IS RESTARTABLE FROM THE TOP.  IT FINDS THE OPEN
//* CYCLE CONTROL RECORD, BUMPS THE RESTART COUNT AND REPOSITIONS
//* AFTER THE LAST COMMITTED ACCOUNT, SO THE WORK FILE IS OPENED MOD.
//* ------------------------------------------------------------------
//*
//JOBLIB   DD DSN=CARD.PROD.LOADLIB,DISP=SHR
//         DD DSN=DSN.V12R1.SDSNLOAD,DISP=SHR
//*
//* ------------------------------------------------------------------
//* STEP 1 - SELECT THE CYCLE
//* ------------------------------------------------------------------
//SELECT   EXEC PGM=IKJEFT01,DYNAMNBR=40,COND=(4,LT)
//STEPLIB  DD DSN=CARD.PROD.LOADLIB,DISP=SHR
//         DD DSN=DSN.V12R1.SDSNLOAD,DISP=SHR
//CYCLCTL  DD DSN=CARD.PROD.CYCLCTL,DISP=SHR
//BILLWRK  DD DSN=CARD.PROD.BILL.BILLWRK(+1),
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(CYL,(300,60),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=27800)
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN  PROGRAM(CBBIL01) PLAN(CARDBILP) -
       LIB('CARD.PROD.LOADLIB')
  END
/*
//SYSIN    DD *
CYCLE-DATE  20250131
CYCLE-DAY   31
CYCLE-ID    B202501
COMMIT-FREQ 001000
MIN-BAL     000000000.01
BILL-CLOSED N
*  BILL-CLOSED Y IS ONLY SET FOR THE ANNUAL CLEAN UP CYCLE WHEN
*  CLOSED ACCOUNTS WITH A RESIDUAL BALANCE MUST BE STATEMENTED.
/*
//*
//* ------------------------------------------------------------------
//* STEP 2 - KEEP A COPY OF THE SELECTION FOR THE RECONCILIATION STEP
//* IN CBBIL06J.  ONLY RUN WHEN THE SELECTION ITSELF WAS CLEAN.
//* ------------------------------------------------------------------
//         IF (SELECT.RC = 0) THEN
//COPYWRK  EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD DSN=CARD.PROD.BILL.BILLWRK(+1),DISP=SHR
//SYSUT2   DD DSN=CARD.PROD.BILL.BILLSNAP(+1),
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(CYL,(300,60),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=27800)
//SYSIN    DD DUMMY
//         ELSE
//NOCOPY   EXEC PGM=IEFBR14
//         ENDIF
//*
//* ------------------------------------------------------------------
//* STEP 3 - SELECTION SUMMARY.  RUNS WHATEVER HAPPENED SO THE
//* OPERATOR ALWAYS GETS THE CYCLE CONTROL PRINT.
//* ------------------------------------------------------------------
//PRTCTL   EXEC PGM=IDCAMS,COND=EVEN
//SYSPRINT DD SYSOUT=*
//CYCLIN   DD DSN=CARD.PROD.CYCLCTL,DISP=SHR
//SYSIN    DD *
  PRINT INFILE(CYCLIN) CHARACTER
/*
