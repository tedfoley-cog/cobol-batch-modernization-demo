//CBCRD07J JOB (CARD,BATCH,0100),'CARD BATCH SVCS',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//             REGION=0M,TIME=1440,NOTIFY=&SYSUID
//*
//****************************************************************
//* CARDNITE STEP 7 OF 10 - GENERAL LEDGER FEED
//*
//* AGGREGATES THE CYCLE'S TRANSACTIONS BY TRANSACTION TYPE,
//* PRODUCT AND CURRENCY AND WRITES BALANCED DOUBLE ENTRY ROWS
//* INTO CARDSVC.GL_POSTING.  THE STEP PROVES TOTAL DEBITS EQUAL
//* TOTAL CREDITS BEFORE IT COMMITS.  IF THE FEED DOES NOT
//* BALANCE THE WHOLE UNIT OF WORK IS ROLLED BACK AND THE STEP
//* ABENDS U0704 - NO HALF LEDGER IS EVER LEFT BEHIND.
//*
//* THE GL ACCOUNT AND COST CENTRE MAPPING IS OWNED BY FINANCE
//* AND IS SUPPLIED ON THE SYSIN CARDS BELOW.  IT IS DELIBERATELY
//* NOT IN THE PROGRAM.  CARD FORMAT
//*
//*   COL 01-04  MAP
//*   COL 05-08  TRANSACTION TYPE CODE
//*   COL 10-13  PRODUCT CODE, **** MATCHES ANY PRODUCT
//*   COL 15-24  DEBIT GL ACCOUNT
//*   COL 26-35  CREDIT GL ACCOUNT
//*   COL 37-42  COST CENTRE
//*
//* RETURN CODES
//*   0000 LEDGER FEED WRITTEN AND BALANCED
//*   0004 SOME GROUPS TOOK THE SUSPENSE ACCOUNT - FINANCE MUST
//*        ADD A MAPPING CARD BEFORE THE NEXT CYCLE
//*   0008 NO TRANSACTIONS FOUND TO POST
//*   0012 FATAL, U0701 CARD ERROR, U0704 OUT OF BALANCE,
//*        U0703 SQL FAILURE
//*
//* RESTART
//*   RESTART=STEP010.  THE PROGRAM ONLY SELECTS TRANSACTIONS
//*   WITH GL_POSTED_FLG = 'N', SO A RE-RUN AFTER A ROLLBACK
//*   PICKS UP EXACTLY WHAT WAS NOT POSTED.
//****************************************************************
//*
//         JCLLIB ORDER=(CARD.PROD.PROCLIB)
//         SET CYCDATE=20240131
//*
//STEP010  EXEC CARDDB2,RGN=64M,TM=(45,00)
//RUNDB2.SYSTSIN DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(CBCRD07) PLAN(CARDNITP) -
      LIB('CARD.PROD.LOADLIB') PARM('20240131')
  END
/*
//RUNDB2.CYCLCTL  DD DSN=CARD.PROD.CYCLCTL,DISP=SHR
//RUNDB2.GLRPT    DD SYSOUT=*,
//             DCB=(RECFM=FBA,LRECL=133,BLKSIZE=27930)
//RUNDB2.SYSIN    DD *
* CARDNITE GENERAL LEDGER MAPPING - OWNED BY FINANCE, GL/CC TABLE
* CHANGE RECORD FIN-2023-114
BATCH=GL240131CARD
SUSPENSE=1999009999
MAP PURC **** 1201001000 4101001000 CC1100
MAP CASH **** 1201002000 4101002000 CC1100
MAP REFN **** 4101001000 1201001000 CC1100
MAP FEEA GOLD 1301001000 4201001000 CC1200
MAP FEEA CLAS 1301001000 4201002000 CC1200
MAP FEEL **** 1301002000 4201003000 CC1200
MAP FEEO **** 1301003000 4201004000 CC1200
MAP FEEC **** 1301004000 4201005000 CC1200
MAP FEEF **** 1301005000 4201006000 CC1200
MAP INTR **** 1401001000 4301001000 CC1300
MAP INTC **** 1401002000 4301002000 CC1300
MAP RWDA **** 5101001000 2201001000 CC1400
END
/*
//
