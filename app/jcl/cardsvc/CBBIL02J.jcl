//CBBIL02J JOB (CARD,BILL),'STATEMENT ASSEMBLY',CLASS=B,MSGCLASS=X,
//             REGION=0M,TIME=(45,00),NOTIFY=&SYSUID
//*
//* ------------------------------------------------------------------
//* CARDBILL STEP 2 OF 6 - STATEMENT ASSEMBLY
//*
//* CURSOR OVER CARDSVC.TRANSACTION FOR THE CYCLE PERIOD, ONE
//* STMT-RECORD PER ACCOUNT WITH THE OCCURS DEPENDING ON LINE ARRAY
//* POPULATED AND THE CATEGORY BUCKETS TOTALLED.
//*
//* THE STATEMENT WORK FILE IS VARIABLE LENGTH BECAUSE THE LINE ARRAY
//* IS.  LRECL 24208 IS THE 24204 BYTE MAXIMUM RECORD PLUS THE RDW.
//* IF MAX-LINES ON THE SYSIN CARD IS RAISED THE LRECL MUST BE RAISED
//* WITH IT - CBBIL02 WILL SPILL THE ACCOUNT TO THE OVERFLOW REPORT
//* RATHER THAN WRITE A SHORT RECORD.
//* ------------------------------------------------------------------
//*
//JOBLIB   DD DSN=CARD.PROD.LOADLIB,DISP=SHR
//         DD DSN=DSN.V12R1.SDSNLOAD,DISP=SHR
//*
//* ------------------------------------------------------------------
//* STEP 1 - SORT THE WORK FILE INTO ACCOUNT ORDER.  CBBIL01 WRITES
//* IN SELECTION ORDER, WHICH ON A RESTART RUN IS NOT ACCOUNT ORDER.
//* ------------------------------------------------------------------
//SORTWRK  EXEC PGM=SORT,REGION=64M
//SORTIN   DD DSN=CARD.PROD.BILL.BILLWRK(0),DISP=SHR
//SORTOUT  DD DSN=&&BILLSRT,DISP=(NEW,PASS),
//            UNIT=SYSDA,SPACE=(CYL,(300,60),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=27800)
//SORTWK01 DD UNIT=SYSDA,SPACE=(CYL,(150,30))
//SORTWK02 DD UNIT=SYSDA,SPACE=(CYL,(150,30))
//SORTWK03 DD UNIT=SYSDA,SPACE=(CYL,(150,30))
//SYSOUT   DD SYSOUT=*
//SYSIN    DD *
  SORT FIELDS=(1,11,ZD,A)
  OPTION EQUALS,DYNALLOC=(SYSDA,6)
/*
//*
//* ------------------------------------------------------------------
//* STEP 2 - ASSEMBLE THE STATEMENTS
//* ------------------------------------------------------------------
//         IF (SORTWRK.RC <= 4) THEN
//ASSEMBLE EXEC PGM=IKJEFT01,DYNAMNBR=40
//STEPLIB  DD DSN=CARD.PROD.LOADLIB,DISP=SHR
//         DD DSN=DSN.V12R1.SDSNLOAD,DISP=SHR
//BILLWRK  DD DSN=&&BILLSRT,DISP=(OLD,DELETE)
//STMTWRK  DD DSN=CARD.PROD.BILL.STMTWRK(+1),
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(CYL,(900,180),RLSE),
//            DCB=(RECFM=VB,LRECL=24208,BLKSIZE=27998)
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN  PROGRAM(CBBIL02) PLAN(CARDBILP) -
       LIB('CARD.PROD.LOADLIB')
  END
/*
//SYSIN    DD *
CYCLE-DATE  20250131
CYCLE-ID    B202501
COMMIT-FREQ 000500
MAX-LINES   000400
BAL-TOL     000000000.05
/*
//         ELSE
//NOASSEM  EXEC PGM=IEFBR14
//         ENDIF
