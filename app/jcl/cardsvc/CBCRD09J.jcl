//CBCRD09J JOB (CARD,BATCH,0100),'CARD BATCH SVCS',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//             REGION=0M,TIME=1440,NOTIFY=&SYSUID
//*
//****************************************************************
//* CARDNITE STEP 9 OF 10 - VSAM BACKUP AND AUTHLOG RESET
//*
//*   STEP010 EXPORT THE CYCLE CONTROL CLUSTER (CIMODE)
//*   STEP020 REPRO CARDXREF, CYCLCTL AND AUTHLOG TO GDG
//*   STEP030 DELETE AND REDEFINE AUTHLOG FOR THE NEW DAY
//*   STEP040 CBCRD09 VERIFIES THE BACKUPS AND THE RESET
//*
//* THE BACKUPS ARE TAKEN BEFORE THE AUTHLOG IS SCRATCHED, AND
//* THE VERIFY STEP RUNS AFTER THE REDEFINE.  THAT ORDER MATTERS
//* - IN 2003 THE REDEFINE RAN FIRST AND A NIGHT OF
//* AUTHORIZATIONS WAS LOST.  DO NOT REORDER THESE STEPS.
//*
//* RETURN CODES
//*   0000 ALL THREE BACKUPS VERIFIED AND AUTHLOG IS EMPTY
//*   0004 A BACKUP IS SMALLER THAN THE PREVIOUS GENERATION
//*   0012 FATAL - U0901 EMPTY CARDXREF BACKUP,
//*        U0902 EMPTY AUTHLOG BACKUP, U0903 AUTHLOG NOT EMPTY
//*        AFTER THE REDEFINE
//*
//* RESTART
//*   RESTART=STEP010 IS SAFE ONLY BEFORE STEP030 HAS RUN.  IF
//*   THE JOB FAILED IN OR AFTER STEP030, RESTART=STEP040 AND
//*   CALL THE STORAGE ADMINISTRATOR BEFORE RE-RUNNING ANY
//*   IDCAMS STEP - THE LIVE AUTHLOG HAS ALREADY BEEN REPLACED.
//****************************************************************
//*
//         SET CYCDATE=20240131
//*
//STEP010  EXEC PGM=IDCAMS,REGION=16M
//SYSPRINT DD SYSOUT=*
//EXPCTL   DD DSN=CARD.PROD.EXPORT.CYCLCTL(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,
//             SPACE=(CYL,(5,2),RLSE)
//SYSIN    DD *
 /* PORTABLE COPY OF THE CONTROL CLUSTER, TAKEN BEFORE THE     */
 /* CYCLE IS CLOSED SO IT CAN BE IMPORTED INTO THE TEST LPAR.  */
 EXPORT CARD.PROD.CYCLCTL                -
        OUTFILE(EXPCTL)                  -
        TEMPORARY                        -
        CIMODE
/*
//SYSUDUMP DD SYSOUT=D
//*
//         IF (STEP010.RC = 0) THEN
//STEP020  EXEC PGM=IDCAMS,REGION=16M
//SYSPRINT DD SYSOUT=*
//INXREF   DD DSN=CARD.PROD.CARDXREF,DISP=SHR
//INCTL    DD DSN=CARD.PROD.CYCLCTL,DISP=SHR
//INAUTH   DD DSN=CARD.PROD.AUTHLOG,DISP=SHR
//BKPXREF  DD DSN=CARD.PROD.BKP.CARDXREF(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,
//             SPACE=(CYL,(200,40),RLSE),
//             DCB=(RECFM=FB,LRECL=128,BLKSIZE=27264)
//BKPCTL   DD DSN=CARD.PROD.BKP.CYCLCTL(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,
//             SPACE=(TRK,(15,5),RLSE),
//             DCB=(RECFM=FB,LRECL=256,BLKSIZE=27136)
//BKPAUTH  DD DSN=CARD.PROD.BKP.AUTHLOG(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,
//             SPACE=(CYL,(900,150),RLSE),
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=27000)
//SYSIN    DD *
 REPRO INFILE(INXREF)  OUTFILE(BKPXREF)
 IF LASTCC > 0 THEN CANCEL
 REPRO INFILE(INCTL)   OUTFILE(BKPCTL)
 IF LASTCC > 0 THEN CANCEL
 REPRO INFILE(INAUTH)  OUTFILE(BKPAUTH)
 IF LASTCC > 0 THEN CANCEL
/*
//SYSUDUMP DD SYSOUT=D
//         ENDIF
//*
//****************************************************************
//* THE AUTHLOG IS AN ESDS AND IS NEVER REUSED IN PLACE - IT IS
//* SCRATCHED AND REDEFINED SO THE NEW DAY STARTS AT RBA ZERO.
//* THE DEFINE MUST MATCH APP/JCL/VSAM/DEFCARD.JCL EXACTLY.
//****************************************************************
//*
//         IF (STEP020.RC = 0) THEN
//STEP030  EXEC PGM=IDCAMS,REGION=16M
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
 DELETE CARD.PROD.AUTHLOG CLUSTER PURGE
 IF LASTCC > 8 THEN CANCEL
 SET MAXCC = 0
 DEFINE CLUSTER                          -
        (NAME(CARD.PROD.AUTHLOG)         -
         NONINDEXED                      -
         RECORDSIZE(200 200)             -
         CYLINDERS(900 150)              -
         SHAREOPTIONS(2 3)               -
         VOLUMES(CARD02 CARD03)          -
         SPEED)                          -
        DATA                             -
        (NAME(CARD.PROD.AUTHLOG.DATA)    -
         CISZ(8192))
 IF LASTCC > 0 THEN CANCEL
/*
//SYSUDUMP DD SYSOUT=D
//         ENDIF
//*
//         IF (STEP030.RC = 0) THEN
//STEP040  EXEC PGM=CBCRD09,REGION=32M,TIME=(20,00),
//             PARM='&CYCDATE'
//STEPLIB  DD DSN=CARD.PROD.FIXLIB,DISP=SHR
//         DD DSN=CARD.PROD.LOADLIB,DISP=SHR
//         DD DSN=CARD.PROD.COMMON.LOADLIB,DISP=SHR
//BKPXREF  DD DSN=CARD.PROD.BKP.CARDXREF(+1),DISP=SHR
//BKPCTL   DD DSN=CARD.PROD.BKP.CYCLCTL(+1),DISP=SHR
//BKPAUTH  DD DSN=CARD.PROD.BKP.AUTHLOG(+1),DISP=SHR
//AUTHLOG  DD DSN=CARD.PROD.AUTHLOG,DISP=SHR
//CYCLCTL  DD DSN=CARD.PROD.CYCLCTL,DISP=SHR
//BKPREG   DD SYSOUT=*,
//             DCB=(RECFM=FBA,LRECL=133,BLKSIZE=27930)
//SYSOUT   DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//CEEDUMP  DD SYSOUT=*
//         ENDIF
//
