//CBCRD02J JOB (CARD,BATCH,0100),'CARD BATCH SVCS',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//             REGION=0M,TIME=1440,NOTIFY=&SYSUID
//*
//****************************************************************
//* CARDNITE STEP 2 OF 10 - EDIT AND REJECT SPLIT
//*
//* EVERY EXTRACT RECORD IS EDITED.  THE 60 BYTE AUTH-DETAIL AREA
//* IS DECODED ACCORDING TO AUTH-TYPE AND THE OVERLAY FIELDS ARE
//* RANGE CHECKED.  CLEAN RECORDS GO TO AUTHCLN, THE REST TO
//* AUTHREJ WITH A REASON CODE.
//*
//* PARM - CCYYMMDD,NN  WHERE NN IS THE REJECT TOLERANCE AS A
//*        WHOLE PERCENT OF RECORDS READ.  THE STANDING VALUE IS
//*        02.  RAISE IT ONLY WITH THE DUTY MANAGER'S AGREEMENT -
//*        IT IS THE ONLY THING STANDING BETWEEN A BAD FEED AND
//*        THE POSTING ENGINE.
//*
//* RETURN CODES
//*   0000 NO REJECTS
//*   0004 REJECTS WITHIN TOLERANCE - WORK THE REJECT REPORT
//*   0008 REJECTS OVER TOLERANCE - CYCLE HELD, DO NOT RELEASE
//*        CBCRD03J UNTIL THE FEED HAS BEEN INVESTIGATED
//*   0012 FATAL, U0202 ABEND
//*
//* RESTART
//*   RESTART=STEP010.  BOTH OUTPUT GENERATIONS ARE RECREATED,
//*   NOTHING HAS TO BE SCRATCHED BY HAND.
//****************************************************************
//*
//         SET CYCDATE=20240131
//         SET TOLER=02
//*
//STEP010  EXEC PGM=CBCRD02,REGION=32M,TIME=(30,00),
//             PARM='&CYCDATE,&TOLER'
//STEPLIB  DD DSN=CARD.PROD.FIXLIB,DISP=SHR
//         DD DSN=CARD.PROD.LOADLIB,DISP=SHR
//         DD DSN=CARD.PROD.COMMON.LOADLIB,DISP=SHR
//AUTHEXTR DD DSN=CARD.PROD.AUTHEXTR(0),DISP=SHR
//CYCLCTL  DD DSN=CARD.PROD.CYCLCTL,DISP=SHR
//AUTHCLN  DD DSN=CARD.PROD.AUTHCLN(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,
//             SPACE=(CYL,(300,60),RLSE),
//             DCB=(RECFM=FB,LRECL=300,BLKSIZE=27300)
//AUTHREJ  DD DSN=CARD.PROD.AUTHREJ(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,
//             SPACE=(CYL,(20,5),RLSE),
//             DCB=(RECFM=FB,LRECL=300,BLKSIZE=27300)
//SYSOUT   DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//CEEDUMP  DD SYSOUT=*
//*
//****************************************************************
//* STEP020 PRINTS THE REJECT FILE FOR THE CONTROL CLERKS.  IT IS
//* RUN WHENEVER THERE WERE REJECTS AT ALL, INCLUDING THE OVER
//* TOLERANCE CASE - THAT IS EXACTLY WHEN THEY NEED THE LISTING.
//****************************************************************
//*
//         IF (STEP010.RC = 4 OR STEP010.RC = 8) THEN
//STEP020  EXEC PGM=IEBGENER
//SYSUT1   DD DSN=CARD.PROD.AUTHREJ(+1),DISP=SHR
//SYSUT2   DD SYSOUT=*,
//             DCB=(RECFM=FBA,LRECL=133,BLKSIZE=27930)
//SYSIN    DD *
  GENERATE MAXFLDS=2
  RECORD FIELD=(132,1,,2)
/*
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//         ENDIF
//
