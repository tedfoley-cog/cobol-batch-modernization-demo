//CBBIL06J JOB (CARD,BILL),'CYCLE CLOSE',CLASS=B,MSGCLASS=X,
//             REGION=0M,TIME=(30,00),NOTIFY=&SYSUID
//*
//* ------------------------------------------------------------------
//* CARDBILL STEP 6 OF 6 - RECONCILIATION AND CYCLE CLOSE
//*
//* PROVES THE CYCLE - STATEMENT COUNT AGAINST THE SELECTION SNAPSHOT,
//* TOTAL BILLED AGAINST THE SUM OF THE STATEMENT ROWS, AND EVERY
//* CLOSING BALANCE AGAINST CARDSVC.ACCOUNT.  THE CYCLE CONTROL
//* RECORD IS ONLY MARKED COMPLETE WHEN THE PROOF BALANCES.
//*
//* RETURN CODE 4 MEANS THE PROOF PASSED WITH EXCEPTIONS LISTED ON
//* RECONRPT.  THE CYCLE IS STILL CLOSED.  RETURN CODE 8 MEANS THE
//* PROOF FAILED - THE CYCLE STAYS OPEN AND NOTHING DOWNSTREAM MAY
//* RUN UNTIL BILLING CONTROL HAS SIGNED OFF THE DIFFERENCE.
//* ------------------------------------------------------------------
//*
//JOBLIB   DD DSN=CARD.PROD.LOADLIB,DISP=SHR
//         DD DSN=DSN.V12R1.SDSNLOAD,DISP=SHR
//*
//RECON    EXEC PGM=IKJEFT01,DYNAMNBR=40,COND=(4,LT)
//STEPLIB  DD DSN=CARD.PROD.LOADLIB,DISP=SHR
//         DD DSN=DSN.V12R1.SDSNLOAD,DISP=SHR
//BILLWRK  DD DSN=CARD.PROD.BILL.BILLSNAP(0),DISP=SHR
//CYCLCTL  DD DSN=CARD.PROD.CYCLCTL,DISP=SHR
//RECONRPT DD DSN=CARD.PROD.BILL.RECONRPT(+1),
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(CYL,(60,15),RLSE),
//            DCB=(RECFM=FBA,LRECL=133,BLKSIZE=27930)
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN  PROGRAM(CBBIL06) PLAN(CARDBILP) -
       LIB('CARD.PROD.LOADLIB')
  END
/*
//SYSIN    DD *
CYCLE-DATE  20250131
CYCLE-ID    B202501
BAL-TOL     000000000.05
MAX-EXCEPT  000200
/*
//*
//* ------------------------------------------------------------------
//* STEP 2 - PRINT THE RECONCILIATION REPORT.  ALWAYS RUNS, THE
//* REPORT IS THE EVIDENCE FOR BOTH OUTCOMES.
//* ------------------------------------------------------------------
//PRTRECON EXEC PGM=IEBGENER,COND=EVEN
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD DSN=CARD.PROD.BILL.RECONRPT(0),DISP=SHR
//SYSUT2   DD SYSOUT=(A,,STD1),DCB=(RECFM=FBA,LRECL=133)
//SYSIN    DD DUMMY
//*
//* ------------------------------------------------------------------
//* STEP 3 - NOTIFY BILLING CONTROL WHEN THE PROOF FAILED.
//* ------------------------------------------------------------------
//         IF (RECON.RC > 4) THEN
//NOTIFY   EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD *
CARDBILL CYCLE B202501 DID NOT BALANCE.  THE CYCLE CONTROL RECORD
HAS BEEN LEFT OPEN.  SEE CARD.PROD.BILL.RECONRPT FOR THE EXCEPTION
LIST AND CALL BILLING CONTROL BEFORE RESTARTING ANY CARDBILL JOB.
/*
//SYSUT2   DD SYSOUT=(A,,NOTIFY),DCB=(RECFM=FB,LRECL=80)
//SYSIN    DD DUMMY
//         ENDIF
