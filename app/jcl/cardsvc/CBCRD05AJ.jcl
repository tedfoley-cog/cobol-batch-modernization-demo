//CBCRD05A JOB (CARD,BATCH,0100),'CARD BATCH SVCS',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//             REGION=0M,TIME=1440,NOTIFY=&SYSUID
//*
//****************************************************************
//* CARDNITE STEP 5A OF 10 - FEE ASSESSMENT BRANCH
//*
//* SUBMITTED IN PARALLEL WITH CBCRD05BJ AFTER CBCRD04J ENDS.
//* BOTH BRANCHES MUST FINISH BEFORE CBCRD06J IS RELEASED.  THE
//* LAST THING THIS JOB DOES IS POST ITS COMPLETION FLAG INTO THE
//* CYCLE CONTROL RECORD - CBCRD06W IN THE JOIN READS IT.
//*
//* CBCRD05A DETERMINES THE APPLICABLE FEE TYPES FROM
//* CARDSVC.FEE_SCHEDULE AND DISPATCHES EACH ONE THROUGH THE
//* BATCH DISPATCHER, SO IT IS LINK EDITED WITH DYNAM AND THE
//* STEPLIB MUST RESOLVE THE HANDLER LOAD MODULES AT RUN TIME.
//* THE FEE HANDLER LIBRARY IS CONCATENATED BELOW FOR THAT
//* REASON - A MISSING HANDLER SHOWS UP AS A ROUTE FAILURE, NOT
//* AS A LINK EDIT ERROR.
//*
//* RETURN CODES
//*   0000 ALL FEES ASSESSED, BRANCH FLAG POSTED
//*   0004 SOME FEES SKIPPED OR A HANDLER RETURNED A WARNING
//*   0008 A FEE TYPE COULD NOT BE ROUTED - THE FLAG IS POSTED AS
//*        FAILED AND CBCRD06W WILL HOLD THE JOIN
//*   0012 FATAL, U0502 ABEND, NO FLAG POSTED AT ALL
//*
//* RESTART
//*   RESTART=STEP010.  THE PROGRAM DELETES ITS OWN FEE ROWS FOR
//*   THE CYCLE DATE BEFORE IT STARTS, SO A RE-RUN IS CLEAN.
//****************************************************************
//*
//         JCLLIB ORDER=(CARD.PROD.PROCLIB)
//         SET CYCDATE=20240131
//*
//STEP010  EXEC CARDDB2,RGN=64M,TM=(45,00)
//RUNDB2.STEPLIB  DD DSN=CARD.PROD.FIXLIB,DISP=SHR
//         DD DSN=CARD.PROD.LOADLIB,DISP=SHR
//         DD DSN=CARD.PROD.FEELIB,DISP=SHR
//         DD DSN=CARD.PROD.COMMON.LOADLIB,DISP=SHR
//         DD DSN=DSN910.SDSNLOAD,DISP=SHR
//         DD DSN=DSN910.SDSNEXIT,DISP=SHR
//         DD DSN=DSN910.RUNLIB.LOAD,DISP=SHR
//RUNDB2.SYSTSIN DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(CBCRD05A) PLAN(CARDNITP) -
      LIB('CARD.PROD.LOADLIB') PARM('20240131')
  END
/*
//RUNDB2.CYCLCTL  DD DSN=CARD.PROD.CYCLCTL,DISP=SHR
//RUNDB2.FEEAUDIT DD DSN=CARD.PROD.FEEAUDIT(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,
//             SPACE=(CYL,(60,15),RLSE),
//             DCB=(RECFM=FB,LRECL=133,BLKSIZE=27930)
//*
//****************************************************************
//* THE FEE AUDIT TRAIL IS PRINTED EVERY NIGHT WHATEVER HAPPENED
//* - PRODUCT CONTROL RECONCILE FEE INCOME AGAINST IT.
//****************************************************************
//*
//         IF (STEP010.RUNDB2.RC <= 8) THEN
//STEP020  EXEC PGM=IEBGENER
//SYSUT1   DD DSN=CARD.PROD.FEEAUDIT(+1),DISP=SHR
//SYSUT2   DD SYSOUT=*,
//             DCB=(RECFM=FBA,LRECL=133,BLKSIZE=27930)
//SYSIN    DD DUMMY
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//         ENDIF
//
