//CBBIL05J JOB (CARD,BILL),'STATEMENT PERSIST',CLASS=B,MSGCLASS=X,
//             REGION=0M,TIME=(45,00),NOTIFY=&SYSUID
//*
//* ------------------------------------------------------------------
//* CARDBILL STEP 5 OF 6 - STATEMENT PERSISTENCE AND ARCHIVE
//*
//* INSERTS ONE ROW PER STATEMENT INTO CARDSVC.STATEMENT AND WRITES
//* THE RENDERED IMAGE TO THE SEVEN YEAR ARCHIVE.
//*
//* THE ARCHIVE IS RECFM=VB.  EACH RECORD IS THE FIXED PART OF
//* STMT-RECORD PLUS STMT-LINE-CNT OCCURRENCES OF THE LINE ENTRY,
//* SO THE WRITTEN LENGTH VARIES PER ACCOUNT.  LRECL 24208 IS THE
//* 24204 BYTE MAXIMUM PLUS THE RDW - DO NOT SHORTEN IT TO THE
//* AVERAGE RECORD SIZE, LONG STATEMENTS WOULD BE TRUNCATED.
//*
//* CBBIL05 IS IDEMPOTENT.  A RERUN AFTER A PART COMPLETED RUN
//* DETECTS THE EXISTING STATEMENT ROW ON -803 AND REWRITES IT
//* RATHER THAN FAILING, SO THE ARCHIVE IS ALLOCATED MOD.
//* ------------------------------------------------------------------
//*
//JOBLIB   DD DSN=CARD.PROD.LOADLIB,DISP=SHR
//         DD DSN=DSN.V12R1.SDSNLOAD,DISP=SHR
//*
//PERSIST  EXEC PGM=IKJEFT01,DYNAMNBR=40,COND=(4,LT)
//STEPLIB  DD DSN=CARD.PROD.LOADLIB,DISP=SHR
//         DD DSN=DSN.V12R1.SDSNLOAD,DISP=SHR
//STMTWK3  DD DSN=CARD.PROD.BILL.STMTWK3(0),DISP=SHR
//STMTARC  DD DSN=CARD.PROD.BILL.STMTARC(+1),
//            DISP=(MOD,CATLG,CATLG),
//            UNIT=SYSDA,SPACE=(CYL,(1200,240),RLSE),
//            DCB=(RECFM=VB,LRECL=24208,BLKSIZE=27998),
//            RETPD=2555
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN  PROGRAM(CBBIL05) PLAN(CARDBILP) -
       LIB('CARD.PROD.LOADLIB')
  END
/*
//SYSIN    DD *
CYCLE-DATE  20250131
CYCLE-ID    B202501
COMMIT-FREQ 000500
ARCHIVE     Y
*  ARCHIVE N SUPPRESSES THE ARCHIVE WRITE ON A DB2 ONLY RERUN AFTER
*  THE ARCHIVE GENERATION HAS ALREADY BEEN CUT AND MIGRATED.
/*
//*
//* ------------------------------------------------------------------
//* STEP 2 - MIGRATE THE ARCHIVE GENERATION TO ML2.  SKIPPED WHEN
//* THE PERSIST STEP DID NOT COMPLETE CLEANLY.
//* ------------------------------------------------------------------
//         IF (PERSIST.RC = 0) THEN
//MIGRATE  EXEC PGM=IKJEFT01,DYNAMNBR=20
//SYSTSPRT DD SYSOUT=*
//SYSTSIN  DD *
  HMIGRATE 'CARD.PROD.BILL.STMTARC.G*V00' ML2
/*
//         ELSE
//NOMIGR   EXEC PGM=IEFBR14
//         ENDIF
