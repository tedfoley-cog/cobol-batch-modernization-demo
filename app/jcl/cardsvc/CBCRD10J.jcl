//CBCRD10J JOB (CARD,BATCH,0100),'CARD BATCH SVCS',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//             REGION=0M,TIME=1440,NOTIFY=&SYSUID
//*
//****************************************************************
//* CARDNITE STEP 10 OF 10 - CYCLE CLOSE AND CONTROL REPORT
//*
//* MARKS THE CYCLE CONTROL RECORD COMPLETE AND PRINTS THE
//* CONTROL REPORT THAT OPERATIONS FILE EVERY MORNING - RECORDS
//* READ, WRITTEN AND REJECTED AT EACH STAGE, THE AUTHORIZATION
//* HASH TOTAL, LEDGER DEBIT AND CREDIT TOTALS, ELAPSED TIMES AND
//* THE EXCEPTION SUMMARY.
//*
//* THE RETURN CODE OF STEP010 DECIDES WHETHER THE ONLINE REGION
//* IS REOPENED.  THE REGION START JOB CARDONLJ IS RELEASED BY
//* THE SCHEDULER ONLY ON A 0 OR A 4.  ON AN 8 THE REGION STAYS
//* DOWN AND THE DUTY MANAGER IS PAGED - DO NOT START IT BY HAND
//* TO GET THE BRANCHES OPEN, THE POSTING IS NOT PROVEN.
//*
//* RETURN CODES
//*   0000 CYCLE CLEAN, REGION MAY REOPEN
//*   0004 CYCLE COMPLETE WITH EXCEPTIONS, REGION MAY REOPEN,
//*        EXCEPTION REPORT MUST BE ACTIONED THE SAME MORNING
//*   0008 A STAGE DID NOT RUN, TRANSACTIONS ARE NOT IN THE
//*        LEDGER, OR THE LEDGER DOES NOT BALANCE - REGION HELD
//*   0012 FATAL, U1002 FILE FAILURE, U1003 SQL FAILURE
//*
//* RESTART
//*   RESTART=STEP010.  RE-RUNNABLE AS OFTEN AS NEEDED, IT ONLY
//*   REPORTS AND REWRITES THE CONTROL RECORD.
//****************************************************************
//*
//         JCLLIB ORDER=(CARD.PROD.PROCLIB)
//         SET CYCDATE=20240131
//*
//STEP010  EXEC CARDDB2,RGN=32M,TM=(20,00)
//RUNDB2.SYSTSIN DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(CBCRD10) PLAN(CARDNITP) -
      LIB('CARD.PROD.LOADLIB') PARM('20240131')
  END
/*
//RUNDB2.CYCLCTL  DD DSN=CARD.PROD.CYCLCTL,DISP=SHR
//RUNDB2.STGSTAT  DD DSN=CARD.PROD.STGSTAT,DISP=SHR
//RUNDB2.CTLRPT   DD SYSOUT=*,
//             DCB=(RECFM=FBA,LRECL=133,BLKSIZE=27930)
//*
//****************************************************************
//* THE CONTROL REPORT IS ALSO KEPT ON DISK FOR SEVEN
//* GENERATIONS SO THAT LAST NIGHT CAN BE COMPARED WITH TONIGHT
//* WITHOUT GOING TO THE SPOOL ARCHIVE.
//****************************************************************
//*
//         IF (STEP010.RUNDB2.RC <= 8) THEN
//STEP020  EXEC PGM=IEBGENER
//SYSUT1   DD DSN=CARD.PROD.CTLRPT(0),DISP=SHR
//SYSUT2   DD DSN=CARD.PROD.CTLRPT(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,
//             SPACE=(TRK,(30,10),RLSE),
//             DCB=(RECFM=FBA,LRECL=133,BLKSIZE=27930)
//SYSIN    DD DUMMY
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//         ENDIF
//*
//****************************************************************
//* WHEN THE CYCLE CLOSED CLEAN THE ONLINE REGION IS RELEASED BY
//* THE SCHEDULER.  THE STEP BELOW ONLY LEAVES THE EVIDENCE IN
//* THE JOB LOG FOR THE MORNING SHIFT.
//****************************************************************
//*
//         IF (STEP010.RUNDB2.RC <= 4) THEN
//STEP030  EXEC PGM=IEBGENER
//SYSUT1   DD *
CARDNITE CYCLE CLOSED CLEAN - CARDONLJ MAY BE RELEASED
/*
//SYSUT2   DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//         ELSE
//STEP035  EXEC PGM=IEBGENER
//SYSUT1   DD *
CARDNITE CYCLE HELD - ONLINE REGION STAYS CLOSED, PAGE DUTY MGR
/*
//SYSUT2   DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//         ENDIF
//
