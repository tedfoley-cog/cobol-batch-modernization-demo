//CBCRD01J JOB (CARD,BATCH,0100),'CARD BATCH SVCS',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//             REGION=0M,TIME=1440,NOTIFY=&SYSUID
//*
//****************************************************************
//* CARDNITE STEP 1 OF 10 - AUTHORIZATION LOG EXTRACT
//*
//* READS VSAM AUTHLOG (ESDS) SEQUENTIALLY FOR THE CYCLE AND
//* WRITES A FIXED 300 BYTE EXTRACT TO THE AUTHEXTR GDG.  THE RUN
//* IS RECORDED IN THE CYCLE CONTROL KSDS.
//*
//* PARM - CCYYMMDD CYCLE DATE, CYCLE ID AFTER THE COMMA.  THE
//*        SCHEDULER RESOLVES &CYCDATE FROM THE RUN CALENDAR.
//*
//* RETURN CODES
//*   0000 EXTRACT COMPLETE
//*   0004 EXTRACT COMPLETE, RECORDS SKIPPED - SEE SYSOUT
//*   0008 NO RECORDS SELECTED FOR THE CYCLE DATE
//*   0012 FATAL, U0102 OR U0103 ABEND
//*
//* RESTART
//*   RESTART=STEP010.  THE STEP IS RE-RUNNABLE AS IT STANDS -
//*   THE UNCATALOGUED +1 GENERATION IS DELETED BY THE FAILING
//*   JOB AND THE CYCLE CONTROL RECORD IS REWRITTEN FROM SCRATCH.
//*   NEVER RESTART AT STEP020, IT WOULD FILE A CONTROL COPY OF
//*   AN EXTRACT THAT WAS NEVER COMPLETED.
//****************************************************************
//*
//         SET CYCDATE=20240131
//         SET CYCID=CN240131
//*
//STEP010  EXEC PGM=CBCRD01,REGION=32M,TIME=(20,00),
//             PARM='&CYCDATE,&CYCID'
//STEPLIB  DD DSN=CARD.PROD.FIXLIB,DISP=SHR
//         DD DSN=CARD.PROD.LOADLIB,DISP=SHR
//         DD DSN=CARD.PROD.COMMON.LOADLIB,DISP=SHR
//AUTHLOG  DD DSN=CARD.PROD.AUTHLOG,DISP=SHR
//CYCLCTL  DD DSN=CARD.PROD.CYCLCTL,DISP=SHR
//AUTHEXTR DD DSN=CARD.PROD.AUTHEXTR(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,
//             SPACE=(CYL,(300,60),RLSE),
//             DCB=(RECFM=FB,LRECL=300,BLKSIZE=27300)
//SYSOUT   DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//CEEDUMP  DD SYSOUT=*
//*
//****************************************************************
//* STEP020 FILES THE EXTRACT CONTROL COPY FOR THE MORNING
//* RECONCILIATION FOLDER.  SKIPPED WHEN THE EXTRACT FAILED OR
//* SELECTED NOTHING.
//****************************************************************
//*
//         IF (STEP010.RC = 0 OR STEP010.RC = 4) THEN
//STEP020  EXEC PGM=IEBGENER
//SYSUT1   DD DSN=CARD.PROD.AUTHEXTR(+1),DISP=SHR
//SYSUT2   DD SYSOUT=*,
//             DCB=(RECFM=FB,LRECL=300,BLKSIZE=27300)
//SYSIN    DD DUMMY
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//         ENDIF
//
