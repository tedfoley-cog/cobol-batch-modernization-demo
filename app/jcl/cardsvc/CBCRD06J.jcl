//CBCRD06J JOB (CARD,BATCH,0100),'CARD BATCH SVCS',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//             REGION=0M,TIME=1440,NOTIFY=&SYSUID
//*
//****************************************************************
//* CARDNITE STEP 6 OF 10 - THE JOIN, EXPOSURE RECALCULATION
//*
//* THIS JOB JOINS THE TWO BRANCHES.  THE SCHEDULER DEPENDENCY IS
//* DECLARED IN THE CONTROL-M TABLE, BUT THE JOB DOES NOT TRUST
//* IT - STEP005 READS THE CYCLE CONTROL RECORD AND ABENDS IF
//* EITHER BRANCH HAS NOT POSTED ITS COMPLETION FLAG FOR THE
//* CYCLE DATE.  THE CYCLE HAS BEEN RELEASED EARLY BY A MANUAL
//* FORCE OK MORE THAN ONCE AND THE ACCOUNTS WERE RECALCULATED
//* AGAINST HALF A NIGHT OF FEES.  DO NOT REMOVE STEP005.
//*
//*   STEP005 CBCRD06W  VERIFY BOTH BRANCHES COMPLETED
//*   STEP010 CBCRD06A  ASSEMBLE THE PARTY WORK LIST
//*   STEP020 CBCRD06X  SORT AND DE-DUPLICATE THE WORK LIST
//*   STEP030 CBCRD06B  DISPATCH THE EXPOSURE RECALCULATION
//*   STEP040 CBCRD06C  APPLY THE RETURNED RISK OUTCOMES
//*
//* STEP030 CALLS A LOAD MODULE THAT IS RESOLVED AT RUN TIME FROM
//* CARDSVC.PGM_ROUTE, AND THE RESOLVED MODULE DOES NOT LIVE IN
//* THE CARD LIBRARIES.  THE PARTYRSK LOAD LIBRARY IS THEREFORE
//* CONCATENATED ON THAT STEP AND ON THAT STEP ONLY.
//*
//* PARM ON STEP005 - CCYYMMDD,WAIT=NNN  NNN IS THE NUMBER OF
//* POLLS BEFORE THE STEP GIVES UP.  EACH POLL IS ONE MINUTE.
//*
//* RETURN CODES
//*   STEP005 0000 BOTH BRANCHES COMPLETE
//*           U0602 ONE OR BOTH BRANCHES NOT COMPLETE AFTER THE
//*                 POLL LIMIT - SEE THE OPERATOR RUNBOOK
//*           U0603 A BRANCH POSTED A FAILED FLAG
//*   STEP030 0000 EVERY PARTY ACCEPTED
//*           0004 WARNINGS COUNTED INTO THE EXCEPTION REPORT
//*           0008 AT LEAST ONE PARTY IS ON THE MANUAL REVIEW
//*                FILE - STEP040 STILL RUNS FOR THE REST
//*           0012 FATAL, U0632 ABEND
//*
//* RESTART
//*   RESTART=STEP005 IS ALWAYS SAFE AND IS THE NORMAL ANSWER.
//*   RESTART=STEP030 IS ALLOWED WHEN ONLY THE CROSSING FAILED,
//*   THE SORTED WORK LIST IS A CATALOGUED GENERATION.
//****************************************************************
//*
//         JCLLIB ORDER=(CARD.PROD.PROCLIB)
//         SET CYCDATE=20240131
//*
//STEP005  EXEC PGM=CBCRD06W,REGION=8M,TIME=(60,00),
//             PARM='&CYCDATE,WAIT=030'
//STEPLIB  DD DSN=CARD.PROD.FIXLIB,DISP=SHR
//         DD DSN=CARD.PROD.LOADLIB,DISP=SHR
//         DD DSN=CARD.PROD.COMMON.LOADLIB,DISP=SHR
//CYCLCTL  DD DSN=CARD.PROD.CYCLCTL,DISP=SHR
//SYSOUT   DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//CEEDUMP  DD SYSOUT=*
//*
//         IF (STEP005.RC = 0) THEN
//STEP010  EXEC CARDDB2,RGN=48M,TM=(30,00)
//RUNDB2.SYSTSIN DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(CBCRD06A) PLAN(CARDNITP) -
      LIB('CARD.PROD.LOADLIB') PARM('20240131')
  END
/*
//RUNDB2.CYCLCTL  DD DSN=CARD.PROD.CYCLCTL,DISP=SHR
//RUNDB2.PARTYWK  DD DSN=CARD.PROD.PARTYWK(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,
//             SPACE=(CYL,(60,15),RLSE),
//             DCB=(RECFM=FB,LRECL=150,BLKSIZE=27300)
//         ENDIF
//*
//         IF (STEP010.RUNDB2.RC <= 4) THEN
//STEP020  EXEC PGM=CBCRD06X,REGION=48M,TIME=(15,00)
//STEPLIB  DD DSN=CARD.PROD.FIXLIB,DISP=SHR
//         DD DSN=CARD.PROD.LOADLIB,DISP=SHR
//         DD DSN=CARD.PROD.COMMON.LOADLIB,DISP=SHR
//PARTYWK  DD DSN=CARD.PROD.PARTYWK(0),DISP=SHR
//PARTYSRT DD DSN=CARD.PROD.PARTYSRT(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,
//             SPACE=(CYL,(60,15),RLSE),
//             DCB=(RECFM=FB,LRECL=150,BLKSIZE=27300)
//SORTWK01 DD UNIT=SYSDA,SPACE=(CYL,(60,15))
//SORTWK02 DD UNIT=SYSDA,SPACE=(CYL,(60,15))
//SORTWK03 DD UNIT=SYSDA,SPACE=(CYL,(60,15))
//SYSOUT   DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//CEEDUMP  DD SYSOUT=*
//         ENDIF
//*
//****************************************************************
//* STEP030 - THE CROSSING.  NOTE THE EXTRA LOAD LIBRARY.
//****************************************************************
//*
//         IF (STEP020.RC <= 4) THEN
//STEP030  EXEC CARDDB2,RGN=64M,TM=(60,00)
//RUNDB2.STEPLIB  DD DSN=CARD.PROD.FIXLIB,DISP=SHR
//         DD DSN=CARD.PROD.LOADLIB,DISP=SHR
//         DD DSN=CARD.PROD.COMMON.LOADLIB,DISP=SHR
//         DD DSN=PRSK.PROD.LOADLIB,DISP=SHR
//         DD DSN=DSN910.SDSNLOAD,DISP=SHR
//         DD DSN=DSN910.SDSNEXIT,DISP=SHR
//         DD DSN=DSN910.RUNLIB.LOAD,DISP=SHR
//RUNDB2.SYSTSIN DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(CBCRD06B) PLAN(CARDNITP) -
      LIB('CARD.PROD.LOADLIB') PARM('20240131')
  END
/*
//RUNDB2.PARTYSRT DD DSN=CARD.PROD.PARTYSRT(0),DISP=SHR
//RUNDB2.PARTYACC DD DSN=CARD.PROD.PARTYACC(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,
//             SPACE=(CYL,(60,15),RLSE),
//             DCB=(RECFM=FB,LRECL=150,BLKSIZE=27300)
//RUNDB2.PARTYRVW DD DSN=CARD.PROD.PARTYRVW(+1),
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,
//             SPACE=(CYL,(15,5),RLSE),
//             DCB=(RECFM=FB,LRECL=150,BLKSIZE=27300)
//RUNDB2.RISKEXC  DD SYSOUT=*,
//             DCB=(RECFM=FBA,LRECL=133,BLKSIZE=27930)
//         ENDIF
//*
//****************************************************************
//* STEP040 IS GATED ON THE WORST RETURN CODE SEEN BY THE
//* CROSSING.  A 8 MEANS AT LEAST ONE PARTY WENT TO MANUAL
//* REVIEW, WHICH IS A BUSINESS OUTCOME, NOT A FAILURE - THE
//* ACCEPTED PARTIES ARE STILL APPLIED.  A 12 STOPS THE JOB.
//****************************************************************
//*
//         IF (STEP030.RUNDB2.RC <= 8) THEN
//STEP040  EXEC CARDDB2,RGN=48M,TM=(30,00)
//RUNDB2.SYSTSIN DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(CBCRD06C) PLAN(CARDNITP) -
      LIB('CARD.PROD.LOADLIB') PARM('20240131')
  END
/*
//RUNDB2.PARTYACC DD DSN=CARD.PROD.PARTYACC(0),DISP=SHR
//RUNDB2.CYCLCTL  DD DSN=CARD.PROD.CYCLCTL,DISP=SHR
//RUNDB2.BANDRPT  DD SYSOUT=*,
//             DCB=(RECFM=FBA,LRECL=133,BLKSIZE=27930)
//         ENDIF
//*
//****************************************************************
//* THE MANUAL REVIEW FILE IS PRINTED FOR THE SERVICING TEAM
//* WHENEVER THE CROSSING PRODUCED ONE.
//****************************************************************
//*
//         IF (STEP030.RUNDB2.RC = 8) THEN
//STEP050  EXEC PGM=IEBGENER
//SYSUT1   DD DSN=CARD.PROD.PARTYRVW(+1),DISP=SHR
//SYSUT2   DD SYSOUT=*,
//             DCB=(RECFM=FBA,LRECL=133,BLKSIZE=27930)
//SYSIN    DD *
  GENERATE MAXFLDS=2
  RECORD FIELD=(132,1,,2)
/*
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//         ENDIF
//
