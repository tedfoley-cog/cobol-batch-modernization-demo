*----------------------------------------------------------------------
* CSDMAP - BMS MAPSET DEFINITIONS
*
* GROUP CARDMAP.  DFHCSDUP BATCH INPUT.
*
* CARDSET IS THE ORIGINAL MAPSET.  IT FILLED UP IN 2006 - A 3270
* MAPSET LOAD MODULE CANNOT GROW WITHOUT LIMIT AND THE LINK EDIT WAS
* RUNNING INTO SIZE PROBLEMS - SO CARDST2 WAS ADDED FOR THE MAPS
* WRITTEN AFTER THAT DATE.  THE TWO ARE FUNCTIONALLY EQUIVALENT AND
* BOTH ARE ACTIVE.
*
* MAPSETS ARE LINKED AS ASSEMBLER LOAD MODULES FROM THE BMS SOURCE IN
* APP/CARDSVC/BMS.  AFTER A MAP CHANGE BOTH THE MAPSET LOAD MODULE
* AND THE PROGRAMS THAT COPY THE SYMBOLIC MAP MUST BE NEWCOPYED.
*----------------------------------------------------------------------
*
DELETE GROUP(CARDMAP)
*
DEFINE MAPSET(CARDSET) GROUP(CARDMAP)
       DESCRIPTION(CARD SERVICING SCREENS - ORIGINAL MAPSET)
       RESIDENT(YES)
       USAGE(NORMAL)
       USELPACOPY(NO)
       STATUS(ENABLED)
*
DEFINE MAPSET(CARDST2) GROUP(CARDMAP)
       DESCRIPTION(CARD SERVICING SCREENS - EXTENSION MAPSET 2006)
       RESIDENT(YES)
       USAGE(NORMAL)
       USELPACOPY(NO)
       STATUS(ENABLED)
*
*----------------------------------------------------------------------
* THE MAPSETS ARE ALSO DEFINED AS PROGRAMS SO THAT CEMT SET PROGRAM
* NEWCOPY WORKS AGAINST THEM DIRECTLY.  THIS IS HOW THE REGION HAS
* ALWAYS BEEN SET UP - THE OPERATIONS PROCEDURE FOR A MAP CHANGE
* REFERS TO THESE NAMES.
*----------------------------------------------------------------------
DEFINE PROGRAM(CARDSET) GROUP(CARDMAP)
       DESCRIPTION(MAPSET LOAD MODULE - CARDSET)
       LANGUAGE(ASSEMBLER)
       DATALOCATION(ANY)
       EXECKEY(CICS)
       CONCURRENCY(QUASIRENT)
       RESIDENT(YES)
       STATUS(ENABLED)
       USAGE(NORMAL)
       CEDF(NO)
*
DEFINE PROGRAM(CARDST2) GROUP(CARDMAP)
       DESCRIPTION(MAPSET LOAD MODULE - CARDST2)
       LANGUAGE(ASSEMBLER)
       DATALOCATION(ANY)
       EXECKEY(CICS)
       CONCURRENCY(QUASIRENT)
       RESIDENT(YES)
       STATUS(ENABLED)
       USAGE(NORMAL)
       CEDF(NO)
