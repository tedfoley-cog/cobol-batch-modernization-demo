*----------------------------------------------------------------------
* CSDPRTY - PARTYRSK PROGRAM DEFINITIONS
*
* GROUP PRTYGRP.  DFHCSDUP BATCH INPUT.
*
* PARTY & RISK OWNS THIS MEMBER.  THE PROGRAMS ARE DEFINED IN THE SAME
* REGION AS CARDGRP - THERE IS NO MRO OR DPL ROUTING BETWEEN THEM AND
* NO REMOTE PROGRAM DEFINITIONS.  THIS WAS A 1998 DECISION TAKEN TO
* AVOID THE MIRROR TRANSACTION COST AND HAS NEVER BEEN REVISITED.
*
* PARTYRSK RUNS UNDER ITS OWN RACF GROUP AND ITS OWN DB2 COLLECTION.
* THE PROGRAMS BELOW ARE ALL THREADSAFE - THEY ISSUE SQL AGAINST
* PARTYDB ON EVERY INVOCATION.
*----------------------------------------------------------------------
*
DELETE GROUP(PRTYGRP)
*
*----------------------------------------------------------------------
* KYC AND PARTY SERVICING
*
* PRKYC01 AND PRKYC03 ARE ENTERED ONLY THROUGH A LINK ISSUED FROM A
* RESOLVED NAME.  NOTHING IN THE LOAD LIBRARY REFERS TO THEM BY
* LITERAL, SO THEY MUST BE DEFINED EXPLICITLY WITH DYNAMIC(YES).
*----------------------------------------------------------------------
DEFINE PROGRAM(PRKYC01) GROUP(PRTYGRP)
       DESCRIPTION(AUTH RISK ASSESSMENT ENTRY POINT)
       LANGUAGE(COBOL)
       DATALOCATION(ANY)
       EXECKEY(USER)
       CONCURRENCY(THREADSAFE)
       DYNAMIC(YES)
       API(CICSAPI)
       EXECUTIONSET(FULLAPI)
       STATUS(ENABLED)
       RESIDENT(YES)
       RELOAD(NO)
       CEDF(YES)
*
DEFINE PROGRAM(PRKYC02) GROUP(PRTYGRP)
       DESCRIPTION(SANCTIONS AND WATCH LIST SCREENING)
       LANGUAGE(COBOL)
       DATALOCATION(ANY)
       EXECKEY(USER)
       CONCURRENCY(THREADSAFE)
       STATUS(ENABLED)
       RESIDENT(YES)
       CEDF(YES)
*
DEFINE PROGRAM(PRKYC03) GROUP(PRTYGRP)
       DESCRIPTION(PARTY AND KYC INQUIRY ENTRY POINT)
       LANGUAGE(COBOL)
       DATALOCATION(ANY)
       EXECKEY(USER)
       CONCURRENCY(THREADSAFE)
       DYNAMIC(YES)
       STATUS(ENABLED)
       RESIDENT(YES)
       CEDF(YES)
*
DEFINE PROGRAM(PRKYC04) GROUP(PRTYGRP)
       DESCRIPTION(KYC REVIEW STATUS MAINTENANCE)
       LANGUAGE(COBOL)
       DATALOCATION(ANY)
       EXECKEY(USER)
       CONCURRENCY(THREADSAFE)
       STATUS(ENABLED)
       RESIDENT(NO)
       CEDF(YES)
*
*----------------------------------------------------------------------
* RISK SCORING AND EXPOSURE
*----------------------------------------------------------------------
DEFINE PROGRAM(PRRSK02) GROUP(PRTYGRP)
       DESCRIPTION(PARTY EXPOSURE AGGREGATION)
       LANGUAGE(COBOL)
       DATALOCATION(ANY)
       EXECKEY(USER)
       CONCURRENCY(THREADSAFE)
       STATUS(ENABLED)
       RESIDENT(YES)
       CEDF(YES)
*
DEFINE PROGRAM(PRRSK03) GROUP(PRTYGRP)
       DESCRIPTION(RISK MODEL SCORING ENGINE)
       LANGUAGE(COBOL)
       DATALOCATION(ANY)
       EXECKEY(USER)
       CONCURRENCY(THREADSAFE)
       STATUS(ENABLED)
       RESIDENT(YES)
       CEDF(YES)
*
DEFINE PROGRAM(PRRSK04) GROUP(PRTYGRP)
       DESCRIPTION(RISK DECISION AND ADVICE CODE DERIVATION)
       LANGUAGE(COBOL)
       DATALOCATION(ANY)
       EXECKEY(USER)
       CONCURRENCY(THREADSAFE)
       STATUS(ENABLED)
       RESIDENT(YES)
       CEDF(YES)
*
DEFINE PROGRAM(PRRSK05) GROUP(PRTYGRP)
       DESCRIPTION(RISK AUDIT TRAIL WRITER - APPEND ONLY)
       LANGUAGE(COBOL)
       DATALOCATION(ANY)
       EXECKEY(USER)
       CONCURRENCY(THREADSAFE)
       STATUS(ENABLED)
       RESIDENT(YES)
       CEDF(NO)
*
*----------------------------------------------------------------------
* ERROR HANDLING
*----------------------------------------------------------------------
DEFINE PROGRAM(PRERR01) GROUP(PRTYGRP)
       DESCRIPTION(PARTYRSK ONLINE ERROR HANDLER)
       LANGUAGE(COBOL)
       DATALOCATION(ANY)
       EXECKEY(CICS)
       CONCURRENCY(THREADSAFE)
       STATUS(ENABLED)
       RESIDENT(YES)
       CEDF(NO)
