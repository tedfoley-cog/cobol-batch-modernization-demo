*----------------------------------------------------------------------
* CSDFILE - VSAM FILE DEFINITIONS FOR THE CARD SERVICING REGION
*
* GROUP CARDFILE.  DFHCSDUP BATCH INPUT.
*
* THE CLUSTERS THEMSELVES ARE DEFINED BY APP/JCL/VSAM/DEFCARD.JCL AND
* APP/JCL/VSAM/DEFPARTY.JCL.  THE DSNAME ON EACH DEFINITION BELOW
* MUST MATCH THAT MEMBER EXACTLY.
*
* LSR POOL ALLOCATION
*   POOL 1  HIGH TRAFFIC KEYED FILES READ ON EVERY AUTHORISATION
*   POOL 2  REFERENCE FILES, READ ONLY ONLINE, LOW UPDATE
*   NSR     THE ESDS LOG - IT IS WRITTEN SEQUENTIALLY AND WOULD
*           FLOOD AN LSR POOL
*
* THE REFERENCE FILES ARE READ ONLY IN THE REGION.  THEY ARE REBUILT
* BY THE WEEKLY REFERENCE CYCLE WHILE THE REGION IS DOWN, SO NO
* UPDATE, ADD OR DELETE SERVICE IS GRANTED ONLINE.  BACKOUT IS NOT
* REQUIRED FOR THEM AND RECOVERY(NONE) SAVES THE LOG TRAFFIC.
*----------------------------------------------------------------------
*
DELETE GROUP(CARDFILE)
*
*----------------------------------------------------------------------
* CARDXREF - CARD NUMBER TO ACCOUNT CROSS REFERENCE, KSDS
*----------------------------------------------------------------------
DEFINE FILE(CARDXREF) GROUP(CARDFILE)
       DESCRIPTION(CARD NUMBER TO ACCOUNT CROSS REFERENCE)
       DSNAME(CARD.PROD.CARDXREF)
       LSRPOOLID(1)
       STRINGS(012)
       DATABUFFERS(014)
       INDEXBUFFERS(013)
       RECORDFORMAT(F)
       RECORDSIZE(128)
       KEYLENGTH(16)
       ADD(YES)
       BROWSE(YES)
       DELETE(NO)
       READ(YES)
       UPDATE(YES)
       STATUS(ENABLED)
       OPENTIME(FIRSTREF)
       DISPOSITION(SHR)
       RECOVERY(BACKOUTONLY)
       FWDRECOVLOG(NO)
       JOURNAL(NO)
       DSNSHARING(ALLREQS)
       TABLE(NO)
*
*----------------------------------------------------------------------
* CARDXRF1 - PATH OVER THE CARDXREF ALTERNATE INDEX BY ACCOUNT
* BROWSE ONLY.  THE AIX IS UPGRADE, SO UPDATES THROUGH THE BASE
* CLUSTER MAINTAIN IT - NEVER UPDATE THROUGH THE PATH.
*----------------------------------------------------------------------
DEFINE FILE(CARDXRF1) GROUP(CARDFILE)
       DESCRIPTION(CARDXREF BY ACCOUNT NUMBER - PATH, BROWSE ONLY)
       DSNAME(CARD.PROD.CARDXREF.PATH1)
       LSRPOOLID(1)
       STRINGS(008)
       RECORDFORMAT(F)
       RECORDSIZE(128)
       KEYLENGTH(11)
       ADD(NO)
       BROWSE(YES)
       DELETE(NO)
       READ(YES)
       UPDATE(NO)
       STATUS(ENABLED)
       OPENTIME(FIRSTREF)
       DISPOSITION(SHR)
       RECOVERY(NONE)
       DSNSHARING(ALLREQS)
*
*----------------------------------------------------------------------
* AUTHLOG - RAW AUTHORISATION LOG, ESDS, WRITE ONLY ONLINE
* NSR AND A DEDICATED STRING COUNT - THIS FILE TAKES EVERY
* AUTHORISATION THE REGION HANDLES.
*----------------------------------------------------------------------
DEFINE FILE(AUTHLOG) GROUP(CARDFILE)
       DESCRIPTION(AUTHORISATION LOG - ESDS, ADD ONLY)
       DSNAME(CARD.PROD.AUTHLOG)
       LSRPOOLID(NONE)
       STRINGS(020)
       DATABUFFERS(024)
       RECORDFORMAT(F)
       RECORDSIZE(200)
       ADD(YES)
       BROWSE(NO)
       DELETE(NO)
       READ(NO)
       UPDATE(NO)
       STATUS(ENABLED)
       OPENTIME(STARTUP)
       DISPOSITION(SHR)
       RECOVERY(NONE)
       JOURNAL(01)
       JNLADD(AFTER)
       DSNSHARING(ALLREQS)
*
*----------------------------------------------------------------------
* MERCHRTE - MERCHANT SETTLEMENT ROUTING, REFERENCE, READ ONLY
*----------------------------------------------------------------------
DEFINE FILE(MERCHRTE) GROUP(CARDFILE)
       DESCRIPTION(MERCHANT SETTLEMENT ROUTING - REFERENCE)
       DSNAME(CARD.PROD.MERCHRTE)
       LSRPOOLID(2)
       STRINGS(006)
       RECORDFORMAT(F)
       RECORDSIZE(120)
       KEYLENGTH(15)
       ADD(NO)
       BROWSE(YES)
       DELETE(NO)
       READ(YES)
       UPDATE(NO)
       STATUS(ENABLED)
       OPENTIME(FIRSTREF)
       DISPOSITION(SHR)
       RECOVERY(NONE)
       DSNSHARING(ALLREQS)
*
*----------------------------------------------------------------------
* FRAUDRUL - FRAUD RULE PARAMETERS, REFERENCE, READ ONLY
* SMALL AND READ ON EVERY AUTHORISATION - LOADED AS A CICS DATA TABLE
* SO THE RULE READS DO NOT REACH VSAM AT ALL AFTER FIRST TOUCH.
*----------------------------------------------------------------------
DEFINE FILE(FRAUDRUL) GROUP(CARDFILE)
       DESCRIPTION(FRAUD RULE PARAMETERS - CICS MAINTAINED DATA TABLE)
       DSNAME(CARD.PROD.FRAUDRUL)
       LSRPOOLID(2)
       STRINGS(004)
       RECORDFORMAT(F)
       RECORDSIZE(240)
       KEYLENGTH(8)
       ADD(NO)
       BROWSE(YES)
       DELETE(NO)
       READ(YES)
       UPDATE(NO)
       STATUS(ENABLED)
       OPENTIME(STARTUP)
       DISPOSITION(SHR)
       RECOVERY(NONE)
       TABLE(CICS)
       MAXNUMRECS(01000)
       DSNSHARING(ALLREQS)
*
*----------------------------------------------------------------------
* CUSTPREF - CUSTOMER SERVICING PREFERENCES, UPDATED ONLINE
*----------------------------------------------------------------------
DEFINE FILE(CUSTPREF) GROUP(CARDFILE)
       DESCRIPTION(CUSTOMER SERVICING PREFERENCES)
       DSNAME(CARD.PROD.CUSTPREF)
       LSRPOOLID(1)
       STRINGS(008)
       RECORDFORMAT(F)
       RECORDSIZE(180)
       KEYLENGTH(9)
       ADD(YES)
       BROWSE(YES)
       DELETE(NO)
       READ(YES)
       UPDATE(YES)
       STATUS(ENABLED)
       OPENTIME(FIRSTREF)
       DISPOSITION(SHR)
       RECOVERY(BACKOUTONLY)
       DSNSHARING(ALLREQS)
*
*----------------------------------------------------------------------
* RSNCODE - REASON AND RESPONSE CODE REFERENCE, READ ONLY
*----------------------------------------------------------------------
DEFINE FILE(RSNCODE) GROUP(CARDFILE)
       DESCRIPTION(REASON AND RESPONSE CODE REFERENCE)
       DSNAME(CARD.PROD.RSNCODE)
       LSRPOOLID(2)
       STRINGS(004)
       RECORDFORMAT(F)
       RECORDSIZE(100)
       KEYLENGTH(8)
       ADD(NO)
       BROWSE(YES)
       DELETE(NO)
       READ(YES)
       UPDATE(NO)
       STATUS(ENABLED)
       OPENTIME(STARTUP)
       DISPOSITION(SHR)
       RECOVERY(NONE)
       TABLE(CICS)
       MAXNUMRECS(00500)
       DSNSHARING(ALLREQS)
*
*----------------------------------------------------------------------
* CYCLCTL - BATCH CYCLE CONTROL AND RESTART
*
* THE CLUSTER IS DEFINED SHAREOPTIONS(1 3) - ONE UPDATER.  THE REGION
* READS IT SO THE OPERATIONS DISPLAY CAN SHOW CYCLE STATE, BUT NEVER
* WRITES IT.  DSNSHARING(MODIFYREQS) SO THAT A BATCH JOB HOLDING THE
* CLUSTER FOR UPDATE DOES NOT COLLIDE WITH THE REGION'S READ.
*----------------------------------------------------------------------
DEFINE FILE(CYCLCTL) GROUP(CARDFILE)
       DESCRIPTION(BATCH CYCLE CONTROL - READ ONLY ONLINE)
       DSNAME(CARD.PROD.CYCLCTL)
       LSRPOOLID(2)
       STRINGS(002)
       RECORDFORMAT(F)
       RECORDSIZE(256)
       KEYLENGTH(16)
       ADD(NO)
       BROWSE(YES)
       DELETE(NO)
       READ(YES)
       UPDATE(NO)
       STATUS(ENABLED)
       OPENTIME(FIRSTREF)
       DISPOSITION(SHR)
       RECOVERY(NONE)
       DSNSHARING(MODIFYREQS)
*
*----------------------------------------------------------------------
* PGMROUT - ROUTE TABLE FALLBACK CLUSTER
*
* READ ONLY.  IT IS ONLY TOUCHED WHEN THE DB2 CONTROL TABLE CANNOT BE
* READ, SO OPENTIME IS STARTUP - AN OPEN FAILURE MUST BE VISIBLE AT
* REGION START, NOT AT THE MOMENT DB2 GOES DOWN.
*----------------------------------------------------------------------
DEFINE FILE(PGMROUT) GROUP(CARDFILE)
       DESCRIPTION(ROUTE TABLE FALLBACK - READ ONLY)
       DSNAME(CARD.PROD.PGMROUT)
       LSRPOOLID(2)
       STRINGS(004)
       RECORDFORMAT(F)
       RECORDSIZE(97)
       KEYLENGTH(16)
       ADD(NO)
       BROWSE(YES)
       DELETE(NO)
       READ(YES)
       UPDATE(NO)
       STATUS(ENABLED)
       OPENTIME(STARTUP)
       DISPOSITION(SHR)
       RECOVERY(NONE)
       DSNSHARING(ALLREQS)
*
*----------------------------------------------------------------------
* PARTYRSK CLUSTERS
*
* PRTY.PROD DATASETS ARE ALLOCATED TO THE SAME REGION.  RACF GROUP
* PRTYONL HOLDS UPDATE, CARDONL HOLDS NOTHING - THE FILE CONTROL
* DEFINITIONS BELOW ARE USED ONLY BY PRTYGRP PROGRAMS.
*----------------------------------------------------------------------
DEFINE FILE(RSKPARM) GROUP(CARDFILE)
       DESCRIPTION(RISK MODEL PARAMETERS - REFERENCE)
       DSNAME(PRTY.PROD.RSKPARM)
       LSRPOOLID(2)
       STRINGS(004)
       RECORDFORMAT(F)
       RECORDSIZE(120)
       KEYLENGTH(16)
       ADD(NO)
       BROWSE(YES)
       DELETE(NO)
       READ(YES)
       UPDATE(NO)
       STATUS(ENABLED)
       OPENTIME(STARTUP)
       DISPOSITION(SHR)
       RECOVERY(NONE)
       TABLE(CICS)
       MAXNUMRECS(00800)
       DSNSHARING(ALLREQS)
*
DEFINE FILE(WATCHLST) GROUP(CARDFILE)
       DESCRIPTION(CONSOLIDATED SANCTIONS WATCH LIST)
       DSNAME(PRTY.PROD.WATCHLST)
       LSRPOOLID(1)
       STRINGS(010)
       DATABUFFERS(012)
       INDEXBUFFERS(011)
       RECORDFORMAT(F)
       RECORDSIZE(160)
       KEYLENGTH(24)
       ADD(NO)
       BROWSE(YES)
       DELETE(NO)
       READ(YES)
       UPDATE(NO)
       STATUS(ENABLED)
       OPENTIME(FIRSTREF)
       DISPOSITION(SHR)
       RECOVERY(NONE)
       DSNSHARING(ALLREQS)
*
*----------------------------------------------------------------------
* WATCHLS1 - PATH OVER THE WATCHLST NAME ALTERNATE INDEX
* BROWSE ONLY.  NAME SCREENING WALKS THIS PATH FORWARD FROM A
* TRUNCATED KEY, SO IT NEEDS A GENEROUS STRING COUNT.
*----------------------------------------------------------------------
DEFINE FILE(WATCHLS1) GROUP(CARDFILE)
       DESCRIPTION(WATCH LIST BY ENTITY NAME - PATH, BROWSE ONLY)
       DSNAME(PRTY.PROD.WATCHLST.PATH1)
       LSRPOOLID(1)
       STRINGS(010)
       RECORDFORMAT(F)
       RECORDSIZE(160)
       KEYLENGTH(60)
       ADD(NO)
       BROWSE(YES)
       DELETE(NO)
       READ(YES)
       UPDATE(NO)
       STATUS(ENABLED)
       OPENTIME(FIRSTREF)
       DISPOSITION(SHR)
       RECOVERY(NONE)
       DSNSHARING(ALLREQS)
*
*----------------------------------------------------------------------
* LSR POOL DEFINITIONS
*----------------------------------------------------------------------
DEFINE LSRPOOL(1) GROUP(CARDFILE)
       DESCRIPTION(HIGH TRAFFIC KEYED FILES)
       LSRPOOLID(1)
       MAXKEYLENGTH(60)
       SHARELIMIT(50)
       STRINGS(070)
       DATA1(2048) DATA2(4096) DATA3(8192)
       INDEX1(1024) INDEX2(2048)
*
DEFINE LSRPOOL(2) GROUP(CARDFILE)
       DESCRIPTION(REFERENCE AND CONTROL FILES)
       LSRPOOLID(2)
       MAXKEYLENGTH(24)
       SHARELIMIT(50)
       STRINGS(024)
       DATA1(2048) DATA2(4096)
       INDEX1(1024) INDEX2(2048)
