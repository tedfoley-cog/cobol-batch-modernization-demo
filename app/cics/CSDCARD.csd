*----------------------------------------------------------------------
* CSDCARD - CARDSVC PROGRAM AND TRANSACTION DEFINITIONS
*
* GROUP CARDGRP.  DFHCSDUP BATCH INPUT.
* APPLIED BY APP/CICS/DFHCSDUP.JCL INTO THE CSD SHARED BY THE
* PRODUCTION REGION CICSCARD.
*
* CONVENTIONS
*   EXECKEY(USER)        APPLICATION PROGRAMS
*   EXECKEY(CICS)        DISPATCH, ERROR AND AUDIT SERVICE PROGRAMS
*   CONCURRENCY(THREADSAFE) PROGRAMS WITH EXEC SQL - THEY AVOID THE
*                        TCB SWITCH BACK TO QR ON EVERY DB2 CALL
*   CONCURRENCY(QUASIRENT) PROGRAMS WITH NO SQL AND NO OPEN API USE
*   DATALOCATION(ANY)    EVERYTHING - 31 BIT ADDRESSABLE
*----------------------------------------------------------------------
*
DELETE GROUP(CARDGRP)
*
*----------------------------------------------------------------------
* TRANSACTION
*----------------------------------------------------------------------
DEFINE TRANSACTION(CA00) GROUP(CARDGRP)
       DESCRIPTION(CARD SERVICING - MENU AND ALL SERVICED FUNCTIONS)
       PROGRAM(CACRD00)
       TWASIZE(0)
       PROFILE(DFHCICST)
       STATUS(ENABLED)
       TASKDATALOC(ANY)
       TASKDATAKEY(USER)
       STORAGECLEAR(NO)
       RUNAWAY(SYSTEM)
       SHUTDOWN(DISABLED)
       ISOLATE(YES)
       PRIORITY(001)
       TRANCLASS(DFHTCL00)
       DTIMOUT(00030)
       RESSEC(YES)
       CMDSEC(NO)
       SPURGE(YES)
       TPURGE(NO)
*
DEFINE TRANSACTION(CA99) GROUP(CARDGRP)
       DESCRIPTION(CARD SERVICING ADMINISTRATION - RESTRICTED)
       PROGRAM(CACRD16)
       TWASIZE(0)
       PROFILE(DFHCICST)
       STATUS(ENABLED)
       TASKDATALOC(ANY)
       TASKDATAKEY(USER)
       RUNAWAY(SYSTEM)
       PRIORITY(001)
       DTIMOUT(00060)
       RESSEC(YES)
       CMDSEC(YES)
*
*----------------------------------------------------------------------
* ENTRY POINT AND MENU
*----------------------------------------------------------------------
DEFINE PROGRAM(CACRD00) GROUP(CARDGRP)
       DESCRIPTION(SIGN ON, MENU AND OPTION DISPATCH)
       LANGUAGE(COBOL)
       DATALOCATION(ANY)
       EXECKEY(USER)
       CONCURRENCY(THREADSAFE)
       API(CICSAPI)
       EXECUTIONSET(FULLAPI)
       STATUS(ENABLED)
       RELOAD(NO)
       RESIDENT(YES)
       USAGE(NORMAL)
       USELPACOPY(NO)
       CEDF(YES)
*
*----------------------------------------------------------------------
* SERVICED FUNCTIONS
*
* THESE MODULES ARE ENTERED WITH AN XCTL OR A LINK ISSUED FROM A
* NAME HELD IN A WORKING STORAGE FIELD, NOT FROM A LITERAL, SO THEY
* CARRY DYNAMIC(YES) - THE LOADER MUST RESOLVE THEM AT RUN TIME AND
* NO STATIC REFERENCE EXISTS FOR THE REGION TO AUTOINSTALL FROM.
*----------------------------------------------------------------------
DEFINE PROGRAM(CACRD01) GROUP(CARDGRP)
       DESCRIPTION(ACCOUNT INQUIRY)
       LANGUAGE(COBOL) DATALOCATION(ANY) EXECKEY(USER)
       CONCURRENCY(THREADSAFE) DYNAMIC(YES)
       STATUS(ENABLED) RESIDENT(NO) CEDF(YES)
*
DEFINE PROGRAM(CACRD02) GROUP(CARDGRP)
       DESCRIPTION(CARD LIST AND CROSS REFERENCE BROWSE)
       LANGUAGE(COBOL) DATALOCATION(ANY) EXECKEY(USER)
       CONCURRENCY(THREADSAFE) DYNAMIC(YES)
       STATUS(ENABLED) RESIDENT(NO) CEDF(YES)
*
DEFINE PROGRAM(CACRD03) GROUP(CARDGRP)
       DESCRIPTION(CARD DETAIL AND STATUS DISPLAY)
       LANGUAGE(COBOL) DATALOCATION(ANY) EXECKEY(USER)
       CONCURRENCY(THREADSAFE) DYNAMIC(YES)
       STATUS(ENABLED) RESIDENT(NO) CEDF(YES)
*
DEFINE PROGRAM(CACRD04) GROUP(CARDGRP)
       DESCRIPTION(AUTHORISATION REQUEST ENTRY)
       LANGUAGE(COBOL) DATALOCATION(ANY) EXECKEY(USER)
       CONCURRENCY(THREADSAFE) DYNAMIC(YES)
       STATUS(ENABLED) RESIDENT(YES) CEDF(YES)
*
DEFINE PROGRAM(CACRD05) GROUP(CARDGRP)
       DESCRIPTION(AUTHORISATION DECISION)
       LANGUAGE(COBOL) DATALOCATION(ANY) EXECKEY(USER)
       CONCURRENCY(THREADSAFE)
       STATUS(ENABLED) RESIDENT(YES) CEDF(YES)
*
DEFINE PROGRAM(CACRD06) GROUP(CARDGRP)
       DESCRIPTION(LIMIT AND VELOCITY CHECKING)
       LANGUAGE(COBOL) DATALOCATION(ANY) EXECKEY(USER)
       CONCURRENCY(THREADSAFE)
       STATUS(ENABLED) RESIDENT(YES) CEDF(YES)
*
DEFINE PROGRAM(CACRD07) GROUP(CARDGRP)
       DESCRIPTION(FRAUD RULE PIPELINE DRIVER)
       LANGUAGE(COBOL) DATALOCATION(ANY) EXECKEY(USER)
       CONCURRENCY(THREADSAFE)
       STATUS(ENABLED) RESIDENT(YES) CEDF(YES)
*
DEFINE PROGRAM(CACRD08) GROUP(CARDGRP)
       DESCRIPTION(AUTHORISATION LOG WRITER)
       LANGUAGE(COBOL) DATALOCATION(ANY) EXECKEY(USER)
       CONCURRENCY(THREADSAFE)
       STATUS(ENABLED) RESIDENT(YES) CEDF(NO)
*
DEFINE PROGRAM(CACRD09) GROUP(CARDGRP)
       DESCRIPTION(TRANSACTION HISTORY BROWSE)
       LANGUAGE(COBOL) DATALOCATION(ANY) EXECKEY(USER)
       CONCURRENCY(THREADSAFE)
       STATUS(ENABLED) RESIDENT(NO) CEDF(YES)
*
DEFINE PROGRAM(CACRD10) GROUP(CARDGRP)
       DESCRIPTION(STATEMENT INQUIRY)
       LANGUAGE(COBOL) DATALOCATION(ANY) EXECKEY(USER)
       CONCURRENCY(THREADSAFE)
       STATUS(ENABLED) RESIDENT(NO) CEDF(YES)
*
DEFINE PROGRAM(CACRD11) GROUP(CARDGRP)
       DESCRIPTION(CARD MAINTENANCE - BLOCK AND REISSUE)
       LANGUAGE(COBOL) DATALOCATION(ANY) EXECKEY(USER)
       CONCURRENCY(THREADSAFE) DYNAMIC(YES)
       STATUS(ENABLED) RESIDENT(NO) CEDF(YES)
*
DEFINE PROGRAM(CACRD12) GROUP(CARDGRP)
       DESCRIPTION(CREDIT LIMIT CHANGE REQUEST)
       LANGUAGE(COBOL) DATALOCATION(ANY) EXECKEY(USER)
       CONCURRENCY(THREADSAFE) DYNAMIC(YES)
       STATUS(ENABLED) RESIDENT(NO) CEDF(YES)
