       DESCRIPTION(DISPUTE AND CHARGEBACK ENTRY)
       LANGUAGE(COBOL) DATALOCATION(ANY) EXECKEY(USER)
       CONCURRENCY(THREADSAFE) DYNAMIC(YES)
       STATUS(ENABLED) RESIDENT(NO) CEDF(YES)
*
DEFINE PROGRAM(CACRD14) GROUP(CARDGRP)
       DESCRIPTION(ONLINE PAYMENT POSTING)
       LANGUAGE(COBOL) DATALOCATION(ANY) EXECKEY(USER)
       CONCURRENCY(THREADSAFE) DYNAMIC(YES)
       STATUS(ENABLED) RESIDENT(NO) CEDF(YES)
*
DEFINE PROGRAM(CACRD15) GROUP(CARDGRP)
       DESCRIPTION(CUSTOMER AND KYC INQUIRY)
       LANGUAGE(COBOL) DATALOCATION(ANY) EXECKEY(USER)
       CONCURRENCY(THREADSAFE) DYNAMIC(YES)
       STATUS(ENABLED) RESIDENT(NO) CEDF(YES)
*
DEFINE PROGRAM(CACRD16) GROUP(CARDGRP)
       DESCRIPTION(REFERENCE AND REASON CODE LOOKUP)
       LANGUAGE(COBOL) DATALOCATION(ANY) EXECKEY(USER)
