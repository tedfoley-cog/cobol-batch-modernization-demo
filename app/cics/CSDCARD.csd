       CONCURRENCY(THREADSAFE) DYNAMIC(YES)
       STATUS(ENABLED) RESIDENT(NO) CEDF(YES)
*
*----------------------------------------------------------------------
* SERVICE PROGRAMS
*
* CACRD90 RUNS IN CICS KEY.  IT ISSUES THE LINK OR XCTL FOR A LOAD
* MODULE NAME HELD IN WORKING STORAGE, SO NO STATIC REFERENCE TO ITS
* TARGETS EXISTS ANYWHERE IN THE LOAD LIBRARY.  EVERY TARGET MUST BE
* DEFINED HERE OR IN CSDPRTY OR THE LINK FAILS PGMIDERR.
*----------------------------------------------------------------------
DEFINE PROGRAM(CACRD90) GROUP(CARDGRP)
       DESCRIPTION(ONLINE PROGRAM DISPATCHER)
       LANGUAGE(COBOL)
       DATALOCATION(ANY)
       EXECKEY(CICS)
       CONCURRENCY(THREADSAFE)
       API(CICSAPI)
       EXECUTIONSET(FULLAPI)
       STATUS(ENABLED)
       RESIDENT(YES)
       RELOAD(NO)
       USAGE(NORMAL)
       CEDF(YES)
*
DEFINE PROGRAM(CACRD91) GROUP(CARDGRP)
       DESCRIPTION(ONLINE ERROR HANDLER AND ABEND FORMATTER)
       LANGUAGE(COBOL)
       DATALOCATION(ANY)
       EXECKEY(CICS)
       CONCURRENCY(THREADSAFE)
       STATUS(ENABLED)
       RESIDENT(YES)
       CEDF(NO)
*
DEFINE PROGRAM(CACRD92) GROUP(CARDGRP)
       DESCRIPTION(SERVICE UNAVAILABLE FALLBACK RESPONDER)
       LANGUAGE(COBOL)
       DATALOCATION(ANY)
       EXECKEY(CICS)
       CONCURRENCY(THREADSAFE)
       STATUS(ENABLED)
       RESIDENT(YES)
       CEDF(NO)
*
*----------------------------------------------------------------------
* FRAUD RULE HANDLERS
*
* ENTERED FROM A RESOLVED NAME, NEVER FROM A LITERAL - DYNAMIC(YES).
* THEY ARE SHORT RUNNING AND CALLED SEVERAL TIMES PER AUTHORISATION
* SO THEY ARE HELD RESIDENT.
*----------------------------------------------------------------------
DEFINE PROGRAM(CAFRD01) GROUP(CARDGRP)
       DESCRIPTION(VELOCITY RULES)
       LANGUAGE(COBOL) DATALOCATION(ANY) EXECKEY(USER)
       CONCURRENCY(THREADSAFE) DYNAMIC(YES)
       STATUS(ENABLED) RESIDENT(YES) CEDF(NO)
*
DEFINE PROGRAM(CAFRD02) GROUP(CARDGRP)
       DESCRIPTION(GEOGRAPHY AND MCC RULES)
       LANGUAGE(COBOL) DATALOCATION(ANY) EXECKEY(USER)
       CONCURRENCY(THREADSAFE) DYNAMIC(YES)
       STATUS(ENABLED) RESIDENT(YES) CEDF(NO)
*
DEFINE PROGRAM(CAFRD03) GROUP(CARDGRP)
       DESCRIPTION(AMOUNT PATTERN RULES)
       LANGUAGE(COBOL) DATALOCATION(ANY) EXECKEY(USER)
       CONCURRENCY(THREADSAFE) DYNAMIC(YES)
       STATUS(ENABLED) RESIDENT(YES) CEDF(NO)
*
DEFINE PROGRAM(CAFRD04) GROUP(CARDGRP)
       DESCRIPTION(MERCHANT REPUTATION RULES)
       LANGUAGE(COBOL) DATALOCATION(ANY) EXECKEY(USER)
       CONCURRENCY(THREADSAFE) DYNAMIC(YES)
       STATUS(ENABLED) RESIDENT(YES) CEDF(NO)
*
*----------------------------------------------------------------------
* SUPERSEDED DEFINITION RETAINED SO THAT AN OLD ROUTE ROW ORDERED BY
* MISTAKE FAILS WITH A CLEAN DISABLED RESPONSE RATHER THAN PGMIDERR.
*----------------------------------------------------------------------
DEFINE PROGRAM(CACRD07X) GROUP(CARDGRP)
       DESCRIPTION(WITHDRAWN 2020 - DISPUTE ENTRY, DO NOT ENABLE)
       LANGUAGE(COBOL) DATALOCATION(ANY) EXECKEY(USER)
       CONCURRENCY(QUASIRENT) DYNAMIC(YES)
       STATUS(DISABLED) RESIDENT(NO) CEDF(NO)
*
*----------------------------------------------------------------------
* ASSEMBLER SUBROUTINE
* LINKED STATICALLY INTO ITS CALLERS.  DEFINED HERE ONLY SO THAT THE
* LOAD MODULE CAN BE NEWCOPYED INDEPENDENTLY AFTER A REASSEMBLE.
*----------------------------------------------------------------------
DEFINE PROGRAM(CARDCHK) GROUP(CARDGRP)
       DESCRIPTION(CARD NUMBER AND PACKED FIELD VALIDATION - HLASM)
       LANGUAGE(ASSEMBLER)
       DATALOCATION(ANY)
       EXECKEY(USER)
       CONCURRENCY(THREADSAFE)
       API(CICSAPI)
       EXECUTIONSET(DPLSUBSET)
       STATUS(ENABLED)
       RESIDENT(YES)
       RELOAD(NO)
       CEDF(NO)
