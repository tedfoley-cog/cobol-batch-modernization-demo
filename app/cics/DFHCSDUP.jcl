//CSDUPCRD JOB (CARD,SYS),'APPLY CARDSVC CSD',CLASS=A,
//             MSGCLASS=X,NOTIFY=&SYSUID,REGION=0M
//*
//* APPLY THE CARD SERVICING RESOURCE DEFINITIONS TO THE CSD USED BY
//* THE PRODUCTION REGION CICSCARD.
//*
//* THE REGION MUST BE DOWN, OR THE CSD MUST BE ALLOCATED SHARED AND
//* THE UPDATED GROUPS INSTALLED AFTERWARDS WITH CEDA INSTALL.  A
//* DEFINE AGAINST AN IN USE CSD FAILS WITH A CSD OPEN ERROR - THE
//* JOB WILL NOT CORRUPT ANYTHING, IT SIMPLY WILL NOT RUN.
//*
//* ORDER MATTERS.  THE FILE GROUP MUST BE APPLIED BEFORE THE PROGRAM
//* GROUPS ARE INSTALLED OR FIRST REFERENCE OPENS WILL FAIL.
//*
//* CHANGE CONTROL - EVERY RUN OF THIS JOB REQUIRES A CHANGE RECORD.
//* THE EXTRACT STEP AT THE END PRODUCES THE BEFORE AND AFTER LISTING
//* THAT IS ATTACHED TO IT.
//*
//JCLLIB   JCLLIB ORDER=(CARD.PROD.PROCLIB)
//*
//*--------------------------------------------------------------------
//* STEP 1 - BACKUP THE CSD BEFORE ANY CHANGE
//*--------------------------------------------------------------------
//BACKUP   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//INCSD    DD DSN=CICS.CARD.DFHCSD,DISP=SHR
//OUTCSD   DD DSN=CICS.CARD.DFHCSD.BACKUP(+1),
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(CYL,(20,5),RLSE),
//            DCB=(RECFM=VB,LRECL=4092,BLKSIZE=27998)
//SYSIN    DD *
  REPRO INFILE(INCSD) OUTFILE(OUTCSD)
/*
//*
//*--------------------------------------------------------------------
//* STEP 2 - APPLY THE GROUP DEFINITIONS
//*
//* SYSIN IS CONCATENATED IN DEPENDENCY ORDER.  EACH MEMBER STARTS
//* WITH DELETE GROUP SO THE APPLY IS A REPLACE, NOT A MERGE - A
//* RESOURCE REMOVED FROM A MEMBER IS REMOVED FROM THE CSD.
//*--------------------------------------------------------------------
//CSDUP    EXEC PGM=DFHCSDUP,REGION=0M,
//             PARM='CSD(FILEA),PAGESIZE(60),NOCOMPAT'
//STEPLIB  DD DSN=CICSTS.SDFHLOAD,DISP=SHR
//DFHCSD   DD DSN=CICS.CARD.DFHCSD,DISP=OLD
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DSN=CARD.PROD.CICS(CSDFILE),DISP=SHR
//         DD DSN=CARD.PROD.CICS(CSDMAP),DISP=SHR
//         DD DSN=CARD.PROD.CICS(CSDTDQ),DISP=SHR
//         DD DSN=CARD.PROD.CICS(CSDCARD),DISP=SHR
//         DD DSN=PRTY.PROD.CICS(CSDPRTY),DISP=SHR
//         DD *
*--------------------------------------------------------------------
* GROUP LIST MAINTENANCE
*
* CARDLIST IS THE APPLICATION GROUP LIST NAMED ON GRPLIST IN THE SIT
* AFTER THE IBM SUPPLIED LISTS.  THE ORDER OF THE ADDS BELOW IS THE
* ORDER THE GROUPS ARE INSTALLED AT AN INITIAL START.
*
* CARDFILE MUST INSTALL BEFORE CARDGRP AND PRTYGRP SO THAT FILES
* WITH OPENTIME(STARTUP) ARE KNOWN BEFORE ANY PROGRAM CAN REFERENCE
* THEM.  PRTYGRP INSTALLS LAST - IT IS THE ONLY GROUP OWNED OUTSIDE
* CARD SYSTEMS AND IS THE ONE MOST OFTEN REINSTALLED ON ITS OWN.
*--------------------------------------------------------------------
  DELETE LIST(CARDLIST)
*
  ADD GROUP(CARDFILE) LIST(CARDLIST)
  ADD GROUP(CARDMAP)  LIST(CARDLIST)
  ADD GROUP(CARDTDQ)  LIST(CARDLIST)
  ADD GROUP(CARDGRP)  LIST(CARDLIST)
  ADD GROUP(PRTYGRP)  LIST(CARDLIST)
*
*--------------------------------------------------------------------
* VERIFY - LIST THE GROUP LIST AND CHECK EVERY GROUP RESOLVED
*--------------------------------------------------------------------
  LIST LIST(CARDLIST) OBJECTS
/*
//*
//*--------------------------------------------------------------------
//* STEP 3 - EXTRACT THE INSTALLED DEFINITIONS FOR THE CHANGE RECORD
//* ONLY RUNS IF THE APPLY WAS CLEAN.
//*--------------------------------------------------------------------
//EXTRACT  EXEC PGM=DFHCSDUP,REGION=0M,COND=(4,LT,CSDUP),
//             PARM='CSD(FILEA),PAGESIZE(60)'
//STEPLIB  DD DSN=CICSTS.SDFHLOAD,DISP=SHR
//DFHCSD   DD DSN=CICS.CARD.DFHCSD,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DSN=CARD.PROD.CICS.EXTRACT(+1),
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(30,10),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=27920)
//SYSIN    DD *
  EXTRACT GROUP(CARDGRP)  USERPROGRAM(DFH0CBDC) OBJECTS
  EXTRACT GROUP(CARDFILE) USERPROGRAM(DFH0CBDC) OBJECTS
  EXTRACT GROUP(CARDMAP)  USERPROGRAM(DFH0CBDC) OBJECTS
  EXTRACT GROUP(CARDTDQ)  USERPROGRAM(DFH0CBDC) OBJECTS
  EXTRACT GROUP(PRTYGRP)  USERPROGRAM(DFH0CBDC) OBJECTS
/*
//*
//*--------------------------------------------------------------------
//* STEP 4 - NOTIFY
//*--------------------------------------------------------------------
//NOTIFY   EXEC PGM=IEBGENER,COND=(4,LT,CSDUP)
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD *
CSD APPLY COMPLETE FOR REGION CICSCARD.
INSTALL THE UPDATED GROUPS WITH CEDA OR RESTART THE REGION.
IF THE REGION IS RESTARTED, USE START=AUTO.  AN INITIAL START
DISCARDS THE INTRAPARTITION QUEUE AND THE REFERRED WORK ON IT.
/*
//SYSUT2   DD SYSOUT=*
//SYSIN    DD DUMMY
//
