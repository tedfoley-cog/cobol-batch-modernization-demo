*---------------------------------------------------------------------
* CARDMP2 - MAPSET CARDST2
*
* SERVICING AND MAINTENANCE SCREENS FOR TRANSACTION CA00.
* THE MENU AND INQUIRY SCREENS ARE IN MAPSET CARDST1 (CARDMAP1).
* CARDST2 WAS SPLIT OUT WHEN CARDST1 OUTGREW THE LOAD MODULE LIMIT.
*
* MAP     USED BY   FUNCTION
* CRD11A  CACRD11   CARD MAINTENANCE ENTRY
* CRD11B  CACRD11   CARD MAINTENANCE CONFIRMATION
* CRD12A  CACRD12   CREDIT LIMIT CHANGE REQUEST
* CRD13A  CACRD13   TRANSACTION BROWSE FOR DISPUTE SELECTION
* CRD13B  CACRD13   DISPUTE DETAIL ENTRY
* CRD14A  CACRD14   PAYMENT POSTING AND REVERSAL
* CRD15A  CACRD15   CUSTOMER / KYC INQUIRY
* CRD16A  CACRD16   REASON CODE BROWSE
* CRD16B  CACRD16   MERCHANT LOOKUP
*---------------------------------------------------------------------
CARDST2  DFHMSD TYPE=&SYSPARM,                                         X
               MODE=INOUT,                                             X
               LANG=COBOL,                                             X
               STORAGE=AUTO,                                           X
               CTRL=(FREEKB,FRSET),                                    X
               TIOAPFX=YES,                                            X
               MAPATTS=(COLOR,HILIGHT),                                X
               DSATTS=(COLOR,HILIGHT)
*---------------------------------------------------------------------
* CRD11A - CARD MAINTENANCE ENTRY
*---------------------------------------------------------------------
CRD11A   DFHMDI SIZE=(24,80)
         DFHMDF POS=(01,01),LENGTH=07,ATTRB=(PROT,NORM),               X
               INITIAL='CACRD11'
         DFHMDF POS=(01,26),LENGTH=29,ATTRB=(PROT,BRT),                X
               INITIAL='C A R D   M A I N T E N A N C'
M11DATE  DFHMDF POS=(01,68),LENGTH=08,ATTRB=(PROT,NORM)
M11TIME  DFHMDF POS=(02,68),LENGTH=08,ATTRB=(PROT,NORM)
         DFHMDF POS=(04,02),LENGTH=12,ATTRB=(PROT,NORM),               X
               INITIAL='CARD NUMBER:'
M11CARD  DFHMDF POS=(04,15),LENGTH=16,ATTRB=(UNPROT,IC,FSET),          X
               COLOR=GREEN
         DFHMDF POS=(04,32),LENGTH=01,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(04,36),LENGTH=07,ATTRB=(PROT,NORM),               X
               INITIAL='ACTION:'
M11ACTN  DFHMDF POS=(04,44),LENGTH=04,ATTRB=(UNPROT,FSET),             X
               COLOR=GREEN
         DFHMDF POS=(04,49),LENGTH=30,ATTRB=(PROT,NORM),               X
               INITIAL='BLCK UNBL REPL REIS'
         DFHMDF POS=(06,02),LENGTH=12,ATTRB=(PROT,NORM),               X
               INITIAL='BLOCK REASN:'
M11BRSN  DFHMDF POS=(06,15),LENGTH=04,ATTRB=(UNPROT,FSET),             X
               COLOR=GREEN
         DFHMDF POS=(06,20),LENGTH=01,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(08,02),LENGTH=20,ATTRB=(PROT,BRT),                X
               INITIAL='------ CARD DETAIL -'
         DFHMDF POS=(09,02),LENGTH=12,ATTRB=(PROT,NORM),               X
               INITIAL='STATUS     :'
M11STAT  DFHMDF POS=(09,15),LENGTH=01,ATTRB=(PROT,BRT),COLOR=TURQUOISE
M11STXT  DFHMDF POS=(09,18),LENGTH=14,ATTRB=(PROT,NORM)
         DFHMDF POS=(09,36),LENGTH=09,ATTRB=(PROT,NORM),               X
               INITIAL='ACCOUNT :'
M11ACCT  DFHMDF POS=(09,46),LENGTH=11,ATTRB=(PROT,NORM)
         DFHMDF POS=(10,02),LENGTH=12,ATTRB=(PROT,NORM),               X
               INITIAL='EMBOSSED   :'
M11NAME  DFHMDF POS=(10,15),LENGTH=26,ATTRB=(PROT,NORM)
         DFHMDF POS=(10,44),LENGTH=08,ATTRB=(PROT,NORM),               X
               INITIAL='PRODUCT:'
M11PROD  DFHMDF POS=(10,53),LENGTH=04,ATTRB=(PROT,NORM)
         DFHMDF POS=(11,02),LENGTH=12,ATTRB=(PROT,NORM),               X
               INITIAL='EXPIRY YYMM:'
M11EXPY  DFHMDF POS=(11,15),LENGTH=04,ATTRB=(PROT,NORM)
         DFHMDF POS=(11,36),LENGTH=09,ATTRB=(PROT,NORM),               X
               INITIAL='ISSUED  :'
M11ISSD  DFHMDF POS=(11,46),LENGTH=10,ATTRB=(PROT,NORM)
         DFHMDF POS=(12,02),LENGTH=12,ATTRB=(PROT,NORM),               X
               INITIAL='REISSUE CNT:'
M11RCNT  DFHMDF POS=(12,15),LENGTH=02,ATTRB=(PROT,NORM)
         DFHMDF POS=(12,36),LENGTH=09,ATTRB=(PROT,NORM),               X
               INITIAL='PREV CRD:'
M11PREV  DFHMDF POS=(12,46),LENGTH=16,ATTRB=(PROT,NORM)
         DFHMDF POS=(13,02),LENGTH=12,ATTRB=(PROT,NORM),               X
               INITIAL='BLOCK REASN:'
M11BRSD  DFHMDF POS=(13,15),LENGTH=04,ATTRB=(PROT,NORM)
         DFHMDF POS=(13,36),LENGTH=09,ATTRB=(PROT,NORM),               X
               INITIAL='BLOCK DT:'
M11BDAT  DFHMDF POS=(13,46),LENGTH=10,ATTRB=(PROT,NORM)
         DFHMDF POS=(14,02),LENGTH=12,ATTRB=(PROT,NORM),               X
               INITIAL='ACTIVATION :'
M11ACTV  DFHMDF POS=(14,15),LENGTH=10,ATTRB=(PROT,NORM)
M11MSG   DFHMDF POS=(22,02),LENGTH=78,ATTRB=(PROT,BRT),COLOR=RED
         DFHMDF POS=(24,02),LENGTH=44,ATTRB=(PROT,NORM),               X
               INITIAL='ENTER=PROCESS  PF3=MENU  PF12=EXIT'
*---------------------------------------------------------------------
* CRD11B - CARD MAINTENANCE CONFIRMATION
*---------------------------------------------------------------------
CRD11B   DFHMDI SIZE=(24,80)
         DFHMDF POS=(01,01),LENGTH=07,ATTRB=(PROT,NORM),               X
               INITIAL='CACRD11'
         DFHMDF POS=(01,24),LENGTH=32,ATTRB=(PROT,BRT),                X
               INITIAL='CARD MAINTENANCE - CONFIRMATION'
M11BDTE  DFHMDF POS=(01,68),LENGTH=08,ATTRB=(PROT,NORM)
         DFHMDF POS=(04,02),LENGTH=14,ATTRB=(PROT,NORM),               X
               INITIAL='CARD NUMBER  :'
M11BCRD  DFHMDF POS=(04,17),LENGTH=16,ATTRB=(PROT,BRT)
         DFHMDF POS=(05,02),LENGTH=14,ATTRB=(PROT,NORM),               X
               INITIAL='REQUESTED ACTN:'
M11BACT  DFHMDF POS=(05,17),LENGTH=20,ATTRB=(PROT,BRT)
         DFHMDF POS=(06,02),LENGTH=14,ATTRB=(PROT,NORM),               X
               INITIAL='STATUS FROM  :'
M11BOST  DFHMDF POS=(06,17),LENGTH=14,ATTRB=(PROT,NORM)
         DFHMDF POS=(07,02),LENGTH=14,ATTRB=(PROT,NORM),               X
               INITIAL='STATUS TO    :'
M11BNST  DFHMDF POS=(07,17),LENGTH=14,ATTRB=(PROT,NORM)
         DFHMDF POS=(08,02),LENGTH=14,ATTRB=(PROT,NORM),               X
               INITIAL='NEW CARD NBR :'
M11BNEW  DFHMDF POS=(08,17),LENGTH=16,ATTRB=(PROT,BRT),COLOR=TURQUOISE
         DFHMDF POS=(10,02),LENGTH=40,ATTRB=(PROT,NORM),               X
               INITIAL='ENTER Y TO COMMIT, N TO ABANDON     :'
M11BCNF  DFHMDF POS=(10,44),LENGTH=01,ATTRB=(UNPROT,IC,FSET),          X
               COLOR=GREEN
         DFHMDF POS=(10,46),LENGTH=01,ATTRB=(ASKIP,NORM)
M11BMSG  DFHMDF POS=(22,02),LENGTH=78,ATTRB=(PROT,BRT),COLOR=RED
         DFHMDF POS=(24,02),LENGTH=44,ATTRB=(PROT,NORM),               X
               INITIAL='ENTER=CONFIRM  PF3=MENU  PF12=EXIT'
*---------------------------------------------------------------------
