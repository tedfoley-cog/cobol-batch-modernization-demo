               PICOUT='X(3)'
         DFHMDF POS=(9,25),LENGTH=1,ATTRB=(ASKIP,NORM),INITIAL=' '
         DFHMDF POS=(10,2),LENGTH=17,ATTRB=(ASKIP,NORM),               X
               INITIAL='TERMINAL ID . . .'
AUTERM   DFHMDF POS=(10,21),LENGTH=8,ATTRB=(UNPROT,NORM),PICIN='X(8)', X
               PICOUT='X(8)'
         DFHMDF POS=(10,30),LENGTH=1,ATTRB=(ASKIP,NORM),INITIAL=' '
         DFHMDF POS=(11,2),LENGTH=17,ATTRB=(ASKIP,NORM),               X
               INITIAL='ENTRY MODE  . . .'
AUMODE   DFHMDF POS=(11,21),LENGTH=1,ATTRB=(UNPROT,NORM),PICIN='X',    X
               PICOUT='X'
         DFHMDF POS=(11,23),LENGTH=34,ATTRB=(ASKIP,NORM),              X
               INITIAL='S=SWIPE C=CHIP K=KEY E=ECOM T=CTLS'
         DFHMDF POS=(13,2),LENGTH=17,ATTRB=(ASKIP,NORM),               X
