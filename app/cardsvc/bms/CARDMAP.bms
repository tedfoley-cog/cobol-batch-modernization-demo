***********************************************************************
* CARDMAP - BMS MAPSET CARDSET                                        *
*                                                                     *
* SCREENS FOR CICS TRANSACTION CA00 - CARD SERVICING.                 *
*                                                                     *
*   CARDMNU  MAIN MENU                        CACRD00                 *
*   CARDACC  ACCOUNT INQUIRY                  CACRD01                 *
*   CARDLST  CARD LIST / CROSS REFERENCE      CACRD02                 *
*   CARDDTL  CARD DETAIL AND STATUS           CACRD03                 *
*   CARDAUT  AUTHORIZATION REQUEST ENTRY      CACRD04                 *
*   CARDRSP  AUTHORIZATION OUTCOME            CACRD10                 *
*   CARDERR  DIAGNOSTIC / ERROR SCREEN        CACRD91                 *
*   CARDBYE  SESSION TERMINATED               CACRD17                 *
*                                                                     *
* ASSEMBLED TWICE - MAP=DSECT FOR THE SYMBOLIC COPYBOOK CARDSET AND   *
* MAP=MAP FOR THE LOAD MODULE.  SEE APP/JCL/BMS ASSEMBLY MEMBERS.     *
***********************************************************************
CARDSET  DFHMSD TYPE=&&SYSPARM,MODE=INOUT,LANG=COBOL,STORAGE=AUTO,     X
               TIOAPFX=YES,CTRL=FREEKB,TERM=3270-2,                    X
               MAPATTS=(COLOR,HILIGHT),DSATTS=(COLOR,HILIGHT)
*
***********************************************************************
* CARDMNU - CA00 MAIN MENU                                            *
***********************************************************************
CARDMNU  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1,CTRL=(FREEKB,FRSET)
         DFHMDF POS=(1,1),LENGTH=4,ATTRB=(ASKIP,NORM),INITIAL='CA00'
         DFHMDF POS=(1,26),LENGTH=21,ATTRB=(ASKIP,NORM),               X
               INITIAL='CARD SERVICING SYSTEM'
MNDATE   DFHMDF POS=(1,66),LENGTH=8,ATTRB=(PROT,NORM),PICOUT='X(8)'
         DFHMDF POS=(2,30),LENGTH=9,ATTRB=(ASKIP,NORM),                X
               INITIAL='MAIN MENU'
MNTIME   DFHMDF POS=(2,66),LENGTH=8,ATTRB=(PROT,NORM),PICOUT='X(8)'
         DFHMDF POS=(4,6),LENGTH=19,ATTRB=(ASKIP,NORM),                X
               INITIAL='1.  ACCOUNT INQUIRY'
         DFHMDF POS=(5,6),LENGTH=31,ATTRB=(ASKIP,NORM),                X
               INITIAL='2.  CARD LIST / CROSS REFERENCE'
         DFHMDF POS=(6,6),LENGTH=26,ATTRB=(ASKIP,NORM),                X
               INITIAL='3.  CARD DETAIL AND STATUS'
         DFHMDF POS=(7,6),LENGTH=25,ATTRB=(ASKIP,NORM),                X
               INITIAL='4.  AUTHORIZATION REQUEST'
         DFHMDF POS=(8,6),LENGTH=20,ATTRB=(ASKIP,NORM),                X
               INITIAL='5.  CARD MAINTENANCE'
         DFHMDF POS=(9,6),LENGTH=23,ATTRB=(ASKIP,NORM),                X
               INITIAL='6.  CREDIT LIMIT CHANGE'
         DFHMDF POS=(10,6),LENGTH=17,ATTRB=(ASKIP,NORM),               X
               INITIAL='7.  DISPUTE ENTRY'
         DFHMDF POS=(11,6),LENGTH=18,ATTRB=(ASKIP,NORM),               X
               INITIAL='8.  ONLINE PAYMENT'
         DFHMDF POS=(12,6),LENGTH=26,ATTRB=(ASKIP,NORM),               X
               INITIAL='9.  CUSTOMER / KYC INQUIRY'
         DFHMDF POS=(13,6),LENGTH=25,ATTRB=(ASKIP,NORM),               X
               INITIAL='10. REFERENCE CODE LOOKUP'
         DFHMDF POS=(14,6),LENGTH=8,ATTRB=(ASKIP,NORM),                X
               INITIAL='X.  EXIT'
         DFHMDF POS=(16,6),LENGTH=12,ATTRB=(ASKIP,NORM),               X
               INITIAL='OPTION . . .'
MNOPT    DFHMDF POS=(16,20),LENGTH=2,ATTRB=(UNPROT,NORM,IC),           X
               PICIN='X(2)',PICOUT='X(2)'
         DFHMDF POS=(16,23),LENGTH=1,ATTRB=(ASKIP,NORM),INITIAL=' '
         DFHMDF POS=(17,6),LENGTH=12,ATTRB=(ASKIP,NORM),               X
               INITIAL='ACCOUNT  . .'
MNACCT   DFHMDF POS=(17,20),LENGTH=11,ATTRB=(UNPROT,NUM,NORM),         X
               PICIN='X(11)',PICOUT='X(11)'
         DFHMDF POS=(17,32),LENGTH=1,ATTRB=(ASKIP,NORM),INITIAL=' '
         DFHMDF POS=(18,6),LENGTH=12,ATTRB=(ASKIP,NORM),               X
               INITIAL='CARD NBR . .'
MNCARD   DFHMDF POS=(18,20),LENGTH=16,ATTRB=(UNPROT,NORM),             X
               PICIN='X(16)',PICOUT='X(16)'
         DFHMDF POS=(18,37),LENGTH=1,ATTRB=(ASKIP,NORM),INITIAL=' '
MNMSG    DFHMDF POS=(21,2),LENGTH=60,ATTRB=(PROT,BRT),PICOUT='X(60)'
MNOPER   DFHMDF POS=(22,2),LENGTH=8,ATTRB=(PROT,NORM),PICOUT='X(8)'
MNTERM   DFHMDF POS=(22,12),LENGTH=4,ATTRB=(PROT,NORM),PICOUT='X(4)'
         DFHMDF POS=(23,2),LENGTH=37,ATTRB=(ASKIP,NORM),               X
               INITIAL='ENTER=CONTINUE  PF3=EXIT  PF12=CANCEL'
         DFHMDF POS=(24,2),LENGTH=1,ATTRB=(ASKIP,DRK)
*
***********************************************************************
* CARDACC - ACCOUNT INQUIRY (CACRD01)                                 *
***********************************************************************
CARDACC  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1,CTRL=(FREEKB,FRSET)
         DFHMDF POS=(1,1),LENGTH=4,ATTRB=(ASKIP,NORM),INITIAL='CA00'
         DFHMDF POS=(1,28),LENGTH=15,ATTRB=(ASKIP,NORM),               X
               INITIAL='ACCOUNT INQUIRY'
AIDATE   DFHMDF POS=(1,66),LENGTH=8,ATTRB=(PROT,NORM),PICOUT='X(8)'
         DFHMDF POS=(3,2),LENGTH=13,ATTRB=(ASKIP,NORM),                X
               INITIAL='ACCOUNT . . .'
AIACCT   DFHMDF POS=(3,17),LENGTH=11,ATTRB=(UNPROT,NUM,NORM,IC),       X
               PICIN='X(11)',PICOUT='X(11)'
         DFHMDF POS=(3,29),LENGTH=1,ATTRB=(ASKIP,NORM),INITIAL=' '
         DFHMDF POS=(3,40),LENGTH=12,ATTRB=(ASKIP,NORM),               X
               INITIAL='CUSTOMER . .'
AICUST   DFHMDF POS=(3,54),LENGTH=9,ATTRB=(PROT,NORM),PICOUT='X(9)'
         DFHMDF POS=(4,2),LENGTH=13,ATTRB=(ASKIP,NORM),                X
               INITIAL='STATUS  . . .'
AISTAT   DFHMDF POS=(4,17),LENGTH=1,ATTRB=(PROT,BRT),PICOUT='X'
AISTATD  DFHMDF POS=(4,20),LENGTH=12,ATTRB=(PROT,NORM),PICOUT='X(12)'
         DFHMDF POS=(4,40),LENGTH=12,ATTRB=(ASKIP,NORM),               X
               INITIAL='PRODUCT  . .'
AIPROD   DFHMDF POS=(4,54),LENGTH=4,ATTRB=(PROT,NORM),PICOUT='X(4)'
         DFHMDF POS=(5,2),LENGTH=13,ATTRB=(ASKIP,NORM),                X
               INITIAL='CURRENCY  . .'
AICURR   DFHMDF POS=(5,17),LENGTH=3,ATTRB=(PROT,NORM),PICOUT='X(3)'
         DFHMDF POS=(5,40),LENGTH=12,ATTRB=(ASKIP,NORM),               X
               INITIAL='BRANCH . . .'
AIBRCH   DFHMDF POS=(5,54),LENGTH=5,ATTRB=(PROT,NORM),PICOUT='X(5)'
         DFHMDF POS=(7,2),LENGTH=18,ATTRB=(ASKIP,NORM),                X
               INITIAL='CURRENT BALANCE  .'
AICBAL   DFHMDF POS=(7,22),LENGTH=16,ATTRB=(PROT,NORM),PICOUT='X(16)'
         DFHMDF POS=(8,2),LENGTH=18,ATTRB=(ASKIP,NORM),                X
               INITIAL='STATEMENT BALANCE.'
AISBAL   DFHMDF POS=(8,22),LENGTH=16,ATTRB=(PROT,NORM),PICOUT='X(16)'
         DFHMDF POS=(9,2),LENGTH=18,ATTRB=(ASKIP,NORM),                X
               INITIAL='PENDING AUTH AMT .'
AIPEND   DFHMDF POS=(9,22),LENGTH=16,ATTRB=(PROT,NORM),PICOUT='X(16)'
         DFHMDF POS=(10,2),LENGTH=18,ATTRB=(ASKIP,NORM),               X
               INITIAL='CASH BALANCE . . .'
AICASH   DFHMDF POS=(10,22),LENGTH=16,ATTRB=(PROT,NORM),PICOUT='X(16)'
         DFHMDF POS=(11,2),LENGTH=18,ATTRB=(ASKIP,NORM),               X
               INITIAL='MINIMUM PAYMENT  .'
AIMINP   DFHMDF POS=(11,22),LENGTH=16,ATTRB=(PROT,NORM),PICOUT='X(16)'
         DFHMDF POS=(12,2),LENGTH=18,ATTRB=(ASKIP,NORM),               X
               INITIAL='LAST PAYMENT . . .'
AILPAY   DFHMDF POS=(12,22),LENGTH=16,ATTRB=(PROT,NORM),PICOUT='X(16)'
AILPDT   DFHMDF POS=(12,42),LENGTH=10,ATTRB=(PROT,NORM),PICOUT='X(10)'
         DFHMDF POS=(14,2),LENGTH=18,ATTRB=(ASKIP,NORM),               X
               INITIAL='CYCLE DAY  . . . .'
AICYCD   DFHMDF POS=(14,22),LENGTH=2,ATTRB=(PROT,NORM),PICOUT='X(2)'
         DFHMDF POS=(15,2),LENGTH=18,ATTRB=(ASKIP,NORM),               X
               INITIAL='LAST CYCLE DATE  .'
AILCYC   DFHMDF POS=(15,22),LENGTH=10,ATTRB=(PROT,NORM),PICOUT='X(10)'
         DFHMDF POS=(16,2),LENGTH=18,ATTRB=(ASKIP,NORM),               X
               INITIAL='NEXT CYCLE DATE  .'
AINCYC   DFHMDF POS=(16,22),LENGTH=10,ATTRB=(PROT,NORM),PICOUT='X(10)'
         DFHMDF POS=(17,2),LENGTH=18,ATTRB=(ASKIP,NORM),               X
               INITIAL='PAYMENT DUE DATE .'
AIDUE    DFHMDF POS=(17,22),LENGTH=10,ATTRB=(PROT,NORM),PICOUT='X(10)'
         DFHMDF POS=(18,2),LENGTH=18,ATTRB=(ASKIP,NORM),               X
               INITIAL='DELINQUENCY BUCKET'
AIDELQ   DFHMDF POS=(18,22),LENGTH=1,ATTRB=(PROT,BRT),PICOUT='X'
AIDELQD  DFHMDF POS=(18,25),LENGTH=14,ATTRB=(PROT,NORM),PICOUT='X(14)'
AIDLQA   DFHMDF POS=(18,42),LENGTH=16,ATTRB=(PROT,NORM),PICOUT='X(16)'
AIMSG    DFHMDF POS=(21,2),LENGTH=60,ATTRB=(PROT,BRT),PICOUT='X(60)'
         DFHMDF POS=(23,2),LENGTH=34,ATTRB=(ASKIP,NORM),               X
               INITIAL='ENTER=INQUIRE  PF3=MENU  PF12=EXIT'
*
***********************************************************************
* CARDLST - CARD LIST BY ACCOUNT, PAGED (CACRD02)                     *
***********************************************************************
CARDLST  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1,CTRL=(FREEKB,FRSET)
         DFHMDF POS=(1,1),LENGTH=4,ATTRB=(ASKIP,NORM),INITIAL='CA00'
         DFHMDF POS=(1,30),LENGTH=9,ATTRB=(ASKIP,NORM),                X
               INITIAL='CARD LIST'
CLDATE   DFHMDF POS=(1,66),LENGTH=8,ATTRB=(PROT,NORM),PICOUT='X(8)'
         DFHMDF POS=(3,2),LENGTH=13,ATTRB=(ASKIP,NORM),                X
               INITIAL='ACCOUNT . . .'
CLACCT   DFHMDF POS=(3,17),LENGTH=11,ATTRB=(UNPROT,NUM,NORM,IC),       X
               PICIN='X(11)',PICOUT='X(11)'
         DFHMDF POS=(3,29),LENGTH=1,ATTRB=(ASKIP,NORM),INITIAL=' '
         DFHMDF POS=(3,50),LENGTH=4,ATTRB=(ASKIP,NORM),INITIAL='PAGE'
CLPAGE   DFHMDF POS=(3,55),LENGTH=3,ATTRB=(PROT,NORM),PICOUT='X(3)'
         DFHMDF POS=(5,2),LENGTH=32,ATTRB=(ASKIP,NORM),                X
               INITIAL='SEL CARD NUMBER   ST PROD EXPIRY'
         DFHMDF POS=(5,38),LENGTH=13,ATTRB=(ASKIP,NORM),               X
               INITIAL='EMBOSSED NAME'
         DFHMDF POS=(6,2),LENGTH=35,ATTRB=(ASKIP,NORM),                X
               INITIAL='--- ---------------- -- ---- ------'
         DFHMDF POS=(6,38),LENGTH=26,ATTRB=(ASKIP,NORM),               X
               INITIAL='--------------------------'
CLSEL    DFHMDF POS=(7,2),LENGTH=1,ATTRB=(UNPROT,NORM),OCCURS=10,      X
               PICIN='X',PICOUT='X'
CLCARD   DFHMDF POS=(7,6),LENGTH=16,ATTRB=(PROT,NORM),OCCURS=10,       X
               PICOUT='X(16)'
CLSTAT   DFHMDF POS=(7,23),LENGTH=2,ATTRB=(PROT,NORM),OCCURS=10,       X
               PICOUT='X(2)'
CLPROD   DFHMDF POS=(7,26),LENGTH=4,ATTRB=(PROT,NORM),OCCURS=10,       X
               PICOUT='X(4)'
CLEXP    DFHMDF POS=(7,31),LENGTH=6,ATTRB=(PROT,NORM),OCCURS=10,       X
               PICOUT='X(6)'
CLNAME   DFHMDF POS=(7,38),LENGTH=26,ATTRB=(PROT,NORM),OCCURS=10,      X
               PICOUT='X(26)'
CLCNT    DFHMDF POS=(19,2),LENGTH=3,ATTRB=(PROT,NORM),PICOUT='X(3)'
         DFHMDF POS=(19,6),LENGTH=15,ATTRB=(ASKIP,NORM),               X
               INITIAL='CARDS DISPLAYED'
CLMSG    DFHMDF POS=(21,2),LENGTH=60,ATTRB=(PROT,BRT),PICOUT='X(60)'
         DFHMDF POS=(23,2),LENGTH=42,ATTRB=(ASKIP,NORM),               X
               INITIAL='PF7=BACK  PF8=FORWARD  PF3=MENU  PF12=EXIT'
*
***********************************************************************
* CARDDTL - CARD DETAIL AND STATUS (CACRD03)                          *
***********************************************************************
CARDDTL  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1,CTRL=(FREEKB,FRSET)
         DFHMDF POS=(1,1),LENGTH=4,ATTRB=(ASKIP,NORM),INITIAL='CA00'
         DFHMDF POS=(1,28),LENGTH=11,ATTRB=(ASKIP,NORM),               X
               INITIAL='CARD DETAIL'
CDDATE   DFHMDF POS=(1,66),LENGTH=8,ATTRB=(PROT,NORM),PICOUT='X(8)'
         DFHMDF POS=(3,2),LENGTH=13,ATTRB=(ASKIP,NORM),                X
               INITIAL='CARD NUMBER .'
CDCARD   DFHMDF POS=(3,17),LENGTH=16,ATTRB=(UNPROT,NORM,IC),           X
               PICIN='X(16)',PICOUT='X(16)'
         DFHMDF POS=(3,34),LENGTH=1,ATTRB=(ASKIP,NORM),INITIAL=' '
         DFHMDF POS=(4,2),LENGTH=13,ATTRB=(ASKIP,NORM),                X
               INITIAL='ACCOUNT . . .'
CDACCT   DFHMDF POS=(4,17),LENGTH=11,ATTRB=(PROT,NORM),PICOUT='X(11)'
         DFHMDF POS=(4,40),LENGTH=12,ATTRB=(ASKIP,NORM),               X
               INITIAL='CUSTOMER . .'
CDCUST   DFHMDF POS=(4,54),LENGTH=9,ATTRB=(PROT,NORM),PICOUT='X(9)'
         DFHMDF POS=(5,2),LENGTH=13,ATTRB=(ASKIP,NORM),                X
               INITIAL='EMBOSSED  . .'
CDNAME   DFHMDF POS=(5,17),LENGTH=26,ATTRB=(PROT,NORM),PICOUT='X(26)'
         DFHMDF POS=(6,2),LENGTH=13,ATTRB=(ASKIP,NORM),                X
               INITIAL='PRODUCT . . .'
CDPROD   DFHMDF POS=(6,17),LENGTH=4,ATTRB=(PROT,NORM),PICOUT='X(4)'
         DFHMDF POS=(6,40),LENGTH=12,ATTRB=(ASKIP,NORM),               X
               INITIAL='STATUS . . .'
CDSTAT   DFHMDF POS=(6,54),LENGTH=1,ATTRB=(PROT,BRT),PICOUT='X'
CDSTATD  DFHMDF POS=(6,57),LENGTH=14,ATTRB=(PROT,NORM),PICOUT='X(14)'
         DFHMDF POS=(7,2),LENGTH=13,ATTRB=(ASKIP,NORM),                X
               INITIAL='EXPIRY YYMM .'
CDEXP    DFHMDF POS=(7,17),LENGTH=4,ATTRB=(PROT,NORM),PICOUT='X(4)'
         DFHMDF POS=(7,40),LENGTH=12,ATTRB=(ASKIP,NORM),               X
               INITIAL='ISSUED . . .'
CDISS    DFHMDF POS=(7,54),LENGTH=10,ATTRB=(PROT,NORM),PICOUT='X(10)'
         DFHMDF POS=(8,2),LENGTH=13,ATTRB=(ASKIP,NORM),                X
               INITIAL='ACTIVATED . .'
CDACT    DFHMDF POS=(8,17),LENGTH=10,ATTRB=(PROT,NORM),PICOUT='X(10)'
         DFHMDF POS=(8,40),LENGTH=12,ATTRB=(ASKIP,NORM),               X
               INITIAL='LAST USED  .'
CDLUSE   DFHMDF POS=(8,54),LENGTH=10,ATTRB=(PROT,NORM),PICOUT='X(10)'
         DFHMDF POS=(9,2),LENGTH=13,ATTRB=(ASKIP,NORM),                X
               INITIAL='BLOCK REASON.'
CDBLKR   DFHMDF POS=(9,17),LENGTH=4,ATTRB=(PROT,NORM),PICOUT='X(4)'
CDBLKD   DFHMDF POS=(9,24),LENGTH=10,ATTRB=(PROT,NORM),PICOUT='X(10)'
         DFHMDF POS=(9,40),LENGTH=12,ATTRB=(ASKIP,NORM),               X
               INITIAL='PIN TRIES  .'
CDPIN    DFHMDF POS=(9,54),LENGTH=1,ATTRB=(PROT,NORM),PICOUT='X'
         DFHMDF POS=(11,2),LENGTH=25,ATTRB=(ASKIP,NORM),               X
               INITIAL='LIMIT TYPE   LIMIT AMOUNT'
         DFHMDF POS=(11,32),LENGTH=26,ATTRB=(ASKIP,NORM),              X
               INITIAL='USED AMOUNT      AVAILABLE'
         DFHMDF POS=(12,2),LENGTH=29,ATTRB=(ASKIP,NORM),               X
               INITIAL='------------ ----------------'
         DFHMDF POS=(12,32),LENGTH=33,ATTRB=(ASKIP,NORM),              X
               INITIAL='---------------- ----------------'
CDLTYP   DFHMDF POS=(13,2),LENGTH=12,ATTRB=(PROT,NORM),OCCURS=4,       X
               PICOUT='X(12)'
CDLLIM   DFHMDF POS=(13,15),LENGTH=16,ATTRB=(PROT,NORM),OCCURS=4,      X
               PICOUT='X(16)'
CDLUSD   DFHMDF POS=(13,32),LENGTH=16,ATTRB=(PROT,NORM),OCCURS=4,      X
               PICOUT='X(16)'
CDLAVL   DFHMDF POS=(13,49),LENGTH=16,ATTRB=(PROT,NORM),OCCURS=4,      X
               PICOUT='X(16)'
         DFHMDF POS=(18,2),LENGTH=3,ATTRB=(ASKIP,NORM),INITIAL='APR'
CDAPR    DFHMDF POS=(18,6),LENGTH=10,ATTRB=(PROT,NORM),PICOUT='X(10)'
         DFHMDF POS=(18,20),LENGTH=8,ATTRB=(ASKIP,NORM),               X
               INITIAL='CASH APR'
CDCAPR   DFHMDF POS=(18,30),LENGTH=10,ATTRB=(PROT,NORM),PICOUT='X(10)'
         DFHMDF POS=(18,44),LENGTH=9,ATTRB=(ASKIP,NORM),               X
               INITIAL='RISK BAND'
CDBAND   DFHMDF POS=(18,54),LENGTH=1,ATTRB=(PROT,NORM),PICOUT='X'
CDMSG    DFHMDF POS=(21,2),LENGTH=60,ATTRB=(PROT,BRT),PICOUT='X(60)'
         DFHMDF POS=(23,2),LENGTH=34,ATTRB=(ASKIP,NORM),               X
               INITIAL='ENTER=INQUIRE  PF3=MENU  PF12=EXIT'
*
***********************************************************************
* CARDAUT - AUTHORIZATION REQUEST ENTRY (CACRD04)                     *
***********************************************************************
CARDAUT  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1,CTRL=(FREEKB,FRSET)
         DFHMDF POS=(1,1),LENGTH=4,ATTRB=(ASKIP,NORM),INITIAL='CA00'
         DFHMDF POS=(1,24),LENGTH=21,ATTRB=(ASKIP,NORM),               X
               INITIAL='AUTHORIZATION REQUEST'
