AUODT    DFHMDF POS=(18,21),LENGTH=6,ATTRB=(UNPROT,NUM,NORM),          X
               PICIN='X(6)',PICOUT='X(6)'
         DFHMDF POS=(18,28),LENGTH=1,ATTRB=(ASKIP,NORM),INITIAL=' '
AUMSG    DFHMDF POS=(21,2),LENGTH=60,ATTRB=(PROT,BRT),PICOUT='X(60)'
         DFHMDF POS=(23,2),LENGTH=33,ATTRB=(ASKIP,NORM),               X
               INITIAL='ENTER=SUBMIT  PF3=MENU  PF12=EXIT'
*
***********************************************************************
* CARDRSP - AUTHORIZATION OUTCOME (CACRD10)                           *
***********************************************************************
CARDRSP  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1,CTRL=(FREEKB,FRSET)
         DFHMDF POS=(1,1),LENGTH=4,ATTRB=(ASKIP,NORM),INITIAL='CA00'
         DFHMDF POS=(1,24),LENGTH=22,ATTRB=(ASKIP,NORM),               X
               INITIAL='AUTHORIZATION RESPONSE'
ARDATE   DFHMDF POS=(1,66),LENGTH=8,ATTRB=(PROT,NORM),PICOUT='X(8)'
         DFHMDF POS=(3,2),LENGTH=17,ATTRB=(ASKIP,NORM),                X
               INITIAL='CARD NUMBER . . .'
ARCARD   DFHMDF POS=(3,21),LENGTH=16,ATTRB=(PROT,NORM),PICOUT='X(16)'
         DFHMDF POS=(4,2),LENGTH=17,ATTRB=(ASKIP,NORM),                X
               INITIAL='ACCOUNT . . . . .'
ARACCT   DFHMDF POS=(4,21),LENGTH=11,ATTRB=(PROT,NORM),PICOUT='X(11)'
         DFHMDF POS=(5,2),LENGTH=17,ATTRB=(ASKIP,NORM),                X
               INITIAL='AMOUNT  . . . . .'
ARAMT    DFHMDF POS=(5,21),LENGTH=16,ATTRB=(PROT,NORM),PICOUT='X(16)'
ARCURR   DFHMDF POS=(5,39),LENGTH=3,ATTRB=(PROT,NORM),PICOUT='X(3)'
         DFHMDF POS=(7,2),LENGTH=17,ATTRB=(ASKIP,NORM),                X
               INITIAL='DECISION  . . . .'
ARDEC    DFHMDF POS=(7,21),LENGTH=1,ATTRB=(PROT,BRT),PICOUT='X'
ARDECD   DFHMDF POS=(7,24),LENGTH=10,ATTRB=(PROT,BRT),PICOUT='X(10)'
         DFHMDF POS=(8,2),LENGTH=17,ATTRB=(ASKIP,NORM),                X
               INITIAL='RESPONSE CODE . .'
ARRESP   DFHMDF POS=(8,21),LENGTH=2,ATTRB=(PROT,BRT),PICOUT='X(2)'
         DFHMDF POS=(9,2),LENGTH=17,ATTRB=(ASKIP,NORM),                X
               INITIAL='REASON CODE . . .'
ARRSN    DFHMDF POS=(9,21),LENGTH=4,ATTRB=(PROT,BRT),PICOUT='X(4)'
ARRSND   DFHMDF POS=(9,27),LENGTH=40,ATTRB=(PROT,NORM),PICOUT='X(40)'
         DFHMDF POS=(10,2),LENGTH=17,ATTRB=(ASKIP,NORM),               X
               INITIAL='AUTH SEQ NUMBER .'
ARSEQ    DFHMDF POS=(10,21),LENGTH=9,ATTRB=(PROT,NORM),PICOUT='X(9)'
         DFHMDF POS=(12,2),LENGTH=17,ATTRB=(ASKIP,NORM),               X
               INITIAL='RISK SCORE / BAND'
ARSCOR   DFHMDF POS=(12,21),LENGTH=3,ATTRB=(PROT,NORM),PICOUT='X(3)'
ARBAND   DFHMDF POS=(12,26),LENGTH=1,ATTRB=(PROT,NORM),PICOUT='X'
ARADV    DFHMDF POS=(12,30),LENGTH=4,ATTRB=(PROT,NORM),PICOUT='X(4)'
         DFHMDF POS=(13,2),LENGTH=17,ATTRB=(ASKIP,NORM),               X
               INITIAL='FRAUD SCORE / ACT'
ARFSCR   DFHMDF POS=(13,21),LENGTH=3,ATTRB=(PROT,NORM),PICOUT='X(3)'
ARFACT   DFHMDF POS=(13,26),LENGTH=4,ATTRB=(PROT,NORM),PICOUT='X(4)'
ARFRUL   DFHMDF POS=(13,32),LENGTH=8,ATTRB=(PROT,NORM),PICOUT='X(8)'
         DFHMDF POS=(14,2),LENGTH=17,ATTRB=(ASKIP,NORM),               X
               INITIAL='LIMIT TYPE / AVL '
ARLTYP   DFHMDF POS=(14,21),LENGTH=4,ATTRB=(PROT,NORM),PICOUT='X(4)'
ARLAVL   DFHMDF POS=(14,27),LENGTH=16,ATTRB=(PROT,NORM),PICOUT='X(16)'
         DFHMDF POS=(15,2),LENGTH=17,ATTRB=(ASKIP,NORM),               X
               INITIAL='VELOCITY COUNT  .'
ARVEL    DFHMDF POS=(15,21),LENGTH=3,ATTRB=(PROT,NORM),PICOUT='X(3)'
ARMSG    DFHMDF POS=(21,2),LENGTH=60,ATTRB=(PROT,BRT),PICOUT='X(60)'
         DFHMDF POS=(23,2),LENGTH=38,ATTRB=(ASKIP,NORM),               X
               INITIAL='ENTER=NEW REQUEST  PF3=MENU  PF12=EXIT'
*
***********************************************************************
* CARDERR - DIAGNOSTIC SCREEN (CACRD91)                               *
***********************************************************************
CARDERR  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1,CTRL=(FREEKB,FRSET)
         DFHMDF POS=(1,1),LENGTH=4,ATTRB=(ASKIP,NORM),INITIAL='CA00'
         DFHMDF POS=(1,27),LENGTH=17,ATTRB=(ASKIP,NORM),               X
               INITIAL='SYSTEM DIAGNOSTIC'
ERDATE   DFHMDF POS=(1,66),LENGTH=8,ATTRB=(PROT,NORM),PICOUT='X(8)'
         DFHMDF POS=(3,2),LENGTH=45,ATTRB=(ASKIP,NORM),                X
               INITIAL='AN ERROR HAS OCCURRED - NOTE THE DETAIL BELOW'
         DFHMDF POS=(3,48),LENGTH=16,ATTRB=(ASKIP,NORM),               X
               INITIAL='AND CALL SUPPORT'
         DFHMDF POS=(5,2),LENGTH=13,ATTRB=(ASKIP,NORM),                X
               INITIAL='PROGRAM . . .'
ERPGM    DFHMDF POS=(5,18),LENGTH=8,ATTRB=(PROT,BRT),PICOUT='X(8)'
         DFHMDF POS=(5,40),LENGTH=12,ATTRB=(ASKIP,NORM),               X
               INITIAL='SEVERITY . .'
ERSEV    DFHMDF POS=(5,54),LENGTH=1,ATTRB=(PROT,BRT),PICOUT='X'
         DFHMDF POS=(6,2),LENGTH=13,ATTRB=(ASKIP,NORM),                X
               INITIAL='PARAGRAPH . .'
ERPARA   DFHMDF POS=(6,18),LENGTH=30,ATTRB=(PROT,NORM),PICOUT='X(30)'
         DFHMDF POS=(7,2),LENGTH=13,ATTRB=(ASKIP,NORM),                X
               INITIAL='ERROR TYPE  .'
ERTYPE   DFHMDF POS=(7,18),LENGTH=4,ATTRB=(PROT,NORM),PICOUT='X(4)'
         DFHMDF POS=(7,40),LENGTH=12,ATTRB=(ASKIP,NORM),               X
               INITIAL='REASON . . .'
ERRSN    DFHMDF POS=(7,54),LENGTH=4,ATTRB=(PROT,NORM),PICOUT='X(4)'
         DFHMDF POS=(9,2),LENGTH=13,ATTRB=(ASKIP,NORM),                X
               INITIAL='SQLCODE . . .'
ERSQLC   DFHMDF POS=(9,18),LENGTH=11,ATTRB=(PROT,NORM),PICOUT='X(11)'
         DFHMDF POS=(9,40),LENGTH=12,ATTRB=(ASKIP,NORM),               X
               INITIAL='SQLSTATE . .'
ERSQLS   DFHMDF POS=(9,54),LENGTH=5,ATTRB=(PROT,NORM),PICOUT='X(5)'
         DFHMDF POS=(10,2),LENGTH=13,ATTRB=(ASKIP,NORM),               X
               INITIAL='TABLE . . . .'
ERTAB    DFHMDF POS=(10,18),LENGTH=18,ATTRB=(PROT,NORM),PICOUT='X(18)'
         DFHMDF POS=(11,2),LENGTH=13,ATTRB=(ASKIP,NORM),               X
               INITIAL='EIBRESP . . .'
ERRESP   DFHMDF POS=(11,18),LENGTH=11,ATTRB=(PROT,NORM),PICOUT='X(11)'
         DFHMDF POS=(11,40),LENGTH=12,ATTRB=(ASKIP,NORM),              X
               INITIAL='EIBRESP2 . .'
ERRES2   DFHMDF POS=(11,54),LENGTH=11,ATTRB=(PROT,NORM),PICOUT='X(11)'
         DFHMDF POS=(12,2),LENGTH=13,ATTRB=(ASKIP,NORM),               X
               INITIAL='FILE / STATUS'
ERFILE   DFHMDF POS=(12,18),LENGTH=8,ATTRB=(PROT,NORM),PICOUT='X(8)'
ERFSTA   DFHMDF POS=(12,28),LENGTH=2,ATTRB=(PROT,NORM),PICOUT='X(2)'
         DFHMDF POS=(13,2),LENGTH=13,ATTRB=(ASKIP,NORM),               X
               INITIAL='VSAM KEY  . .'
ERKEY    DFHMDF POS=(13,18),LENGTH=32,ATTRB=(PROT,NORM),PICOUT='X(32)'
         DFHMDF POS=(15,2),LENGTH=13,ATTRB=(ASKIP,NORM),               X
               INITIAL='MESSAGE . . .'
ERMSG    DFHMDF POS=(15,18),LENGTH=60,ATTRB=(PROT,BRT),PICOUT='X(60)'
         DFHMDF POS=(17,2),LENGTH=13,ATTRB=(ASKIP,NORM),               X
               INITIAL='TIMESTAMP . .'
ERTIME   DFHMDF POS=(17,18),LENGTH=26,ATTRB=(PROT,NORM),PICOUT='X(26)'
         DFHMDF POS=(18,2),LENGTH=13,ATTRB=(ASKIP,NORM),               X
               INITIAL='TRAN / TERM .'
ERTRAN   DFHMDF POS=(18,18),LENGTH=4,ATTRB=(PROT,NORM),PICOUT='X(4)'
ERTERM   DFHMDF POS=(18,24),LENGTH=4,ATTRB=(PROT,NORM),PICOUT='X(4)'
ERINST   DFHMDF POS=(21,2),LENGTH=60,ATTRB=(PROT,BRT),PICOUT='X(60)'
         DFHMDF POS=(23,2),LENGTH=19,ATTRB=(ASKIP,NORM),               X
               INITIAL='PF3=MENU  PF12=EXIT'
*
***********************************************************************
* CARDBYE - SESSION TERMINATED (CACRD17)                              *
***********************************************************************
CARDBYE  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1,CTRL=(FREEKB,FRSET)
         DFHMDF POS=(1,1),LENGTH=4,ATTRB=(ASKIP,NORM),INITIAL='CA00'
         DFHMDF POS=(1,26),LENGTH=21,ATTRB=(ASKIP,NORM),               X
               INITIAL='CARD SERVICING SYSTEM'
         DFHMDF POS=(10,20),LENGTH=18,ATTRB=(ASKIP,NORM),              X
               INITIAL='SESSION TERMINATED'
         DFHMDF POS=(12,20),LENGTH=8,ATTRB=(ASKIP,NORM),               X
               INITIAL='OPERATOR'
BYOPER   DFHMDF POS=(12,30),LENGTH=8,ATTRB=(PROT,NORM),PICOUT='X(8)'
         DFHMDF POS=(13,20),LENGTH=8,ATTRB=(ASKIP,NORM),               X
               INITIAL='TERMINAL'
BYTERM   DFHMDF POS=(13,30),LENGTH=4,ATTRB=(PROT,NORM),PICOUT='X(4)'
         DFHMDF POS=(14,20),LENGTH=12,ATTRB=(ASKIP,NORM),              X
               INITIAL='SCREENS USED'
BYCNT    DFHMDF POS=(14,34),LENGTH=3,ATTRB=(PROT,NORM),PICOUT='X(3)'
         DFHMDF POS=(15,20),LENGTH=8,ATTRB=(ASKIP,NORM),               X
               INITIAL='ENDED AT'
BYTIME   DFHMDF POS=(15,30),LENGTH=8,ATTRB=(PROT,NORM),PICOUT='X(8)'
BYMSG    DFHMDF POS=(18,10),LENGTH=60,ATTRB=(PROT,BRT),PICOUT='X(60)'
         DFHMDF POS=(22,10),LENGTH=37,ATTRB=(ASKIP,NORM),              X
               INITIAL='CLEAR THE SCREEN AND ENTER A NEW TRAN'
         DFHMSD TYPE=FINAL
         END
