         DFHMDF POS=(8,37),LENGTH=1,ATTRB=(ASKIP,NORM),INITIAL=' '
         DFHMDF POS=(9,2),LENGTH=17,ATTRB=(ASKIP,NORM),                X
               INITIAL='MERCHANT COUNTRY.'
