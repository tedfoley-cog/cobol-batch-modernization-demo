         DFHMDF POS=(3,2),LENGTH=17,ATTRB=(ASKIP,NORM),                X
               INITIAL='CARD NUMBER . . .'
AUCARD   DFHMDF POS=(3,21),LENGTH=16,ATTRB=(UNPROT,NORM,IC),           X
               PICIN='X(16)',PICOUT='X(16)'
         DFHMDF POS=(3,38),LENGTH=1,ATTRB=(ASKIP,NORM),INITIAL=' '
         DFHMDF POS=(4,2),LENGTH=17,ATTRB=(ASKIP,NORM),                X
               INITIAL='AUTH TYPE P/C/R .'
AUTYPE   DFHMDF POS=(4,21),LENGTH=1,ATTRB=(UNPROT,NORM),PICIN='X',     X
               PICOUT='X'
         DFHMDF POS=(4,23),LENGTH=1,ATTRB=(ASKIP,NORM),INITIAL=' '
         DFHMDF POS=(5,2),LENGTH=17,ATTRB=(ASKIP,NORM),                X
               INITIAL='AMOUNT  . . . . .'
AUAMT    DFHMDF POS=(5,21),LENGTH=13,ATTRB=(UNPROT,NORM),PICIN='X(13)',X
               PICOUT='X(13)'
         DFHMDF POS=(5,35),LENGTH=1,ATTRB=(ASKIP,NORM),INITIAL=' '
         DFHMDF POS=(6,2),LENGTH=17,ATTRB=(ASKIP,NORM),                X
               INITIAL='CURRENCY  . . . .'
