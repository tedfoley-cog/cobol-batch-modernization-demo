         DFHMDF POS=(14,2),LENGTH=17,ATTRB=(ASKIP,NORM),               X
               INITIAL='ATM ID  . . . . .'
AUATM    DFHMDF POS=(14,21),LENGTH=8,ATTRB=(UNPROT,NORM),PICIN='X(8)', X
               PICOUT='X(8)'
         DFHMDF POS=(14,30),LENGTH=1,ATTRB=(ASKIP,NORM),INITIAL=' '
