               INITIAL='NETWORK . . . . .'
AUNET    DFHMDF POS=(15,21),LENGTH=4,ATTRB=(UNPROT,NORM),PICIN='X(4)', X
               PICOUT='X(4)'
         DFHMDF POS=(15,26),LENGTH=1,ATTRB=(ASKIP,NORM),INITIAL=' '
         DFHMDF POS=(16,2),LENGTH=11,ATTRB=(ASKIP,NORM),               X
               INITIAL='REFUND ONLY'
         DFHMDF POS=(17,2),LENGTH=17,ATTRB=(ASKIP,NORM),               X
               INITIAL='ORIGINAL AUTH ID.'
AUOAUT   DFHMDF POS=(17,21),LENGTH=12,ATTRB=(UNPROT,NORM),             X
