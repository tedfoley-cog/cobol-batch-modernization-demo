               PICOUT='X(3)'
         DFHMDF POS=(6,25),LENGTH=1,ATTRB=(ASKIP,NORM),INITIAL=' '
         DFHMDF POS=(7,2),LENGTH=17,ATTRB=(ASKIP,NORM),                X
               INITIAL='MCC . . . . . . .'
AUMCC    DFHMDF POS=(7,21),LENGTH=4,ATTRB=(UNPROT,NUM,NORM),           X
               PICIN='X(4)',PICOUT='X(4)'
         DFHMDF POS=(7,26),LENGTH=1,ATTRB=(ASKIP,NORM),INITIAL=' '
         DFHMDF POS=(8,2),LENGTH=17,ATTRB=(ASKIP,NORM),                X
               INITIAL='MERCHANT ID . . .'
AUMRCH   DFHMDF POS=(8,21),LENGTH=15,ATTRB=(UNPROT,NORM),PICIN='X(15)',X
