{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tedfoley-cog.github.io/cobol-batch-modernization-demo/schemas/migration-plan.json",
  "title": "Modernization migration plan",
  "description": "Sequenced, sign-off ready session-sized modernization chunks.",
  "type": "object",
  "required": [
    "chunks",
    "meta"
  ],
  "properties": {
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/chunk"
      }
    },
    "meta": {
      "$ref": "#/$defs/meta"
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": [
        "path",
        "line_start",
        "line_end",
        "snippet_sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "Path under legacy/."
        },
        "member": {
          "type": "string"
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "paragraph": {
          "type": "string"
        },
        "snippet_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "chunk": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "sequence_within_category",
        "cross_category_dependencies",
        "cutover_wave",
        "fr_ids",
        "evidence",
        "target_design",
        "risks",
        "verification_plan",
        "sign_off",
        "program"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Chunk id.",
          "examples": [
            "CH-SETL-01"
          ]
        },
        "name": {
          "type": "string",
          "description": "Session-sized unit."
        },
        "category": {
          "type": "string",
          "enum": [
            "foundation",
            "like_to_like",
            "new_design",
            "depend_on_new"
          ]
        },
        "sequence_within_category": {
          "type": "integer",
          "minimum": 1
        },
        "cross_category_dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cutover_wave": {
          "type": "string"
        },
        "fr_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        },
        "target_design": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "cobol_construct",
              "target_idiom"
            ],
            "properties": {
              "cobol_construct": {
                "type": "string",
                "description": "Legacy construct."
              },
              "target_idiom": {
                "type": "string",
                "description": "Java 17/Spring Batch idiom.",
                "examples": [
                  "cursor WITH HOLD \u2192 JdbcCursorItemReader + chunk commit"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verification_plan": {
          "type": "object",
          "required": [
            "method",
            "acceptance_criteria"
          ],
          "properties": {
            "method": {
              "type": "string"
            },
            "acceptance_criteria": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        "sign_off": {
          "type": "object",
          "required": [
            "status",
            "owner"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "approved",
                "rejected"
              ]
            },
            "owner": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "program": {
          "type": "string",
          "description": "Program migrated by this chunk."
        }
      },
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "required": [
        "schema_version",
        "profile",
        "estate_pin",
        "generator"
      ],
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "estate_pin": {
          "type": "string"
        },
        "generator": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
