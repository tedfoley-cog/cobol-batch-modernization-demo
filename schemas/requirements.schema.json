{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tedfoley-cog.github.io/cobol-batch-modernization-demo/schemas/requirements.json",
  "title": "Modernization requirements and data layer",
  "description": "EARS requirements, ISO quality requirements, and source-to-target data semantics.",
  "type": "object",
  "required": [
    "functional_requirements",
    "business_rules",
    "data_elements",
    "error_paths",
    "nonfunctional_requirements",
    "data_layer",
    "open_questions",
    "assumptions",
    "glossary",
    "meta"
  ],
  "properties": {
    "functional_requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fr"
      },
      "minItems": 1
    },
    "business_rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "data_elements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/element"
      }
    },
    "error_paths": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/error"
      }
    },
    "nonfunctional_requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nfr"
      },
      "minItems": 1
    },
    "data_layer": {
      "$ref": "#/$defs/data_layer"
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "glossary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "term",
          "definition"
        ],
        "properties": {
          "term": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "meta": {
      "$ref": "#/$defs/meta"
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": [
        "path",
        "line_start",
        "line_end",
        "snippet_sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "Path under legacy/ or artifacts/generated/.",
          "examples": [
            "cobol/TRDPB001"
          ]
        },
        "member": {
          "type": "string",
          "description": "Source member."
        },
        "line_start": {
          "type": "integer",
          "minimum": 1,
          "description": "First line."
        },
        "line_end": {
          "type": "integer",
          "minimum": 1,
          "description": "Last line."
        },
        "paragraph": {
          "type": "string",
          "description": "COBOL paragraph."
        },
        "snippet_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Hash of exact source lines."
        },
        "provenance": {
          "type": "string",
          "enum": [
            "generated"
          ],
          "description": "Required when path points under artifacts/generated/."
        }
      },
      "additionalProperties": false
    },
    "confidence": {
      "type": "object",
      "required": [
        "score",
        "basis"
      ],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence from 0 to 1.",
          "examples": [
            0.95
          ]
        },
        "basis": {
          "type": "string",
          "description": "Why this score is justified."
        }
      },
      "additionalProperties": false
    },
    "sme": {
      "type": "object",
      "required": [
        "status",
        "reviewer",
        "questions"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "rejected",
            "needs_info"
          ],
          "description": "Review state."
        },
        "reviewer": {
          "type": "string",
          "description": "Reviewer identity or role."
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": [
        "method",
        "acceptance_criteria",
        "oracle"
      ],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "inspection",
            "analysis",
            "demonstration",
            "test"
          ],
          "description": "Verification method."
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "oracle": {
          "type": "object",
          "required": [
            "dataset_table",
            "fields",
            "tolerance"
          ],
          "properties": {
            "dataset_table": {
              "type": "string"
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tolerance": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "fr": {
      "type": "object",
      "required": [
        "id",
        "statement",
        "ears",
        "migration_category",
        "verification",
        "iso29148_characteristics",
        "confidence",
        "sme_review",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable FR identifier.",
          "examples": [
            "FR-SETL-001"
          ]
        },
        "statement": {
          "type": "string",
          "description": "Constrained EARS sentence.",
          "examples": [
            "When a settlement run starts, the system shall read eligible queue entries."
          ]
        },
        "ears": {
          "type": "object",
          "required": [
            "pattern",
            "preconditions",
            "trigger",
            "system_name",
            "system_response"
          ],
          "properties": {
            "pattern": {
              "type": "string",
              "enum": [
                "ubiquitous",
                "state_driven",
                "event_driven",
                "optional_feature",
                "unwanted_behaviour",
                "complex"
              ]
            },
            "preconditions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "trigger": {
              "type": "string"
            },
            "system_name": {
              "type": "string"
            },
            "system_response": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        "migration_category": {
          "type": "string",
          "enum": [
            "foundation",
            "like_to_like",
            "new_design",
            "depend_on_new"
          ]
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "iso29148_characteristics": {
          "type": "object",
          "required": [
            "necessary",
            "appropriate",
            "unambiguous",
            "complete",
            "singular",
            "feasible",
            "verifiable",
            "correct",
            "conforming"
          ],
          "properties": {
            "necessary": {
              "type": "object",
              "required": [
                "value",
                "notes"
              ],
              "properties": {
                "value": {
                  "type": "boolean"
                },
                "notes": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "appropriate": {
              "$ref": "#/$defs/quality"
            },
            "unambiguous": {
              "$ref": "#/$defs/quality"
            },
            "complete": {
              "$ref": "#/$defs/quality"
            },
            "singular": {
              "$ref": "#/$defs/quality"
            },
            "feasible": {
              "$ref": "#/$defs/quality"
            },
            "verifiable": {
              "$ref": "#/$defs/quality"
            },
            "correct": {
              "$ref": "#/$defs/quality"
            },
            "conforming": {
              "$ref": "#/$defs/quality"
            }
          },
          "additionalProperties": false
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "sme_review": {
          "$ref": "#/$defs/sme"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "required": [
        "value",
        "notes"
      ],
      "properties": {
        "value": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": [
        "id",
        "conditions",
        "outcome",
        "source_paragraph",
        "evidence",
        "fr_ids"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "when",
              "value"
            ],
            "properties": {
              "when": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "outcome": {
          "type": "string"
        },
        "source_paragraph": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "fr_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Functional requirements justified by this claim."
        }
      },
      "additionalProperties": false
    },
    "element": {
      "type": "object",
      "required": [
        "copybook",
        "field",
        "picture",
        "usage",
        "scale",
        "sign",
        "fr_ids",
        "evidence"
      ],
      "properties": {
        "copybook": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "picture": {
          "type": "string"
        },
        "usage": {
          "type": "string"
        },
        "scale": {
          "type": "integer"
        },
        "sign": {
          "type": "string"
        },
        "fr_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Functional requirements justified by this claim."
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": [
        "condition",
        "handling",
        "evidence",
        "fr_ids"
      ],
      "properties": {
        "condition": {
          "type": "string"
        },
        "handling": {
          "type": "string"
        },
        "sqlcode": {
          "type": "string"
        },
        "reject_code": {
          "type": "string"
        },
        "rc_abend": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "fr_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Functional requirements justified by this claim."
        }
      },
      "additionalProperties": false
    },
    "nfr": {
      "type": "object",
      "required": [
        "id",
        "characteristic",
        "subcharacteristic",
        "measure",
        "derivation",
        "evidence",
        "verification"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "characteristic": {
          "type": "string",
          "enum": [
            "functional_suitability",
            "performance_efficiency",
            "compatibility",
            "interaction_capability",
            "reliability",
            "security",
            "maintainability",
            "flexibility",
            "safety"
          ]
        },
        "subcharacteristic": {
          "type": "string"
        },
        "measure": {
          "type": "object",
          "required": [
            "metric",
            "target",
            "unit",
            "source"
          ],
          "properties": {
            "metric": {
              "type": "string"
            },
            "target": {
              "type": "string"
            },
            "unit": {
              "type": "string"
            },
            "source": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "derivation": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        },
        "verification": {
          "$ref": "#/$defs/verification"
        }
      },
      "additionalProperties": false
    },
    "data_layer": {
      "type": "object",
      "required": [
        "copybook_field_map",
        "db2_crud_matrix",
        "lineage",
        "decimal_semantics",
        "keys_indexes",
        "restart_semantics"
      ],
      "properties": {
        "copybook_field_map": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "copybook",
              "field",
              "table_column"
            ],
            "properties": {
              "copybook": {
                "type": "string"
              },
              "field": {
                "type": "string"
              },
              "table_column": {
                "type": "string"
              },
              "transform": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "db2_crud_matrix": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "program",
              "table",
              "operations"
            ],
            "properties": {
              "program": {
                "type": "string"
              },
              "table": {
                "type": "string"
              },
              "operations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "select",
                    "insert",
                    "update",
                    "delete"
                  ]
                }
              },
              "cursor_names": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "with_hold": {
                "type": "boolean"
              },
              "isolation": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "lineage": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source_field",
              "target_field",
              "transform"
            ],
            "properties": {
              "source_field": {
                "type": "string"
              },
              "target_field": {
                "type": "string"
              },
              "transform": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "decimal_semantics": {
          "type": "object",
          "required": [
            "digits",
            "scale",
            "sign_handling",
            "rounding"
          ],
          "properties": {
            "digits": {
              "type": "integer"
            },
            "scale": {
              "type": "integer"
            },
            "sign_handling": {
              "type": "string"
            },
            "rounding": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "keys_indexes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "table",
              "columns",
              "kind"
            ],
            "properties": {
              "table": {
                "type": "string"
              },
              "columns": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "kind": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "restart_semantics": {
          "type": "object",
          "required": [
            "checkpoint_interval",
            "commit_scope",
            "restart_key",
            "cursor_reposition"
          ],
          "properties": {
            "checkpoint_interval": {
              "type": "string"
            },
            "commit_scope": {
              "type": "string"
            },
            "restart_key": {
              "type": "string"
            },
            "cursor_reposition": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "required": [
        "schema_version",
        "profile",
        "estate_pin",
        "generator",
        "coverage"
      ],
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "estate_pin": {
          "type": "string"
        },
        "generator": {
          "type": "string"
        },
        "coverage": {
          "type": "object",
          "required": [
            "programs_cited",
            "paragraphs_cited"
          ],
          "properties": {
            "programs_cited": {
              "type": "number"
            },
            "paragraphs_cited": {
              "type": "number"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
