{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OEM batch profile",
  "description": "Customer profile tightening identifiers, confidence, and sign-off policy.",
  "min_confidence": 0.8,
  "id_patterns": {"fr": "^FR-[A-Z0-9]+-[0-9]{3}$", "nfr": "^NFR-[A-Z0-9]+-[0-9]{3}$", "chunk": "^CH-[A-Z0-9]+-[0-9]{2}$"},
  "required_meta": ["schema_version", "profile", "estate_pin", "generator", "coverage"],
  "require_sme_approval_for": ["new_design"],
  "coverage_thresholds": {"programs_cited": 80, "paragraphs_cited": 70}
}
