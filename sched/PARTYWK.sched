*======================================================================*
* PARTYWK.SCHED - PARTY AND RISK WEEKLY CYCLE                          *
*                                                                      *
* TABLE  PARTYWK                                                       *
* OWNER  PRTYBAT          GROUP PARTY-RISK-PROD                        *
* APPL   PARTYRSK                                                      *
*                                                                      *
* ORDERED EVERY SATURDAY.  OWNED AND OPERATED BY THE PARTY & RISK      *
* GROUP - FAILURES PAGE PRTYOPS, NOT THE CARD SYSTEMS ON CALL.         *
*                                                                      *
* THE CYCLE REFRESHES PARTY EXPOSURE, RESCREENS THE PARTY POPULATION   *
* AGAINST THE CONSOLIDATED WATCH LIST AND RESCORES EVERY ACTIVE        *
* PARTY.  IT MUST BE COMPLETE BEFORE THE REGULATORY EXTRACT ON         *
* SUNDAY EVENING.                                                      *
*======================================================================*

TABLE NAME=PARTYWK
      OWNER=PRTYBAT
      APPLICATION=PARTYRSK
      GROUP=PARTY-RISK-PROD
      DATACENTER=DCPROD1
      CALENDAR=WEEKSAT
      ORDER-METHOD=AUTO
      ORDER-TIME=06:00
      CYCLE-TYPE=PARTYWK
      DESC=WEEKLY PARTY EXPOSURE, SCREENING AND RISK RESCORE

*----------------------------------------------------------------------*
JOB NAME=CBPRT01J
    MEMLIB=PRTY.PROD.JCLLIB
    MEMNAME=CBPRT01J
    DESC=OPEN CYCLE AND REFRESH PARTY EXPOSURE FROM PRODUCT SYSTEMS
    OWNER=PRTYBAT
    NODE=DCPROD1
    TIME-FROM=07:00
    TIME-UNTIL=13:00
    MAXWAIT=1
    MAXRERUN=2
    RERUN-INTERVAL=00:10
    PRIORITY=75
    CRITICAL=Y
    IN-COND=CARDNITE-COMPLETE PREV
    OUT-COND=CBPRT01J-OK ODAT ADD
    ON-STMT=* CODE=OK
       DO-COND=CBPRT01J-OK ODAT ADD
    ON-STMT=* CODE=STALE
       DO-COND=CBPRT01J-OK ODAT ADD
       DO-NOTIFY=PRTYOPS URGENCY=REGULAR
                 MSG='PARTYWK CBPRT01J FEED STALE - EXPOSURE CARRIED'
    ON-STMT=* CODE=NOTOK
       DO-NOTIFY=PRTYOPS URGENCY=URGENT
                 MSG='PARTYWK CBPRT01J EXPOSURE REFRESH FAILED'
       DO-COND=PARTYWK-HELD ODAT ADD
       DO-STOPCYCLE
    RC-COND=(RC,EQ,0000) OK
    RC-COND=(RC,EQ,0004) STALE
    RC-COND=(RC,GE,0008) NOTOK
    ABEND-COND=U5001 NOTOK
    NOTE=THE IN-CONDITION IS ON THE PREVIOUS DAY'S NIGHTLY COMPLETION
         SO THE FRIDAY NIGHT POSITION IS USED.  IF THE FRIDAY CYCLE
         WAS HELD, EXPOSURE IS CARRIED FORWARD AND THE ROWS ARE
         FLAGGED STALE RATHER THAN THE CYCLE FAILING.
END-JOB

*----------------------------------------------------------------------*
JOB NAME=CBPRT02J
    MEMLIB=PRTY.PROD.JCLLIB
    MEMNAME=CBPRT02J
    DESC=LOAD SANCTIONS FEED AND REBUILD THE CONSOLIDATED WATCH LIST
    OWNER=PRTYBAT
    NODE=DCPROD1
    TIME-FROM=09:00
    TIME-UNTIL=15:00
    MAXWAIT=1
    MAXRERUN=2
    RERUN-INTERVAL=00:10
    PRIORITY=90
    CRITICAL=Y
    IN-COND=CBPRT01J-OK ODAT
    IN-COND=SANCTION-FEED-ARRIVED ODAT
    IN-COND-RELATION=AND
    OUT-COND=CBPRT02J-OK ODAT ADD
    OUT-COND=WATCHLST-REBUILT ODAT ADD
    ON-STMT=* CODE=OK
       DO-COND=CBPRT02J-OK ODAT ADD
       DO-COND=WATCHLST-REBUILT ODAT ADD
    ON-STMT=* CODE=DELTALARGE
       DO-NOTIFY=PRTYOPS URGENCY=VERYURGENT
                 MSG='PARTYWK CBPRT02J FEED DELTA OVER TOLERANCE'
       DO-COND=PARTYWK-HELD ODAT ADD
       DO-STOPCYCLE
    ON-STMT=* CODE=NOTOK
       DO-NOTIFY=PRTYOPS URGENCY=VERYURGENT
                 MSG='PARTYWK CBPRT02J WATCH LIST REBUILD FAILED'
       DO-COND=PARTYWK-HELD ODAT ADD
       DO-STOPCYCLE
    RC-COND=(RC,EQ,0000) OK
    RC-COND=(RC,EQ,0008) DELTALARGE
    RC-COND=(RC,GE,0012) NOTOK
    ABEND-COND=U5002 NOTOK
    NOTE=A DELTA OF MORE THAN 15 PERCENT OF THE LIST IS TREATED AS A
         BAD FEED.  THE EXISTING WATCH LIST IS LEFT IN PLACE AND THE
         CYCLE IS HELD FOR COMPLIANCE TO CONFIRM BEFORE ANY RERUN.
END-JOB

*----------------------------------------------------------------------*
JOB NAME=CBPRT03J
    MEMLIB=PRTY.PROD.JCLLIB
    MEMNAME=CBPRT03J
    DESC=RESCREEN THE ACTIVE PARTY POPULATION AGAINST THE WATCH LIST
    OWNER=PRTYBAT
    NODE=DCPROD1
    TIME-FROM=11:00
    TIME-UNTIL=19:00
    MAXWAIT=1
    MAXRERUN=1
    RERUN-INTERVAL=00:15
    PRIORITY=85
    CRITICAL=Y
    IN-COND=CBPRT02J-OK ODAT
    OUT-COND=CBPRT03J-OK ODAT ADD
    ON-STMT=* CODE=OK
       DO-COND=CBPRT03J-OK ODAT ADD
    ON-STMT=* CODE=HITS
       DO-COND=CBPRT03J-OK ODAT ADD
       DO-NOTIFY=PRTYOPS URGENCY=URGENT
                 MSG='PARTYWK CBPRT03J SANCTION HITS RAISED FOR REVIEW'
    ON-STMT=* CODE=NOTOK
       DO-NOTIFY=PRTYOPS URGENCY=VERYURGENT
                 MSG='PARTYWK CBPRT03J SCREENING FAILED - REG EXPOSURE'
       DO-COND=PARTYWK-HELD ODAT ADD
       DO-STOPCYCLE
    RC-COND=(RC,EQ,0000) OK
    RC-COND=(RC,EQ,0004) HITS
    RC-COND=(RC,GE,0008) NOTOK
    ABEND-COND=U5003 NOTOK
    NOTE=CHECKPOINT RESTARTABLE EVERY 1000 PARTIES.  HITS AND NEAR
         MISSES ARE WRITTEN TO THE REVIEW QUEUE - THE CYCLE DOES NOT
         WAIT FOR DISPOSITION.
END-JOB

*----------------------------------------------------------------------*
JOB NAME=CBPRT04J
    MEMLIB=PRTY.PROD.JCLLIB
    MEMNAME=CBPRT04J
    DESC=RESCORE ACTIVE PARTIES, WRITE AUDIT, CLOSE THE CYCLE
    OWNER=PRTYBAT
    NODE=DCPROD1
    TIME-FROM=14:00
    TIME-UNTIL=23:00
    MAXWAIT=0
    MAXRERUN=1
    RERUN-INTERVAL=00:15
    PRIORITY=80
    CRITICAL=Y
    IN-COND=CBPRT03J-OK ODAT
    OUT-COND=PARTYWK-COMPLETE ODAT ADD
    OUT-COND=RISK-SCORES-CURRENT ODAT ADD
    ON-STMT=* CODE=OK
       DO-COND=PARTYWK-COMPLETE ODAT ADD
       DO-COND=RISK-SCORES-CURRENT ODAT ADD
       DO-COND=CBPRT01J-OK ODAT DEL
       DO-COND=CBPRT02J-OK ODAT DEL
       DO-COND=CBPRT03J-OK ODAT DEL
    ON-STMT=* CODE=PARTIAL
       DO-COND=PARTYWK-COMPLETE ODAT ADD
       DO-NOTIFY=PRTYOPS URGENCY=URGENT
                 MSG='PARTYWK CBPRT04J PARTIAL RESCORE - MODEL DEFAULTS'
    ON-STMT=* CODE=NOTOK
       DO-NOTIFY=PRTYOPS URGENCY=VERYURGENT
                 MSG='PARTYWK CBPRT04J RESCORE FAILED'
       DO-COND=PARTYWK-HELD ODAT ADD
       DO-STOPCYCLE
    RC-COND=(RC,EQ,0000) OK
    RC-COND=(RC,EQ,0004) PARTIAL
    RC-COND=(RC,GE,0008) NOTOK
    ABEND-COND=U5004 NOTOK
    DUE-OUT=23:59
    ON-DUE-OUT-LATE
       DO-NOTIFY=PRTYOPS URGENCY=URGENT
                 MSG='PARTYWK LATE - SUNDAY REGULATORY EXTRACT AT RISK'
END-JOB

*======================================================================*
* OPERATOR NOTES                                                       *
*                                                                      *
* 1. PARTY & RISK ON CALL OWNS THIS TABLE.  DO NOT PAGE CARD SYSTEMS   *
*    FOR A PARTYWK FAILURE.                                            *
* 2. SANCTION-FEED-ARRIVED IS POSTED BY THE FILE WATCHER ON THE        *
*    VENDOR TRANSMISSION.  IF THE FEED HAS NOT ARRIVED BY 12:00 THE    *
*    WATCHER RAISES ITS OWN ALERT - DO NOT POST THE CONDITION BY HAND  *
*    TO GET THE CYCLE MOVING, THE LIST WOULD BE A WEEK OLD.            *
* 3. CBPRT03J IS THE LONGEST RUNNING JOB IN THE ESTATE.  IT IS         *
*    CHECKPOINTED - A RERUN AFTER AN ABEND RESUMES AT THE LAST         *
*    COMMITTED PARTY, IT DOES NOT RESCREEN FROM THE TOP.               *
* 4. U5002 WITH A DUMP TITLE OF 'FEED SEQ' MEANS THE VENDOR SENT THE   *
*    SAME GENERATION TWICE.  DELETE THE DUPLICATE AND RERUN.           *
*======================================================================*
