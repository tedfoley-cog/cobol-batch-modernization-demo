*======================================================================*
* CARDBILL.SCHED - CARD SERVICING BILLING AND STATEMENT CYCLE          *
*                                                                      *
* TABLE  CARDBILL                                                      *
* OWNER  CARDBAT          GROUP CARD-SYSTEMS-PROD                      *
* APPL   CARDSVC                                                       *
*                                                                      *
* ORDERED FOUR TIMES A MONTH, ONCE PER BILLING CYCLE DAY.  EACH ORDER  *
* CARRIES A DIFFERENT CYCLE PARAMETER AND PROCESSES ONLY THE ACCOUNTS  *
* WHOSE CYCLE_DAY MATCHES.  THE FOUR RUNS ARE INDEPENDENT OF EACH      *
* OTHER AND NEVER OVERLAP - THE CYCLE DAY CALENDARS IN                 *
* CALENDARS.SCHED GUARANTEE THAT.                                      *
*                                                                      *
* BILLING RUNS AFTER THE NIGHTLY CYCLE OF THE SAME DAY HAS CLOSED.     *
* STATEMENTS MUST BE HANDED TO THE PRINT AND E-DELIVERY VENDORS BY     *
* 07:00 OR THE MAILING SLA IS MISSED.                                  *
*======================================================================*

TABLE NAME=CARDBILL
      OWNER=CARDBAT
      APPLICATION=CARDSVC
      GROUP=CARD-SYSTEMS-PROD
      DATACENTER=DCPROD1
      ORDER-METHOD=AUTO
      ORDER-TIME=18:00
      CYCLE-TYPE=CARDBILL
      DESC=MONTHLY BILLING - ONE ORDER PER CYCLE DAY

*----------------------------------------------------------------------*
* CYCLE DAY SELECTION                                                  *
*                                                                      *
* THE TABLE IS ORDERED ONCE FOR EACH CALENDAR BELOW.  THE CYCLE        *
* PARAMETER IS PASSED TO EVERY JOB IN THE TABLE AS %%CYCLE AND         *
* RESOLVES INTO THE JCL SYMBOLIC CYCLE= ON THE EXEC STATEMENT.         *
*----------------------------------------------------------------------*

CYCLE-DEF NAME=CYCLE-01 CALENDAR=CYCLE03 PARM=%%CYCLE=01 CYCLE-DAY=03
CYCLE-DEF NAME=CYCLE-02 CALENDAR=CYCLE11 PARM=%%CYCLE=02 CYCLE-DAY=11
CYCLE-DEF NAME=CYCLE-03 CALENDAR=CYCLE18 PARM=%%CYCLE=03 CYCLE-DAY=18
CYCLE-DEF NAME=CYCLE-04 CALENDAR=CYCLE25 PARM=%%CYCLE=04 CYCLE-DAY=25

*----------------------------------------------------------------------*
JOB NAME=CBBIL01J
    MEMLIB=CARD.PROD.JCLLIB
    MEMNAME=CBBIL01J
    DESC=SELECT ACCOUNTS DUE THIS CYCLE, OPEN BILLING CONTROL RECORD
    OWNER=CARDBAT
    NODE=DCPROD1
    CALENDAR=CYCLE03,CYCLE11,CYCLE18,CYCLE25
    PARM=CYCLE=%%CYCLE
    TIME-FROM=22:00
    TIME-UNTIL=02:00
    MAXWAIT=1
    MAXRERUN=2
    RERUN-INTERVAL=00:05
    PRIORITY=85
    CRITICAL=Y
    IN-COND=CARDNITE-COMPLETE ODAT
    OUT-COND=CBBIL01J-OK ODAT ADD
    ON-STMT=* CODE=OK
       DO-COND=CBBIL01J-OK ODAT ADD
    ON-STMT=* CODE=NOACCTS
       DO-NOTIFY=CARDOPS URGENCY=VERYURGENT
                 MSG='CARDBILL CYCLE %%CYCLE SELECTED ZERO ACCOUNTS'
       DO-COND=CARDBILL-HELD ODAT ADD
       DO-STOPCYCLE
    ON-STMT=* CODE=NOTOK
       DO-NOTIFY=CARDOPS URGENCY=URGENT
                 MSG='CARDBILL CBBIL01J FAILED CYCLE %%CYCLE'
       DO-COND=CARDBILL-HELD ODAT ADD
       DO-STOPCYCLE
    RC-COND=(RC,EQ,0000) OK
    RC-COND=(RC,EQ,0004) NOACCTS
    RC-COND=(RC,GE,0008) NOTOK
    ABEND-COND=U4101 NOTOK
    NOTE=ZERO SELECTED ACCOUNTS IS TREATED AS AN ERROR.  A POPULATED
         CYCLE ALWAYS HAS ACCOUNTS - AN EMPTY SELECT MEANS THE CYCLE
         PARAMETER OR THE CALENDAR IS WRONG.
END-JOB

*----------------------------------------------------------------------*
JOB NAME=CBBIL02J
    MEMLIB=CARD.PROD.JCLLIB
    MEMNAME=CBBIL02J
    DESC=CLOSE BALANCES AND CALCULATE MINIMUM PAYMENT
    OWNER=CARDBAT
    NODE=DCPROD1
    CALENDAR=CYCLE03,CYCLE11,CYCLE18,CYCLE25
    PARM=CYCLE=%%CYCLE
    TIME-FROM=22:30
    TIME-UNTIL=03:00
    MAXWAIT=1
    MAXRERUN=1
    RERUN-INTERVAL=00:10
    PRIORITY=85
    CRITICAL=Y
    RESOURCE=CARDDB-POSTING QUANTITY=1
    IN-COND=CBBIL01J-OK ODAT
    OUT-COND=CBBIL02J-OK ODAT ADD
    ON-STMT=* CODE=OK
       DO-COND=CBBIL02J-OK ODAT ADD
    ON-STMT=* CODE=WARN
       DO-COND=CBBIL02J-OK ODAT ADD
       DO-NOTIFY=CARDOPS URGENCY=REGULAR
                 MSG='CARDBILL CBBIL02J ACCOUNTS BYPASSED - SEE REJECT'
    ON-STMT=* CODE=NOTOK
       DO-NOTIFY=CARDOPS URGENCY=URGENT
                 MSG='CARDBILL CBBIL02J BALANCE CLOSE FAILED'
       DO-COND=CARDBILL-HELD ODAT ADD
       DO-STOPCYCLE
    RC-COND=(RC,EQ,0000) OK
    RC-COND=(RC,EQ,0004) WARN
    RC-COND=(RC,GE,0008) NOTOK
    ABEND-COND=U4102 NOTOK
END-JOB

*----------------------------------------------------------------------*
JOB NAME=CBBIL03J
    MEMLIB=CARD.PROD.JCLLIB
    MEMNAME=CBBIL03J
    DESC=BUILD STATEMENT LINE DETAIL FROM POSTED TRANSACTIONS
    OWNER=CARDBAT
    NODE=DCPROD1
    CALENDAR=CYCLE03,CYCLE11,CYCLE18,CYCLE25
    PARM=CYCLE=%%CYCLE
    TIME-FROM=23:15
    TIME-UNTIL=04:00
    MAXWAIT=1
    MAXRERUN=2
    RERUN-INTERVAL=00:05
    PRIORITY=75
    IN-COND=CBBIL02J-OK ODAT
    OUT-COND=CBBIL03J-OK ODAT ADD
    ON-STMT=* CODE=OK
       DO-COND=CBBIL03J-OK ODAT ADD
    ON-STMT=* CODE=NOTOK
       DO-NOTIFY=CARDOPS URGENCY=URGENT
                 MSG='CARDBILL CBBIL03J STATEMENT DETAIL FAILED'
       DO-COND=CARDBILL-HELD ODAT ADD
       DO-STOPCYCLE
    RC-COND=(RC,LE,0004) OK
    RC-COND=(RC,GE,0008) NOTOK
    ABEND-COND=U4103 NOTOK
    NOTE=THE STATEMENT ARCHIVE IS RECFM=VB.  A RERUN MUST START FROM
         AN EMPTY GENERATION - THE JCL DELETES THE +1 GDG BEFORE
         REWRITING.
END-JOB

*----------------------------------------------------------------------*
JOB NAME=CBBIL04J
    MEMLIB=CARD.PROD.JCLLIB
    MEMNAME=CBBIL04J
    DESC=FORMAT STATEMENTS FOR PRINT AND ELECTRONIC DELIVERY
    OWNER=CARDBAT
    NODE=DCPROD1
    CALENDAR=CYCLE03,CYCLE11,CYCLE18,CYCLE25
    PARM=CYCLE=%%CYCLE
    TIME-FROM=00:30
    TIME-UNTIL=05:00
    MAXWAIT=1
    MAXRERUN=2
    RERUN-INTERVAL=00:05
    PRIORITY=75
    CRITICAL=Y
    IN-COND=CBBIL03J-OK ODAT
    OUT-COND=CBBIL04J-OK ODAT ADD
    ON-STMT=* CODE=OK
       DO-COND=CBBIL04J-OK ODAT ADD
    ON-STMT=* CODE=WARN
       DO-COND=CBBIL04J-OK ODAT ADD
       DO-NOTIFY=CARDOPS URGENCY=REGULAR
                 MSG='CARDBILL CBBIL04J FORMAT FALLBACK USED FOR SOME'
    ON-STMT=* CODE=NOTOK
       DO-NOTIFY=CARDOPS URGENCY=URGENT
                 MSG='CARDBILL CBBIL04J FORMATTING FAILED'
       DO-COND=CARDBILL-HELD ODAT ADD
       DO-STOPCYCLE
    RC-COND=(RC,EQ,0000) OK
    RC-COND=(RC,EQ,0004) WARN
    RC-COND=(RC,GE,0008) NOTOK
    ABEND-COND=U4104 NOTOK
END-JOB

*----------------------------------------------------------------------*
JOB NAME=CBBIL05J
    MEMLIB=CARD.PROD.JCLLIB
    MEMNAME=CBBIL05J
    DESC=CREATE PRINT AND E-DELIVERY VENDOR FILES, TRANSMIT
    OWNER=CARDBAT
    NODE=DCPROD1
    CALENDAR=CYCLE03,CYCLE11,CYCLE18,CYCLE25
    PARM=CYCLE=%%CYCLE
    TIME-FROM=02:00
    TIME-UNTIL=06:30
    MAXWAIT=1
    MAXRERUN=3
    RERUN-INTERVAL=00:10
    PRIORITY=90
    CRITICAL=Y
    IN-COND=CBBIL04J-OK ODAT
    OUT-COND=CBBIL05J-OK ODAT ADD
    OUT-COND=STMT-VENDOR-SENT ODAT ADD
    ON-STMT=* CODE=OK
       DO-COND=CBBIL05J-OK ODAT ADD
       DO-COND=STMT-VENDOR-SENT ODAT ADD
    ON-STMT=* CODE=XMITFAIL
       DO-NOTIFY=CARDOPS URGENCY=VERYURGENT
                 MSG='CARDBILL CBBIL05J TRANSMISSION FAILED - SLA RISK'
       DO-COND=CARDBILL-HELD ODAT ADD
       DO-STOPCYCLE
    ON-STMT=* CODE=NOTOK
       DO-NOTIFY=CARDOPS URGENCY=URGENT
                 MSG='CARDBILL CBBIL05J VENDOR FILE BUILD FAILED'
       DO-COND=CARDBILL-HELD ODAT ADD
       DO-STOPCYCLE
    RC-COND=(RC,EQ,0000) OK
    RC-COND=(RC,EQ,0008) XMITFAIL
    RC-COND=(RC,GE,0012) NOTOK
    DUE-OUT=07:00
    ON-DUE-OUT-LATE
       DO-NOTIFY=CARDOPS URGENCY=VERYURGENT
                 MSG='CARDBILL CYCLE %%CYCLE LATE - MAILING SLA MISSED'
    NOTE=THE VENDOR FILES ARE CHECKPOINTED AT THE TRANSMISSION STEP.
         A RERUN AFTER A PARTIAL SEND RESUMES FROM THE LAST
         ACKNOWLEDGED BLOCK - DO NOT RESEND THE WHOLE FILE.
END-JOB

*----------------------------------------------------------------------*
JOB NAME=CBBIL06J
    MEMLIB=CARD.PROD.JCLLIB
    MEMNAME=CBBIL06J
    DESC=CLOSE BILLING CYCLE, SET NEXT CYCLE DATES, CYCLE REPORTS
    OWNER=CARDBAT
    NODE=DCPROD1
    CALENDAR=CYCLE03,CYCLE11,CYCLE18,CYCLE25
    PARM=CYCLE=%%CYCLE
    TIME-FROM=03:00
    TIME-UNTIL=07:30
    MAXWAIT=0
    MAXRERUN=2
    RERUN-INTERVAL=00:05
    PRIORITY=85
    CRITICAL=Y
    IN-COND=CBBIL05J-OK ODAT
    OUT-COND=CARDBILL-COMPLETE ODAT ADD
    ON-STMT=* CODE=OK
       DO-COND=CARDBILL-COMPLETE ODAT ADD
       DO-COND=CBBIL01J-OK ODAT DEL
       DO-COND=CBBIL02J-OK ODAT DEL
       DO-COND=CBBIL03J-OK ODAT DEL
       DO-COND=CBBIL04J-OK ODAT DEL
       DO-COND=CBBIL05J-OK ODAT DEL
    ON-STMT=* CODE=NOTOK
       DO-NOTIFY=CARDOPS URGENCY=URGENT
                 MSG='CARDBILL CBBIL06J CLOSE FAILED CYCLE %%CYCLE'
       DO-COND=CARDBILL-HELD ODAT ADD
       DO-STOPCYCLE
    RC-COND=(RC,LE,0004) OK
    RC-COND=(RC,GE,0008) NOTOK
    ABEND-COND=U4106 NOTOK
END-JOB

*======================================================================*
* OPERATOR NOTES                                                       *
*                                                                      *
* 1. NEVER RE-ORDER THE TABLE WITH A CYCLE PARAMETER THAT HAS ALREADY  *
*    RUN THIS MONTH.  CBBIL01J WILL ABEND U4101 IF THE BILLING         *
*    CONTROL RECORD FOR THE CYCLE AND MONTH IS ALREADY CLOSED.         *
* 2. STATEMENT NUMBERS ARE ALLOCATED IN CBBIL03J AND ARE NOT REUSED.   *
*    A RERUN CONSUMES A NEW RANGE - THAT IS EXPECTED, THE GAP IS       *
*    REPORTED ON THE CYCLE CONTROL REPORT.                             *
* 3. IF THE E-DELIVERY VENDOR IS UNAVAILABLE, CBBIL05J MAY BE RUN      *
*    WITH PARM 'PRINTONLY'.  THE ELECTRONIC POPULATION IS THEN         *
*    RE-DRIVEN BY AN AD HOC ORDER OF CBBIL05J THE FOLLOWING NIGHT.     *
* 4. U4104 IS RAISED WHEN A STATEMENT EXCEEDS THE MAXIMUM LINE COUNT.  *
*    THE ACCOUNT IS ON THE STEP SYSOUT - IT NEEDS A MANUAL SPLIT.      *
*======================================================================*
