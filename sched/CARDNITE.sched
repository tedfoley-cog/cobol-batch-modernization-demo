*======================================================================*
* CARDNITE.SCHED - CARD SERVICING NIGHTLY CYCLE                        *
*                                                                      *
* TABLE  CARDNITE                                                      *
* OWNER  CARDBAT          GROUP CARD-SYSTEMS-PROD                      *
* APPL   CARDSVC                                                       *
*                                                                      *
* ORDERED DAILY.  THE CYCLE MAY NOT START UNTIL THE ONLINE REGION HAS  *
* QUIESCED - CICSCARD POSTS CICS-CARD-CLOSED WHEN THE REGION SHUTS     *
* DOWN.  THE CYCLE MUST BE COMPLETE BEFORE THE MORNING OPEN AT 06:00.  *
*                                                                      *
* ON ANY ABEND THE CYCLE IS HELD, NOT SKIPPED.  CARDSVC BATCH IS       *
* RESTARTABLE FROM THE CYCLE CONTROL RECORD IN CARD.PROD.CYCLCTL -     *
* SEE THE RESTART NOTES AT THE FOOT OF THIS MEMBER.                    *
*======================================================================*

TABLE NAME=CARDNITE
      OWNER=CARDBAT
      APPLICATION=CARDSVC
      GROUP=CARD-SYSTEMS-PROD
      DATACENTER=DCPROD1
      CALENDAR=ALLDAY
      NOT-CALENDAR=WEEKSUN
      ORDER-METHOD=AUTO
      ORDER-TIME=17:30
      CYCLE-TYPE=CARDNITE
      DESC=NIGHTLY AUTHORISATION SETTLEMENT AND POSTING CYCLE

*----------------------------------------------------------------------*
JOB NAME=CBCRD01J
    MEMLIB=CARD.PROD.JCLLIB
    MEMNAME=CBCRD01J
    DESC=OPEN CYCLE, VALIDATE CONTROL RECORD, TAKE VSAM BACKUP
    OWNER=CARDBAT
    NODE=DCPROD1
    TIME-FROM=20:30
    TIME-UNTIL=23:30
    MAXWAIT=1
    MAXRERUN=2
    RERUN-INTERVAL=00:05
    PRIORITY=80
    CRITICAL=Y
    IN-COND=CICS-CARD-CLOSED ODAT
    OUT-COND=CBCRD01J-OK ODAT ADD
    ON-STMT=* CODE=OK
       DO-COND=CBCRD01J-OK ODAT ADD
    ON-STMT=* CODE=NOTOK
       DO-NOTIFY=CARDOPS URGENCY=URGENT
                 MSG='CARDNITE CBCRD01J FAILED - CYCLE NOT OPENED'
       DO-COND=CARDNITE-HELD ODAT ADD
       DO-STOPCYCLE
    RC-COND=(RC,LE,0004) OK
    RC-COND=(RC,EQ,0008) NOTOK
    RC-COND=(RC,GE,0012) NOTOK
    ABEND-COND=U4001 NOTOK
END-JOB

*----------------------------------------------------------------------*
JOB NAME=CBCRD02J
    MEMLIB=CARD.PROD.JCLLIB
    MEMNAME=CBCRD02J
    DESC=EXTRACT UNSETTLED AUTHORISATIONS FROM AUTHLOG
    OWNER=CARDBAT
    NODE=DCPROD1
    TIME-FROM=20:45
    TIME-UNTIL=00:30
    MAXWAIT=1
    MAXRERUN=3
    RERUN-INTERVAL=00:05
    PRIORITY=75
    IN-COND=CBCRD01J-OK ODAT
    OUT-COND=CBCRD02J-OK ODAT ADD
    ON-STMT=* CODE=OK
       DO-COND=CBCRD02J-OK ODAT ADD
    ON-STMT=* CODE=EMPTY
       DO-COND=CBCRD02J-OK ODAT ADD
       DO-NOTIFY=CARDOPS URGENCY=REGULAR
                 MSG='CARDNITE CBCRD02J EXTRACTED ZERO RECORDS'
    ON-STMT=* CODE=NOTOK
       DO-NOTIFY=CARDOPS URGENCY=URGENT
                 MSG='CARDNITE CBCRD02J FAILED - EXTRACT INCOMPLETE'
       DO-COND=CARDNITE-HELD ODAT ADD
       DO-STOPCYCLE
    RC-COND=(RC,EQ,0000) OK
    RC-COND=(RC,EQ,0004) EMPTY
    RC-COND=(RC,GE,0008) NOTOK
    ABEND-COND=U4002 NOTOK
END-JOB

*----------------------------------------------------------------------*
JOB NAME=CBCRD03J
    MEMLIB=CARD.PROD.JCLLIB
    MEMNAME=CBCRD03J
    DESC=SORT AND MERGE THE SETTLEMENT EXTRACT INTO POSTING SEQUENCE
    OWNER=CARDBAT
    NODE=DCPROD1
    TIME-FROM=21:00
    TIME-UNTIL=01:00
    MAXWAIT=1
    MAXRERUN=3
    RERUN-INTERVAL=00:03
    PRIORITY=75
    IN-COND=CBCRD02J-OK ODAT
    OUT-COND=CBCRD03J-OK ODAT ADD
    ON-STMT=* CODE=OK
       DO-COND=CBCRD03J-OK ODAT ADD
    ON-STMT=* CODE=NOTOK
       DO-NOTIFY=CARDOPS URGENCY=URGENT
                 MSG='CARDNITE CBCRD03J SORT FAILED'
       DO-COND=CARDNITE-HELD ODAT ADD
       DO-STOPCYCLE
    RC-COND=(RC,LE,0004) OK
    RC-COND=(RC,GE,0008) NOTOK
END-JOB

*----------------------------------------------------------------------*
JOB NAME=CBCRD04J
    MEMLIB=CARD.PROD.JCLLIB
    MEMNAME=CBCRD04J
    DESC=POST TRANSACTIONS TO ACCOUNT AND TRANSACTION TABLES
    OWNER=CARDBAT
    NODE=DCPROD1
    TIME-FROM=21:15
    TIME-UNTIL=03:00
    MAXWAIT=1
    MAXRERUN=1
    RERUN-INTERVAL=00:10
    PRIORITY=90
    CRITICAL=Y
    RESOURCE=CARDDB-POSTING QUANTITY=1
    IN-COND=CBCRD03J-OK ODAT
    OUT-COND=CBCRD04J-OK ODAT ADD
    ON-STMT=* CODE=OK
       DO-COND=CBCRD04J-OK ODAT ADD
    ON-STMT=* CODE=WARN
       DO-COND=CBCRD04J-OK ODAT ADD
       DO-NOTIFY=CARDOPS URGENCY=REGULAR
                 MSG='CARDNITE CBCRD04J POSTED WITH REJECTS - CHECK RPT'
    ON-STMT=* CODE=NOTOK
       DO-NOTIFY=CARDOPS URGENCY=URGENT
                 MSG='CARDNITE CBCRD04J POSTING ABEND - RESTART REQUIRED'
       DO-COND=CARDNITE-HELD ODAT ADD
       DO-STOPCYCLE
    RC-COND=(RC,EQ,0000) OK
    RC-COND=(RC,EQ,0004) WARN
    RC-COND=(RC,GE,0008) NOTOK
    ABEND-COND=U4004 NOTOK
    ABEND-COND=S0C7  NOTOK
    NOTE=CHECKPOINTS EVERY 1000 RECORDS.  A RERUN RESUMES FROM THE
         LAST GOOD KEY IN THE CYCLE CONTROL RECORD - DO NOT RESTORE
         THE TABLES BEFORE RERUNNING.
END-JOB

*----------------------------------------------------------------------*
* FORK - CBCRD05AJ AND CBCRD05BJ BOTH RUN ON CBCRD04J-OK AND RUN       *
* CONCURRENTLY.  THEY TOUCH DIFFERENT TABLES AND HOLD NO COMMON        *
* RESOURCE.  CBCRD06J JOINS ON BOTH.                                   *
*----------------------------------------------------------------------*

JOB NAME=CBCRD05AJ
    MEMLIB=CARD.PROD.JCLLIB
    MEMNAME=CBCRD05AJ
    DESC=FEE ASSESSMENT FOR THE POSTED DAY
    OWNER=CARDBAT
    NODE=DCPROD1
    TIME-FROM=22:00
    TIME-UNTIL=04:00
    MAXWAIT=1
    MAXRERUN=3
    RERUN-INTERVAL=00:05
    PRIORITY=70
    IN-COND=CBCRD04J-OK ODAT
    OUT-COND=CBCRD05AJ-OK ODAT ADD
    ON-STMT=* CODE=OK
       DO-COND=CBCRD05AJ-OK ODAT ADD
    ON-STMT=* CODE=WARN
       DO-COND=CBCRD05AJ-OK ODAT ADD
       DO-NOTIFY=CARDOPS URGENCY=REGULAR
                 MSG='CARDNITE CBCRD05AJ FEE WAIVERS EXCEEDED THRESHOLD'
    ON-STMT=* CODE=NOTOK
       DO-NOTIFY=CARDOPS URGENCY=URGENT
                 MSG='CARDNITE CBCRD05AJ FEE ASSESSMENT FAILED'
       DO-COND=CARDNITE-HELD ODAT ADD
       DO-STOPCYCLE
    RC-COND=(RC,EQ,0000) OK
    RC-COND=(RC,EQ,0004) WARN
    RC-COND=(RC,GE,0008) NOTOK
    ABEND-COND=U4005 NOTOK
END-JOB

*----------------------------------------------------------------------*
JOB NAME=CBCRD05BJ
    MEMLIB=CARD.PROD.JCLLIB
    MEMNAME=CBCRD05BJ
    DESC=REWARD POINT ACCRUAL FOR THE POSTED DAY
    OWNER=CARDBAT
    NODE=DCPROD1
    TIME-FROM=22:00
    TIME-UNTIL=04:00
    MAXWAIT=1
    MAXRERUN=3
    RERUN-INTERVAL=00:05
    PRIORITY=60
    IN-COND=CBCRD04J-OK ODAT
    OUT-COND=CBCRD05BJ-OK ODAT ADD
    ON-STMT=* CODE=OK
       DO-COND=CBCRD05BJ-OK ODAT ADD
    ON-STMT=* CODE=WARN
       DO-COND=CBCRD05BJ-OK ODAT ADD
       DO-NOTIFY=CARDOPS URGENCY=REGULAR
                 MSG='CARDNITE CBCRD05BJ ACCRUED WITH RATE DEFAULTS'
    ON-STMT=* CODE=NOTOK
       DO-NOTIFY=CARDOPS URGENCY=URGENT
                 MSG='CARDNITE CBCRD05BJ REWARD ACCRUAL FAILED'
       DO-COND=CARDNITE-HELD ODAT ADD
       DO-STOPCYCLE
    RC-COND=(RC,EQ,0000) OK
    RC-COND=(RC,EQ,0004) WARN
    RC-COND=(RC,GE,0008) NOTOK
    ABEND-COND=U4006 NOTOK
END-JOB

*----------------------------------------------------------------------*
* JOIN - BOTH LEGS OF THE FORK MUST COMPLETE.                          *
*----------------------------------------------------------------------*

JOB NAME=CBCRD06J
    MEMLIB=CARD.PROD.JCLLIB
    MEMNAME=CBCRD06J
    DESC=NIGHTLY EXPOSURE AND DELINQUENCY REFRESH
    OWNER=CARDBAT
    NODE=DCPROD1
    TIME-FROM=23:00
    TIME-UNTIL=04:30
    MAXWAIT=1
    MAXRERUN=2
    RERUN-INTERVAL=00:10
    PRIORITY=70
    CRITICAL=Y
    IN-COND=CBCRD05AJ-OK ODAT
    IN-COND=CBCRD05BJ-OK ODAT
    IN-COND-RELATION=AND
    OUT-COND=CBCRD06J-OK ODAT ADD
    ON-STMT=* CODE=OK
       DO-COND=CBCRD06J-OK ODAT ADD
    ON-STMT=* CODE=PARTIAL
       DO-COND=CBCRD06J-OK ODAT ADD
       DO-NOTIFY=CARDOPS URGENCY=REGULAR
                 MSG='CARDNITE CBCRD06J PARTIAL REFRESH - STALE ROWS SET'
       DO-NOTIFY=PRTYOPS URGENCY=REGULAR
                 MSG='CARDNITE CBCRD06J PARTIAL - EXPOSURE MAY BE STALE'
    ON-STMT=* CODE=NOTOK
       DO-NOTIFY=CARDOPS URGENCY=URGENT
                 MSG='CARDNITE CBCRD06J FAILED'
       DO-COND=CARDNITE-HELD ODAT ADD
       DO-STOPCYCLE
    RC-COND=(RC,EQ,0000) OK
    RC-COND=(RC,EQ,0004) PARTIAL
    RC-COND=(RC,GE,0008) NOTOK
    ABEND-COND=U4008 NOTOK
    NOTE=RC 0004 IS RAISED WHEN A DOWNSTREAM SERVICE DID NOT ANSWER
         WITHIN THE STEP TIMEOUT.  THE CYCLE CONTINUES - THE AFFECTED
         ROWS ARE MARKED STALE AND PICKED UP BY THE NEXT RUN.
END-JOB

*----------------------------------------------------------------------*
JOB NAME=CBCRD07J
    MEMLIB=CARD.PROD.JCLLIB
    MEMNAME=CBCRD07J
    DESC=INTEREST ACCRUAL ON REVOLVING BALANCES
    OWNER=CARDBAT
    NODE=DCPROD1
    TIME-FROM=23:30
    TIME-UNTIL=05:00
    MAXWAIT=1
    MAXRERUN=1
    RERUN-INTERVAL=00:10
    PRIORITY=80
    CRITICAL=Y
    RESOURCE=CARDDB-POSTING QUANTITY=1
    IN-COND=CBCRD06J-OK ODAT
    OUT-COND=CBCRD07J-OK ODAT ADD
    ON-STMT=* CODE=OK
       DO-COND=CBCRD07J-OK ODAT ADD
    ON-STMT=* CODE=NOTOK
       DO-NOTIFY=CARDOPS URGENCY=URGENT
                 MSG='CARDNITE CBCRD07J INTEREST ACCRUAL FAILED'
       DO-COND=CARDNITE-HELD ODAT ADD
       DO-STOPCYCLE
    RC-COND=(RC,LE,0004) OK
    RC-COND=(RC,GE,0008) NOTOK
    ABEND-COND=U4009 NOTOK
    NOTE=CHECKPOINT RESTARTABLE.  ACCRUAL IS IDEMPOTENT PER ACCOUNT
         PER CYCLE DATE - A RERUN SKIPS ACCOUNTS ALREADY ACCRUED.
END-JOB

*----------------------------------------------------------------------*
JOB NAME=CBCRD08J
    MEMLIB=CARD.PROD.JCLLIB
    MEMNAME=CBCRD08J
    DESC=GENERAL LEDGER EXTRACT AND BALANCING
    OWNER=CARDBAT
    NODE=DCPROD1
    TIME-FROM=00:30
    TIME-UNTIL=05:15
    MAXWAIT=1
    MAXRERUN=2
    RERUN-INTERVAL=00:05
    PRIORITY=85
    CRITICAL=Y
    IN-COND=CBCRD07J-OK ODAT
    OUT-COND=CBCRD08J-OK ODAT ADD
    OUT-COND=GL-CARD-FEED-READY ODAT ADD
    ON-STMT=* CODE=OK
       DO-COND=CBCRD08J-OK ODAT ADD
       DO-COND=GL-CARD-FEED-READY ODAT ADD
    ON-STMT=* CODE=OUTOFBAL
       DO-NOTIFY=CARDOPS URGENCY=VERYURGENT
                 MSG='CARDNITE CBCRD08J GL OUT OF BALANCE - DO NOT SEND'
       DO-COND=CARDNITE-HELD ODAT ADD
       DO-STOPCYCLE
    ON-STMT=* CODE=NOTOK
       DO-NOTIFY=CARDOPS URGENCY=URGENT
                 MSG='CARDNITE CBCRD08J GL EXTRACT FAILED'
       DO-COND=CARDNITE-HELD ODAT ADD
       DO-STOPCYCLE
    RC-COND=(RC,EQ,0000) OK
    RC-COND=(RC,EQ,0008) OUTOFBAL
    RC-COND=(RC,GE,0012) NOTOK
    ABEND-COND=U4010 OUTOFBAL
END-JOB

*----------------------------------------------------------------------*
JOB NAME=CBCRD09J
    MEMLIB=CARD.PROD.JCLLIB
    MEMNAME=CBCRD09J
    DESC=DAILY OPERATIONS AND EXCEPTION REPORTING
    OWNER=CARDBAT
    NODE=DCPROD1
    TIME-FROM=01:00
    TIME-UNTIL=05:30
    MAXWAIT=1
    MAXRERUN=3
    RERUN-INTERVAL=00:03
    PRIORITY=40
    IN-COND=CBCRD08J-OK ODAT
    OUT-COND=CBCRD09J-OK ODAT ADD
    ON-STMT=* CODE=OK
       DO-COND=CBCRD09J-OK ODAT ADD
    ON-STMT=* CODE=NOTOK
       DO-NOTIFY=CARDOPS URGENCY=REGULAR
                 MSG='CARDNITE CBCRD09J REPORTS FAILED - CYCLE CONTINUES'
       DO-COND=CBCRD09J-OK ODAT ADD
    RC-COND=(RC,LE,0004) OK
    RC-COND=(RC,GE,0008) NOTOK
    NOTE=REPORTING ONLY.  A FAILURE HERE DOES NOT HOLD THE CYCLE, THE
         SUCCESSOR CONDITION IS POSTED EITHER WAY.
END-JOB

*----------------------------------------------------------------------*
JOB NAME=CBCRD10J
    MEMLIB=CARD.PROD.JCLLIB
    MEMNAME=CBCRD10J
    DESC=CLOSE CYCLE, ARCHIVE WORK FILES, RELEASE ONLINE REGION
    OWNER=CARDBAT
    NODE=DCPROD1
    TIME-FROM=01:30
    TIME-UNTIL=05:45
    MAXWAIT=0
    MAXRERUN=2
    RERUN-INTERVAL=00:03
    PRIORITY=95
    CRITICAL=Y
    IN-COND=CBCRD09J-OK ODAT
    OUT-COND=CARDNITE-COMPLETE ODAT ADD
    OUT-COND=CICS-CARD-OPEN-OK ODAT ADD
    ON-STMT=* CODE=OK
       DO-COND=CARDNITE-COMPLETE ODAT ADD
       DO-COND=CICS-CARD-OPEN-OK ODAT ADD
       DO-COND=CBCRD01J-OK ODAT DEL
       DO-COND=CBCRD02J-OK ODAT DEL
       DO-COND=CBCRD03J-OK ODAT DEL
       DO-COND=CBCRD04J-OK ODAT DEL
       DO-COND=CBCRD05AJ-OK ODAT DEL
       DO-COND=CBCRD05BJ-OK ODAT DEL
       DO-COND=CBCRD06J-OK ODAT DEL
       DO-COND=CBCRD07J-OK ODAT DEL
       DO-COND=CBCRD08J-OK ODAT DEL
       DO-COND=CBCRD09J-OK ODAT DEL
    ON-STMT=* CODE=NOTOK
       DO-NOTIFY=CARDOPS URGENCY=VERYURGENT
                 MSG='CARDNITE CBCRD10J CLOSE FAILED - ONLINE NOT OPENED'
       DO-COND=CARDNITE-HELD ODAT ADD
       DO-STOPCYCLE
    RC-COND=(RC,LE,0004) OK
    RC-COND=(RC,GE,0008) NOTOK
    DUE-OUT=06:00
    ON-DUE-OUT-LATE
       DO-NOTIFY=CARDOPS URGENCY=VERYURGENT
                 MSG='CARDNITE LATE - ONLINE OPEN AT RISK'
END-JOB

*======================================================================*
* OPERATOR NOTES - RESTART                                             *
*                                                                      *
* 1. THE CYCLE IS HELD, NOT CANCELLED, ON ANY NOTOK.  CARDNITE-HELD    *
*    BLOCKS THE NEXT ORDER OF THIS TABLE UNTIL PRODUCTION CONTROL      *
*    DELETES IT.                                                       *
* 2. BEFORE RERUNNING ANY JOB FROM CBCRD04J ONWARDS, DISPLAY THE       *
*    CYCLE CONTROL RECORD FOR CYCLE TYPE CARDNITE AND TODAY'S DATE.    *
*    CC-STATUS R MEANS THE PREVIOUS RUN DID NOT CLOSE - RESTART, DO    *
*    NOT RE-EXECUTE FROM THE TOP.                                      *
* 3. NEVER RESTORE THE DB2 TABLES OR THE VSAM CLUSTERS BEFORE A        *
*    RERUN OF A CHECKPOINTED JOB.  THE RESTART LOGIC RESUMES AT        *
*    CC-LAST-KEY AND WOULD DOUBLE POST.                                *
* 4. IF THE ONLINE OPEN DEADLINE OF 06:00 CANNOT BE MET, RUN           *
*    CBCRD10J WITH PARM 'FORCEOPEN' TO RELEASE THE REGION AND LEAVE    *
*    THE CYCLE OPEN.  THE OUTSTANDING WORK IS PICKED UP BY THE NEXT    *
*    NIGHT'S RUN.                                                      *
* 5. U4004 AND S0C7 IN CBCRD04J ARE ALMOST ALWAYS A BAD PACKED FIELD   *
*    IN THE EXTRACT.  THE OFFENDING KEY IS ON THE STEP SYSOUT.         *
*======================================================================*
