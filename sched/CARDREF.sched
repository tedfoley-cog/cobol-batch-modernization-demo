*======================================================================*
* CARDREF.SCHED - CARD SERVICING WEEKLY REFERENCE DATA REBUILD         *
*                                                                      *
* TABLE  CARDREF                                                       *
* OWNER  CARDBAT          GROUP CARD-SYSTEMS-PROD                      *
* APPL   CARDSVC                                                       *
*                                                                      *
* ORDERED EVERY SUNDAY.  THE ONLINE REGION IS DOWN FOR THE SUNDAY      *
* MAINTENANCE WINDOW AND THE NIGHTLY CYCLE IS NOT ORDERED, SO THIS     *
* TABLE OWNS THE REFERENCE VSAM CLUSTERS OUTRIGHT.                     *
*                                                                      *
* THE WHOLE TABLE MUST BE COMPLETE BEFORE THE MONDAY ONLINE OPEN.      *
* CBREF04J REBUILDS THE ROUTE TABLE FILE AND IS FLAGGED CRITICAL -     *
* THE REGION WILL NOT START CLEANLY WITHOUT IT.                        *
*======================================================================*

TABLE NAME=CARDREF
      OWNER=CARDBAT
      APPLICATION=CARDSVC
      GROUP=CARD-SYSTEMS-PROD
      DATACENTER=DCPROD1
      CALENDAR=WEEKSUN
      ORDER-METHOD=AUTO
      ORDER-TIME=06:00
      CYCLE-TYPE=CARDREF
      DESC=WEEKLY REFERENCE AND CONTROL FILE REBUILD

*----------------------------------------------------------------------*
JOB NAME=CBREF01J
    MEMLIB=CARD.PROD.JCLLIB
    MEMNAME=CBREF01J
    DESC=BACKUP REFERENCE CLUSTERS AND OPEN THE REFERENCE CYCLE
    OWNER=CARDBAT
    NODE=DCPROD1
    TIME-FROM=08:00
    TIME-UNTIL=12:00
    MAXWAIT=0
    MAXRERUN=2
    RERUN-INTERVAL=00:05
    PRIORITY=70
    CRITICAL=Y
    IN-COND=CICS-CARD-CLOSED ODAT
    OUT-COND=CBREF01J-OK ODAT ADD
    ON-STMT=* CODE=OK
       DO-COND=CBREF01J-OK ODAT ADD
    ON-STMT=* CODE=NOTOK
       DO-NOTIFY=CARDOPS URGENCY=URGENT
                 MSG='CARDREF CBREF01J BACKUP FAILED - REBUILD BLOCKED'
       DO-COND=CARDREF-HELD ODAT ADD
       DO-STOPCYCLE
    RC-COND=(RC,LE,0004) OK
    RC-COND=(RC,GE,0008) NOTOK
    NOTE=THE BACKUP IS THE ONLY WAY BACK IF A REBUILD PRODUCES A BAD
         CLUSTER.  DO NOT BYPASS THIS JOB TO SAVE WINDOW TIME.
END-JOB

*----------------------------------------------------------------------*
JOB NAME=CBREF02J
    MEMLIB=CARD.PROD.JCLLIB
    MEMNAME=CBREF02J
    DESC=REBUILD MERCHANT SETTLEMENT ROUTING AND REASON CODE FILES
    OWNER=CARDBAT
    NODE=DCPROD1
    TIME-FROM=08:30
    TIME-UNTIL=14:00
    MAXWAIT=0
    MAXRERUN=3
    RERUN-INTERVAL=00:05
    PRIORITY=60
    IN-COND=CBREF01J-OK ODAT
    OUT-COND=CBREF02J-OK ODAT ADD
    ON-STMT=* CODE=OK
       DO-COND=CBREF02J-OK ODAT ADD
    ON-STMT=* CODE=WARN
       DO-COND=CBREF02J-OK ODAT ADD
       DO-NOTIFY=CARDOPS URGENCY=REGULAR
                 MSG='CARDREF CBREF02J MERCHANTS WITHOUT A ROUTE ENTRY'
    ON-STMT=* CODE=NOTOK
       DO-NOTIFY=CARDOPS URGENCY=URGENT
                 MSG='CARDREF CBREF02J REFERENCE REBUILD FAILED'
       DO-COND=CARDREF-HELD ODAT ADD
       DO-STOPCYCLE
    RC-COND=(RC,EQ,0000) OK
    RC-COND=(RC,EQ,0004) WARN
    RC-COND=(RC,GE,0008) NOTOK
    ABEND-COND=U4201 NOTOK
    NOTE=RC 0004 LISTS MERCHANTS PRESENT IN CARDDB WITH NO SETTLEMENT
         ROUTE.  THEY AUTHORISE NORMALLY BUT SETTLE TO THE DEFAULT
         ROUTE - THE LIST GOES TO MERCHANT SERVICES EACH WEEK.
END-JOB

*----------------------------------------------------------------------*
JOB NAME=CBREF03J
    MEMLIB=CARD.PROD.JCLLIB
    MEMNAME=CBREF03J
    DESC=REBUILD FRAUD RULE AND CUSTOMER PREFERENCE FILES
    OWNER=CARDBAT
    NODE=DCPROD1
    TIME-FROM=09:30
    TIME-UNTIL=15:00
    MAXWAIT=0
    MAXRERUN=3
    RERUN-INTERVAL=00:05
    PRIORITY=60
    IN-COND=CBREF02J-OK ODAT
    OUT-COND=CBREF03J-OK ODAT ADD
    ON-STMT=* CODE=OK
       DO-COND=CBREF03J-OK ODAT ADD
    ON-STMT=* CODE=NOTOK
       DO-NOTIFY=CARDOPS URGENCY=URGENT
                 MSG='CARDREF CBREF03J RULE FILE REBUILD FAILED'
       DO-COND=CARDREF-HELD ODAT ADD
       DO-STOPCYCLE
    RC-COND=(RC,LE,0004) OK
    RC-COND=(RC,GE,0008) NOTOK
    ABEND-COND=U4202 NOTOK
END-JOB

*----------------------------------------------------------------------*
JOB NAME=CBREF04J
    MEMLIB=CARD.PROD.JCLLIB
    MEMNAME=CBREF04J
    DESC=REBUILD THE ROUTE TABLE VSAM CLUSTER FROM THE DB2 CONTROL TABLE
    OWNER=CARDBAT
    NODE=DCPROD1
    TIME-FROM=10:30
    TIME-UNTIL=16:00
    MAXWAIT=0
    MAXRERUN=2
    RERUN-INTERVAL=00:05
    PRIORITY=99
    CRITICAL=Y
    CONFIRM-REQUIRED=N
    IN-COND=CBREF03J-OK ODAT
    OUT-COND=CBREF04J-OK ODAT ADD
    OUT-COND=PGMROUT-REBUILT ODAT ADD
    ON-STMT=* CODE=OK
       DO-COND=CBREF04J-OK ODAT ADD
       DO-COND=PGMROUT-REBUILT ODAT ADD
    ON-STMT=* CODE=COUNTMISMATCH
       DO-NOTIFY=CARDOPS URGENCY=VERYURGENT
                 MSG='CARDREF CBREF04J ROUTE COUNT MISMATCH - RESTORE'
       DO-NOTIFY=DBAOPS URGENCY=URGENT
                 MSG='CARDREF CBREF04J ROUTE UNLOAD SUSPECT'
       DO-COND=CARDREF-HELD ODAT ADD
       DO-STOPCYCLE
    ON-STMT=* CODE=NOTOK
       DO-NOTIFY=CARDOPS URGENCY=VERYURGENT
                 MSG='CARDREF CBREF04J ROUTE REBUILD FAILED - CRITICAL'
       DO-COND=CARDREF-HELD ODAT ADD
       DO-STOPCYCLE
    RC-COND=(RC,EQ,0000) OK
    RC-COND=(RC,EQ,0008) COUNTMISMATCH
    RC-COND=(RC,GE,0012) NOTOK
    ABEND-COND=U4203 NOTOK
    NOTE=CRITICAL.  THE REBUILT CLUSTER IS THE FALLBACK USED BY THE
         ONLINE REGION WHEN DB2 IS NOT AVAILABLE AT REGION START.
         IF THE ROW COUNT WRITTEN DOES NOT MATCH THE UNLOAD COUNT THE
         JOB SETS RC 8 AND LEAVES THE PREVIOUS CLUSTER IN PLACE.
         RESTORE FROM THE CBREF01J BACKUP BEFORE ANY RERUN.
END-JOB

*----------------------------------------------------------------------*
JOB NAME=CBREF05J
    MEMLIB=CARD.PROD.JCLLIB
    MEMNAME=CBREF05J
    DESC=VERIFY REBUILT CLUSTERS, REPORT, CLOSE THE REFERENCE CYCLE
    OWNER=CARDBAT
    NODE=DCPROD1
    TIME-FROM=11:30
    TIME-UNTIL=18:00
    MAXWAIT=0
    MAXRERUN=3
    RERUN-INTERVAL=00:05
    PRIORITY=70
    CRITICAL=Y
    IN-COND=CBREF04J-OK ODAT
    OUT-COND=CARDREF-COMPLETE ODAT ADD
    ON-STMT=* CODE=OK
       DO-COND=CARDREF-COMPLETE ODAT ADD
       DO-COND=CBREF01J-OK ODAT DEL
       DO-COND=CBREF02J-OK ODAT DEL
       DO-COND=CBREF03J-OK ODAT DEL
       DO-COND=CBREF04J-OK ODAT DEL
    ON-STMT=* CODE=NOTOK
       DO-NOTIFY=CARDOPS URGENCY=VERYURGENT
                 MSG='CARDREF CBREF05J VERIFY FAILED - MONDAY OPEN RISK'
       DO-COND=CARDREF-HELD ODAT ADD
       DO-STOPCYCLE
    RC-COND=(RC,LE,0004) OK
    RC-COND=(RC,GE,0008) NOTOK
    DUE-OUT=20:00
    ON-DUE-OUT-LATE
       DO-NOTIFY=CARDOPS URGENCY=VERYURGENT
                 MSG='CARDREF LATE - MONDAY ONLINE OPEN AT RISK'
END-JOB

*======================================================================*
* OPERATOR NOTES                                                       *
*                                                                      *
* 1. CARDREF-COMPLETE MUST BE POSTED BEFORE THE MONDAY 06:00 ONLINE    *
*    OPEN.  IF IT IS NOT, THE REGION MAY STILL BE STARTED - THE        *
*    PREVIOUS WEEK'S CLUSTERS ARE INTACT BECAUSE EACH REBUILD WRITES   *
*    TO A WORK CLUSTER AND RENAMES ONLY ON SUCCESS.                    *
* 2. THE NIGHTLY CYCLE IS NOT ORDERED ON SUNDAY.  IF CARDREF OVERRUNS  *
*    INTO MONDAY EVENING, HOLD CARDNITE UNTIL CARDREF-COMPLETE IS      *
*    POSTED OR THE TWO WILL CONTEND FOR THE SAME CLUSTERS.             *
* 3. AFTER ANY MANUAL CHANGE TO THE DB2 ROUTE CONTROL TABLE, AN AD HOC *
*    ORDER OF CBREF04J IS REQUIRED THE SAME DAY.  THE ONLINE REGION    *
*    READS DB2 FIRST, SO THE CHANGE IS LIVE IMMEDIATELY, BUT THE       *
*    FALLBACK CLUSTER WOULD OTHERWISE BE A WEEK BEHIND.                *
*======================================================================*
